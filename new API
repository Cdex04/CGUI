function Window:_SelectTab(tab)
	if self.CurrentTab == tab or tab.Locked then return end
	local old = self.CurrentTab
	local dir = 1
	if old then
		dir = (tab.Index > old.Index) and 1 or -1
		old.Page.Visible = false
		tween(old.Label, 0.25, { TextColor3 = Theme.SubText })
		tween(old.IconObj, 0.25, { [old.IconProp] = Theme.SubText })
	end
	self.CurrentTab = tab
	tab.Page.Visible = true
	tab.Page.Position = UDim2.fromOffset(28 * dir, 0)
	tween(tab.Page, 0.4, { Position = UDim2.fromOffset(0, 0) })
	tween(tab.Label, 0.25, { TextColor3 = Theme.Text })
	tween(tab.IconObj, 0.25, { [tab.IconProp] = Theme.Accent })
	self:_MoveIndicator(true)
	self:_CloseSub()
end

function Window:_LayoutDock()
	local x = 6
	for _, t in ipairs(self.Tabs) do
		if t.Button.Visible then
			t.X = x
			t.Button.Position = UDim2.fromOffset(x, 5)
			x = x + t.W + 4
		end
	end
	local total = x + 2
	self.DockScroll.CanvasSize = UDim2.fromOffset(total, 0)
	local maxW = math.max(120, self.Main.Size.X.Offset - 48)
	local w = math.min(total, maxW)
	w = w - w % 2
	self.Dock.Size = UDim2.fromOffset(w, 50)
	self:_MoveIndicator(false)
end

function Window:_MoveIndicator(animate)
	local t = self.CurrentTab
	local ind = self.Indicator
	if not t or not t.X then ind.Visible = false; return end
	local pos, size = UDim2.fromOffset(t.X, 5), UDim2.fromOffset(t.W, 40)
	if animate and ind.Visible then
		tween(ind, 0.4, { Position = pos, Size = size })
	else
		ind.Position, ind.Size = pos, size
	end
	ind.Visible = true
	local sc = self.DockScroll
	local viewW = self.Dock.Size.X.Offset
	local canvasW = sc.CanvasSize.X.Offset
	if canvasW > viewW then
		local target = math.clamp(t.X + t.W / 2 - viewW / 2, 0, canvasW - viewW)
		tween(sc, 0.35, { CanvasPosition = Vector2.new(math.floor(target), 0) })
	end
end

function Window:AddTab(opts)
	if type(opts) == "string" then opts = { Name = opts } end
	opts = opts or {}
	local tab = setmetatable({ Window = self, Name = opts.Name or "Tab", Locked = false, Index = #self.Tabs + 1 }, Tab)
	local textW = TextService:GetTextSize(tab.Name, 13, Enum.Font.GothamMedium, Vector2.new(400, 20)).X
	tab.W = math.floor(textW) + 60

	local btn = new("TextButton", {
		BackgroundTransparency = 1, AutoButtonColor = false, Text = "", Size = UDim2.fromOffset(tab.W, 40),
		Position = UDim2.fromOffset(6, 5), Parent = self.DockScroll,
	})
	local slot = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 24), Position = UDim2.fromOffset(12, 8), Parent = btn,
	})
	local img = new("ImageLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20), ImageColor3 = Theme.SubText, Parent = slot,
	})
	if opts.Icon and applyIcon(img, opts.Icon) then
		tab.IconObj, tab.IconProp = img, "ImageColor3"
	else
		img:Destroy()
		tab.IconObj = new("TextLabel", {   -- ohne Icon: die ersten 2 Buchstaben
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = string.sub(tab.Name, 1, 2),
			Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.SubText, Parent = slot,
		})
		tab.IconProp = "TextColor3"
	end
	tab.Label = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -50, 1, 0), Text = tab.Name,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
	})
	tab.Button = btn

	tab.Page = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent,
		ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = self.Content,
	}, { new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), padding(0, 2, 4, 8) })

	local function hoverIn()
		if opts.Description and opts.Description ~= "" then self:_ShowTip(opts.Description, btn) end
		if self.CurrentTab ~= tab and not tab.Locked then tween(tab.Label, 0.15, { TextColor3 = Theme.Text }) end
	end
	local function hoverOut()
		self:_HideTip()
		if self.CurrentTab ~= tab and not tab.Locked then tween(tab.Label, 0.15, { TextColor3 = Theme.SubText }) end
	end
	btn.MouseEnter:Connect(hoverIn)
	btn.MouseLeave:Connect(hoverOut)
	selectFX(self, btn, hoverIn, hoverOut)
	btn.Activated:Connect(function() self:_SelectTab(tab) end)

	function tab:SetLock(state, mode)
		mode = mode or "Gray"
		self.Locked = state and true or false
		btn.Selectable = not self.Locked
		if self.Locked then
			if mode == "Hide" then
				btn.Visible = false
			else
				btn.Visible = true
				tween(self.Label, 0.2, { TextColor3 = Theme.Off })
			end
			if self.Window.CurrentTab == self then
				for _, t in ipairs(self.Window.Tabs) do
					if not t.Locked then self.Window.CurrentTab = nil; self.Window:_SelectTab(t); break end
				end
			end
		else
			btn.Visible = true
			tween(self.Label, 0.2, { TextColor3 = (self.Window.CurrentTab == self) and Theme.Text or Theme.SubText })
		end
		self.Window:_LayoutDock()
	end
	function tab:Lock(mode) self:SetLock(true, mode) end
	function tab:Unlock() self:SetLock(false) end
	function tab:Select() self.Window:_SelectTab(self) end

	table.insert(self.Tabs, tab)
	self:_LayoutDock()
	if not self.CurrentTab then self:_SelectTab(tab) end
	if opts.Locked then tab:SetLock(true, opts.LockMode) end
	return tab
end

