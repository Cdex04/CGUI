function Window:_PadEdit(area, knob, onStep)
	if self._editing then return end
	if os.clock() - (self._editEnd or 0) < 0.3 then return end
	self._editing = true
	local held = 0
	local lostConn
	local function stop()
		if not self._editing then return end
		self._editing = false
		self._editEnd = os.clock()
		self._stopEdit = nil
		held = held + 1
		ContextActionService:UnbindAction("CGuiEdit")
		if lostConn then lostConn:Disconnect() end
	end
	self._stopEdit = stop
	lostConn = area.SelectionLost:Connect(stop)
	ContextActionService:BindActionAtPriority("CGuiEdit", function(_, state, input)
		local k = input.KeyCode
		local isDir = (k == Enum.KeyCode.DPadLeft or k == Enum.KeyCode.DPadRight)
		if state == Enum.UserInputState.Begin then
			if k == Enum.KeyCode.ButtonA or k == Enum.KeyCode.ButtonB then
				stop()
			elseif isDir then
				local dir = (k == Enum.KeyCode.DPadLeft) and -1 or 1
				held = held + 1
				local my = held
				onStep(dir)
				task.spawn(function()
					task.wait(0.35)
					while held == my and self._editing do
						onStep(dir)
						task.wait(0.06)
					end
				end)
			end
		elseif state == Enum.UserInputState.End and isDir then
			held = held + 1
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value,
		Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonB, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadRight)
end

-- Tabs per L1/R1 wechseln
function Window:_StepTab(dir)
	local n = #self.Tabs
	if n < 2 then return end
	local idx = 1
	for i, t in ipairs(self.Tabs) do if t == self.CurrentTab then idx = i end end
	for _ = 1, n do
		idx = ((idx - 1 + dir) % n) + 1
		local t = self.Tabs[idx]
		if not t.Locked then self:_SelectTab(t); return end
	end
end

function Window:_ShowTip(text, anchor)
	if not text or text == "" then return end
	self._tipAnchor = anchor
	local tip = self.Tip
	tip.Text = text
	tip.BackgroundTransparency = 1
	tip.TextTransparency = 1
	tip.Visible = true
	tween(tip, 0.15, { BackgroundTransparency = 0, TextTransparency = 0 })
end

function Window:_HideTip()
	self.Tip.Visible = false
	self._tipAnchor = nil
end

