function Container:AddKeybind(opts)
	opts = opts or {}
	local win = self.Window
	local b = buildBase(self, opts, 0, 104)
	local el = { Kind = "Keybind" }
	local listening = false

	local function parse(k)
		if typeof(k) == "EnumItem" then return k end
		if type(k) == "string" and k ~= "" then
			local ok, res = pcall(function() return Enum.KeyCode[k] end)
			if ok then return res end
		end
		return nil
	end
	local key = parse(opts.Default)

	local btn = new("TextButton", {
		BackgroundColor3 = Theme.Off, AutoButtonColor = false, Font = Enum.Font.GothamMedium, TextSize = 12,
		TextColor3 = Theme.Text, Size = UDim2.fromOffset(84, 26), Position = UDim2.new(1, -96, 0.5, -13), Parent = b.Header,
	}, { corner(6) })
	local btnStroke = stroke(Theme.Accent, 1, 1)
	btnStroke.Parent = btn
	el._onLock = function(l) btn.Selectable = not l end

	local function render()
		btn.Text = listening and "Taste..." or (key and key.Name or "...")
		tween(btnStroke, 0.2, { Transparency = listening and 0 or 1 })
	end
	render()

	function el:Get() return key end
	function el:Set(k, silent)
		key = parse(k)
		render()
		if not silent then safe(opts.Callback, key) end
	end

	btn.Activated:Connect(function()
		if el.Locked then return end
		listening = true
		win.Listening = true
		render()
	end)

	win:_Connect(UIS.InputBegan, function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard or input.KeyCode.Name:find("^Button") then
				listening = false
				task.defer(function() win.Listening = false end)
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
					el:Set(nil)
				else
					el:Set(input.KeyCode)
				end
			end
			return
		end
		if gp or el.Locked or not win.Ready then return end
		if key and input.KeyCode == key then safe(opts.OnPress, key) end
	end)

	finalize(self, el, b, opts)
	return el
end

