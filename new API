}

local function colorId(c)
	return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5)
end

function CGui:_QueueApply()
	if self._applyQueued then return end
	self._applyQueued = true
	task.defer(function() self:ApplyTheme() end)
end

-- Faerbt alle bestehenden Fenster von der alten auf die neue Palette um
function CGui:ApplyTheme()
	self._applyQueued = false
	local keys = {}
	for _, k in ipairs(THEME_ORDER) do keys[#keys + 1] = k end
	for k in pairs(ThemeStore) do
		if not table.find(keys, k) then keys[#keys + 1] = k end
	end
	local map, changed, clash = {}, false, false
	for _, k in ipairs(keys) do
		local old, new = applied[k], ThemeStore[k]
		if typeof(old) == "Color3" and typeof(new) == "Color3" then
			if colorId(old) ~= colorId(new) then changed = true end
			local id = colorId(old)
			if map[id] == nil then
				map[id] = new
			elseif colorId(map[id]) ~= colorId(new) then
				clash = true
			end
		end
	end
	if clash then
		warn("[CGui] Theme: Mehrere Keys hatten dieselbe Farbe - bitte pro Key unterschiedliche Farben nutzen, sonst koennen Elemente falsch eingefaerbt werden.")
	end
	if changed then
		for i = #self._windows, 1, -1 do
			local win = self._windows[i]
			if not win.Gui or not win.Gui.Parent then
				table.remove(self._windows, i)
			else
				for _, inst in ipairs(win.Gui:GetDescendants()) do
					local props = COLOR_PROPS[inst.ClassName]
					if props and not inst:GetAttribute("NoTheme") then
						for _, p in ipairs(props) do
							local cur = inst[p]
							local nv = map[colorId(cur)]
							if nv and colorId(nv) ~= colorId(cur) then inst[p] = nv end
						end
					end
				end
			end
		end
	end
	for k, v in pairs(ThemeStore) do applied[k] = v end
	for _, w in ipairs(self._windows) do
		for _, h in ipairs(w._themeHooks or {}) do pcall(h) end
	end
end

-- Name eines Presets ("Teal", "Light", "Midnight") oder eine (auch teilweise) Tabelle
function CGui:SetTheme(t)
	local name
	if type(t) == "string" then
		local preset = Presets[t]
		if not preset then warn("[CGui] Unbekanntes Theme: " .. t); return end
		name = t
		t = preset
	end
	for k, v in pairs(t) do ThemeStore[k] = v end
	CGui.CurrentTheme = name
	self:ApplyTheme()
	for _, w in ipairs(self._windows) do
		if w._themeDD and name then w._themeDD:Set(name, true) end
	end
end

function CGui:GetThemeNames()
	local n = {}
	for k in pairs(Presets) do n[#n + 1] = k end
	table.sort(n)
	return n
end

function CGui:GetTheme()
	local c = {}
	for k, v in pairs(ThemeStore) do c[k] = v end
	return c
end

-- Eigenes Preset registrieren (fehlende Keys kommen aus Teal)
function CGui:RegisterTheme(name, t)
	local full = {}
	for k, v in pairs(Presets.Teal) do full[k] = v end
	for k, v in pairs(t) do full[k] = v end
	Presets[name] = full
	if not self._themeRefresh then
		self._themeRefresh = true
		task.defer(function()
			self._themeRefresh = false
			for _, w in ipairs(self._windows) do
				if w._themeDD then w._themeDD:Refresh(self:GetThemeNames(), true) end
			end
		end)
	end
end

