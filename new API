		ScrollBarImageColor3 = Theme.Accent, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = sf,
	}, { new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), padding(0, 2, 4, 8) })
	win.Settings = setmetatable({ Window = win, Page = sPage, IsSub = true }, SubPage)

	-- Notifications: CGui (unten rechts) + im Window
	local function holder(layout)
		local h = new("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
			Size = UDim2.new(0, 300, 1, -32), ZIndex = 60, Parent = gui,
		})
		if layout then
			new("UIListLayout", {
				VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
				Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = h,
			})
		end
		return h
	end
	win.NotifStack = holder(true)
	win.NotifOverlap = holder(false)
	win.WinNotifs = new("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -76),
		Size = UDim2.new(0, 260, 1, -90), ZIndex = 50, Parent = body,
	}, { new("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
	}) })

	-- Tooltip
	win.Tip = new("TextLabel", {
		Visible = false, BackgroundColor3 = Theme.Topbar, AutomaticSize = Enum.AutomaticSize.XY, Text = "",
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Theme.Text, ZIndex = 120, Parent = gui,
	}, { corner(6), stroke(Theme.Accent, 1, 0.5), padding(8, 5, 8, 5) })

	-- Ein Render-Loop fuer: Tooltip, Rahmen-Animation, Settings-Panel folgt dem Fenster
	local rot = 0
	win:_Connect(RunService.RenderStepped, function(dt)
		if win.Tip.Visible then
			local m = UIS:GetMouseLocation()
			local a = win._tipAnchor
			if a and a.Parent then
				win.Tip.Position = UDim2.fromOffset(a.AbsolutePosition.X, a.AbsolutePosition.Y + a.AbsoluteSize.Y + 6)
			else
				win.Tip.Position = UDim2.fromOffset(m.X + 14, m.Y + 16)
			end
		end
		if not main.Visible then return end
		if win.Effects then
			rot = (rot + dt * 45) % 360
			for _, g in ipairs(win._borders) do g.Rotation = rot end
		end
		local cur, tgt = win._sCur, win._sTarget
		if cur ~= tgt then
			cur = cur + (tgt - cur) * math.min(1, dt * 12)
			if math.abs(tgt - cur) < 0.002 then cur = tgt end
			win._sCur = cur
		end
		local show = cur > 0.004
		if sf.Visible ~= show then sf.Visible = show end
		if show then
			local ap, as = main.AbsolutePosition, main.AbsoluteSize
			local c2 = workspace.CurrentCamera
			local vpx = c2 and c2.ViewportSize.X or 1280
			local right = (ap.X + as.X + SW + 14 <= vpx) or (ap.X - SW - 14 < 0)
			local x
			if right then
				x = (ap.X + as.X - SW - 14) + (SW + 14 + 8) * cur
			else
				x = (ap.X + 14) - (SW + 14 + 8) * cur
			end
			sf.Size = UDim2.fromOffset(SW, math.max(160, math.floor(as.Y - 28)))
			sf.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(ap.Y + 14 + 0.5))
		end
	end)

	-- Dragging (Topbar)
	local dragging, dragStart, startPos
	top.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging, dragStart, startPos = true, input.Position, main.Position
		end
	end)
	win:_Connect(UIS.InputChanged, function(input)
		if dragging and isMove(input) then
			local dl = input.Position - dragStart
			dl = Vector3.new(math.floor(dl.X + 0.5), math.floor(dl.Y + 0.5), 0)
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dl.X, startPos.Y.Scale, startPos.Y.Offset + dl.Y)
		end
	end)
	win:_Connect(UIS.InputEnded, function(input)
		if isPress(input) then dragging = false end
	end)

	-- Resizing (Ecke unten rechts)
	local grip = new("TextButton", {
		BackgroundTransparency = 1, Text = "", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -4),
		Size = UDim2.fromOffset(18, 18), ZIndex = 40, Parent = main,
	})
	for i = 1, 2 do
		new("Frame", {
			BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.3, BorderSizePixel = 0, Rotation = -45,
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(6 + i * 4, 6 + i * 4),
			Size = UDim2.fromOffset(i * 6 + 2, 2), Parent = grip,
		})
	end
	local resizing, rStart, rSize, rPos
	grip.InputBegan:Connect(function(input)
		if isPress(input) then
			resizing, rStart = true, input.Position
			rSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
			rPos = main.Position
		end
	end)
	win:_Connect(UIS.InputChanged, function(input)
		if resizing and isMove(input) then
			local dl = input.Position - rStart
			local nw, nh = math.max(minSize.X, rSize.X + dl.X), math.max(minSize.Y, rSize.Y + dl.Y)
			nw, nh = math.floor(nw / 2) * 2, math.floor(nh / 2) * 2   -- gerade Pixel
			main.Size = UDim2.fromOffset(nw, nh)
			main.Position = UDim2.new(rPos.X.Scale, rPos.X.Offset + (nw - rSize.X) / 2, rPos.Y.Scale, rPos.Y.Offset + (nh - rSize.Y) / 2)
			win:_LayoutDock()
		end
	end)
	win:_Connect(UIS.InputEnded, function(input)
		if isPress(input) then resizing = false end
	end)

	-- Tasten: GUI oeffnen/schliessen, Gamepad-Kuerzel
	win:_Connect(UIS.InputBegan, function(input, gp)
		if win.Listening or not win.Ready then return end
		if win.Visible then
			local kc = input.KeyCode
			if win._activePrompt then
				if kc == Enum.KeyCode.ButtonB and win._activePrompt._cancel then win._activePrompt._cancel() end
			elseif kc == Enum.KeyCode.ButtonR1 then win:_StepTab(1)
			elseif kc == Enum.KeyCode.ButtonL1 then win:_StepTab(-1)
			elseif kc == Enum.KeyCode.ButtonX then win:ToggleSettings()
			elseif kc == Enum.KeyCode.ButtonB then win:_CloseSub()
			elseif kc == Enum.KeyCode.ButtonY then
				local fn = win._subHits and win._subHits[GuiService.SelectedObject]
				if fn then fn() end
			end
		end
		if gp then return end
		if win.ToggleKey and input.KeyCode == win.ToggleKey then win:Toggle() end
	end)

	-- Ablauf: Laden -> (Key-System) -> Window oeffnen -> Autoload
	task.spawn(function()
		win:_RunLoading(opts)
		if win.Destroyed then return end
		local ks = opts.KeySystem
		if type(ks) == "table" and ks.Enabled then win:_RunKeySystem(ks) end
		if win.Destroyed then return end
		win.Ready = true
		win:Toggle(true)
		win:_TryAutoload()
		safe(opts.OnLoaded, win)
	end)

	if opts.Settings ~= false then win:_BuildSettings() end
	return win
end

return CGui
