function Container:AddTextBox(opts)
	opts = opts or {}
	local win = self.Window
	local b = buildBase(self, opts, 0, 180)
	local el = { Kind = "TextBox" }

	local holder = new("Frame", {
		BackgroundColor3 = Theme.Off, Size = UDim2.fromOffset(160, 26),
		Position = UDim2.new(1, -172, 0.5, -13), Parent = b.Header,
	}, { corner(6), stroke(Theme.Stroke, 1, 0) })
	local hs = holder:FindFirstChildOfClass("UIStroke")
	local box = new("TextBox", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0),
		Text = tostring(opts.Default or ""), PlaceholderText = opts.Placeholder or "Text eingeben...",
		PlaceholderColor3 = Theme.SubText, ClearTextOnFocus = opts.ClearOnFocus == true,
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, ClipsDescendants = true, Parent = holder,
	})

	local function clean(t)
		if opts.Numeric then t = t:gsub("[^%d%.%-]", "") end
		if opts.MaxLength and #t > opts.MaxLength then t = t:sub(1, opts.MaxLength) end
		return t
	end
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local t = clean(box.Text)
		if t ~= box.Text then box.Text = t; return end
		safe(opts.Changed, box.Text)
	end)
	box.Focused:Connect(function() tween(hs, 0.15, { Color = Theme.Accent }) end)
	box.FocusLost:Connect(function(enter)
		tween(hs, 0.15, { Color = Theme.Stroke })
		safe(opts.Callback, box.Text, enter)
	end)
	b.Hit.Activated:Connect(function()
		if not el.Locked then box:CaptureFocus() end
	end)
	selectFX(win, box,
		function() tween(hs, 0.15, { Color = Theme.Accent }) end,
		function() tween(hs, 0.15, { Color = Theme.Stroke }) end)
	el._onLock = function(l) box.TextEditable = not l; box.Selectable = not l end

	function el:Get() return box.Text end
	function el:Set(v, silent)
		box.Text = tostring(v or "")
		if not silent then safe(opts.Callback, box.Text, false) end
	end
	function el:Focus() box:CaptureFocus() end

	finalize(self, el, b, opts)
	return el
end

