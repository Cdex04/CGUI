function Container:AddToggle(opts)
	opts = opts or {}
	local b = buildBase(self, opts, 0, 76)
	local el = { Kind = "Toggle" }
	local state = opts.Default and true or false

	local chip = new("TextLabel", {
		Size = UDim2.fromOffset(52, 24), Position = UDim2.new(1, -64, 0.5, -12),
		BackgroundColor3 = state and Theme.Accent or Theme.Off, Text = state and "ON" or "OFF",
		Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = state and Theme.OnAccent or Theme.SubText, Parent = b.Header,
	}, { corner(7) })

	local function render()
		chip.Text = state and "ON" or "OFF"
		chip.Size = UDim2.fromOffset(60, 28)
		chip.Position = UDim2.new(1, -68, 0.5, -14)
		tween(chip, 0.3, { Size = UDim2.fromOffset(52, 24), Position = UDim2.new(1, -64, 0.5, -12) }, Enum.EasingStyle.Back)
		tween(chip, 0.2, {
			BackgroundColor3 = state and Theme.Accent or Theme.Off,
			TextColor3 = state and Theme.OnAccent or Theme.SubText,
		})
	end

	function el:Get() return state end
	function el:Set(v, silent)
		state = v and true or false
		render()
		if not silent then safe(opts.Callback, state) end
	end
	function el:Toggle(silent) self:Set(not state, silent) end

	b.Hit.Activated:Connect(function()
		if not el.Locked then el:Set(not state) end
	end)

	finalize(self, el, b, opts)
	attachSub(self, el, b)
	el.Hit = b.Hit
	return el
end

