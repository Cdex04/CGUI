function Window:_SelectTab(tab)
	if self.CurrentTab == tab or tab.Locked then return end
	local old = self.CurrentTab
	if old then
		old.Page.Visible = false
		tween(old.Button, 0.25, { BackgroundTransparency = 1 })
		tween(old.Bar, 0.25, { Size = UDim2.fromOffset(3, 0) })
		tween(old.Label, 0.25, { TextColor3 = Theme.SubText })
	end
	self.CurrentTab = tab
	tab.Page.Visible = true
	tab.Page.Position = UDim2.fromOffset(0, 16)
	tween(tab.Page, 0.4, { Position = UDim2.fromOffset(0, 0) })
	tween(tab.Button, 0.25, { BackgroundTransparency = 0.75 })
	tween(tab.Bar, 0.3, { Size = UDim2.fromOffset(3, 18) })
	tween(tab.Label, 0.25, { TextColor3 = Theme.Text })
	self:_CloseSub()
end

function Window:AddTab(opts)
	if type(opts) == "string" then opts = { Name = opts } end
	opts = opts or {}
	local tab = setmetatable({ Window = self, Name = opts.Name or "Tab", Locked = false }, Tab)

	local btn = new("TextButton", {
		BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, AutoButtonColor = false, Text = "",
		Size = UDim2.new(1, 0, 0, 38), Parent = self.TabList,
	}, { corner(8) })
	tab.Bar = new("Frame", {
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(3, 0), Parent = btn,
	}, { corner(2) })

	local slot = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 10, 0.5, -12), Parent = btn,
	})
	local img = new("ImageLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20), ImageColor3 = Theme.Accent, Parent = slot,
	})
	if not (opts.Icon and applyIcon(img, opts.Icon)) then
		img:Destroy()
		new("TextLabel", {   -- ohne Icon: die ersten 2 Buchstaben
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = string.sub(tab.Name, 1, 2),
			Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Accent, Parent = slot,
		})
	end

	tab.Label = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -46, 1, 0), Text = tab.Name,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, TextTransparency = self.TabsExpanded and 0 or 1, Parent = btn,
	})
	tab.Button = btn

	tab.Page = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent,
		ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = self.Content,
	}, { new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), padding(0, 2, 4, 6) })

	btn.MouseEnter:Connect(function()
		if opts.Description and opts.Description ~= "" then self:_ShowTip(opts.Description) end
		if self.CurrentTab ~= tab then tween(btn, 0.15, { BackgroundTransparency = 0.88 }) end
	end)
	btn.MouseLeave:Connect(function()
		self:_HideTip()
		if self.CurrentTab ~= tab then tween(btn, 0.15, { BackgroundTransparency = 1 }) end
	end)
	btn.MouseButton1Click:Connect(function() self:_SelectTab(tab) end)

	function tab:SetLock(state, mode)
		mode = mode or "Gray"
		self.Locked = state and true or false
		if self.Locked then
			if mode == "Hide" then btn.Visible = false else btn.Visible = true; btn.BackgroundTransparency = 1; tween(self.Label, 0.2, { TextColor3 = Theme.Off }) end
			if self.Window.CurrentTab == self then
				for _, t in ipairs(self.Window.Tabs) do
					if not t.Locked then self.Window.CurrentTab = nil; self.Window:_SelectTab(t); break end
				end
			end
		else
			btn.Visible = true
			tween(self.Label, 0.2, { TextColor3 = (self.Window.CurrentTab == self) and Theme.Text or Theme.SubText })
		end
	end
	function tab:Lock(mode) self:SetLock(true, mode) end
	function tab:Unlock() self:SetLock(false) end
	function tab:Select() self.Window:_SelectTab(self) end

	table.insert(self.Tabs, tab)
	if not self.CurrentTab then self:_SelectTab(tab) end
	if opts.Locked then tab:SetLock(true, opts.LockMode) end
	return tab
end

function Window:SetTabsExpanded(v)
	self.TabsExpanded = v and true or false
	local w = self.TabsExpanded and 160 or 52
	tween(self.Sidebar, 0.35, { Size = UDim2.new(0, w, 1, -16) })
	tween(self.Content, 0.35, { Position = UDim2.new(0, w + 16, 0, 8), Size = UDim2.new(1, -(w + 24), 1, -16) })
	for _, t in ipairs(self.Tabs) do
		tween(t.Label, 0.25, { TextTransparency = self.TabsExpanded and 0 or 1 })
	end
	self.Arrow.Text = self.TabsExpanded and "«" or "»"
end

