-- Window erstellen
--------------------------------------------------------------------
function CGui:CreateWindow(opts)
	opts = opts or {}
	local win = setmetatable({
		Name = opts.Name or "Settings",
		Version = opts.Version or "",
		Tabs = {}, Elements = {}, _conns = {},
		Ready = false, Visible = false,
		ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift,
		NotifyType = opts.NotifyType or "CGui",            -- "CGui" | "Roblox" | "Window"
		NotifyStack = opts.NotifyStack ~= false,           -- true = stapeln, false = überdecken
		TabsExpanded = true,
	}, Window)

	-- ScreenGui in CoreGui (Fallback: gethui / PlayerGui)
	local gui = new("ScreenGui", {
		Name = "CGui", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end
	pcall(function()
		local old = game:GetService("CoreGui"):FindFirstChild("CGui")
		if old then old:Destroy() end
	end)
	local ok = pcall(function() gui.Parent = game:GetService("CoreGui") end)
	if not ok or not gui.Parent then
		if gethui then pcall(function() gui.Parent = gethui() end) end
		if not gui.Parent then gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end
	end
	win.Gui = gui

	-- Hauptfenster
	local size = opts.Size or Vector2.new(640, 420)
	local minSize = Vector2.new(480, 300)
	local main = new("CanvasGroup", {
		Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y), BackgroundColor3 = Theme.Main, BorderSizePixel = 0,
		GroupTransparency = 1, Visible = false, Parent = gui,
	}, { corner(12), stroke(Theme.Stroke, 1, 0) })
	win.Main = main
	win.Scale = new("UIScale", { Scale = 0.9, Parent = main })

	-- Topbar: Name (+ Version)
	local top = new("Frame", { BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 46), Parent = main })
	local hasVersion = win.Version ~= ""
	new("TextLabel", {
		BackgroundTransparency = 1, Position = hasVersion and UDim2.fromOffset(16, 6) or UDim2.new(0, 16, 0, 0),
		Size = hasVersion and UDim2.new(1, -32, 0, 20) or UDim2.new(1, -32, 1, 0), Text = win.Name,
		Font = Enum.Font.GothamBold, TextSize = hasVersion and 15 or 18, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = top,
	})
	if hasVersion then
		new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 26), Size = UDim2.new(1, -32, 0, 14),
			Text = win.Version, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = Theme.Text,
			TextTransparency = 0.55, TextXAlignment = Enum.TextXAlignment.Left, Parent = top,
		})
	end

	-- Body
	local body = new("Frame", {
		BackgroundTransparency = 1, ClipsDescendants = true, Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 1, -46), Parent = main,
	})
	win.Body = body

	-- Sidebar (Tabs)
	local sidebar = new("Frame", {
		BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0, Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(0, 160, 1, -16), ClipsDescendants = true, Parent = body,
	}, { corner(10) })
	win.Sidebar = sidebar
	win.Arrow = new("TextButton", {
		BackgroundTransparency = 1, Text = "«", Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = Theme.Accent,
		Size = UDim2.new(1, 0, 0, 30), Parent = sidebar,
	})
	win.Arrow.MouseEnter:Connect(function() tween(win.Arrow, 0.15, { TextColor3 = Theme.Text }) end)
	win.Arrow.MouseLeave:Connect(function() tween(win.Arrow, 0.15, { TextColor3 = Theme.Accent }) end)
	win.Arrow.MouseButton1Click:Connect(function() win:SetTabsExpanded(not win.TabsExpanded) end)

	win.TabList = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -34),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Accent, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = sidebar,
	}, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }), padding(4, 2, 4, 4) })

	win.Content = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 176, 0, 8), Size = UDim2.new(1, -184, 1, -16), Parent = body,
	})

	-- Notifications: CGui (unten rechts) + im Window
	local function holder(layout)
		local h = new("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
			Size = UDim2.new(0, 300, 1, -32), ZIndex = 60, Parent = gui,
		})
		if layout then
			new("UIListLayout", {
				VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
				Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = h,
			})
		end
		return h
	end
	win.NotifStack = holder(true)
	win.NotifOverlap = holder(false)
	win.WinNotifs = new("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.new(0, 260, 1, -24), ZIndex = 50, Parent = body,
	}, { new("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
	}) })

	-- Tooltip
	win.Tip = new("TextLabel", {
		Visible = false, BackgroundColor3 = Theme.Topbar, AutomaticSize = Enum.AutomaticSize.XY, Text = "",
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Theme.Text, ZIndex = 120, Parent = gui,
	}, { corner(6), stroke(Theme.Accent, 1, 0.5), padding(8, 5, 8, 5) })
	win:_Connect(RunService.RenderStepped, function()
		if win.Tip.Visible then
			local m = UIS:GetMouseLocation()
			win.Tip.Position = UDim2.fromOffset(m.X + 14, m.Y + 16)
		end
	end)

	-- Dragging
	local dragging, dragStart, startPos
	top.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging, dragStart, startPos = true, input.Position, main.Position
		end
	end)
	win:_Connect(UIS.InputChanged, function(input)
		if dragging and isMove(input) then
			local d = input.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	win:_Connect(UIS.InputEnded, function(input)
		if isPress(input) then dragging = false end
	end)

	-- Resizing (Ecke unten rechts)
	local grip = new("TextButton", {
		BackgroundTransparency = 1, Text = "", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -2, 1, -2),
		Size = UDim2.fromOffset(18, 18), ZIndex = 40, Parent = main,
	})
	for i = 1, 2 do
		new("Frame", {
			BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.3, BorderSizePixel = 0, Rotation = -45,
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(6 + i * 4, 6 + i * 4), Size = UDim2.fromOffset(i * 6 + 2, 2), Parent = grip,
		})
	end
	local resizing, rStart, rSize, rPos
	grip.InputBegan:Connect(function(input)
		if isPress(input) then
			resizing, rStart = true, input.Position
			rSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
			rPos = main.Position
		end
	end)
	win:_Connect(UIS.InputChanged, function(input)
		if resizing and isMove(input) then
			local d = input.Position - rStart
			local nw, nh = math.max(minSize.X, rSize.X + d.X), math.max(minSize.Y, rSize.Y + d.Y)
			main.Size = UDim2.fromOffset(nw, nh)
			main.Position = UDim2.new(rPos.X.Scale, rPos.X.Offset + (nw - rSize.X) / 2, rPos.Y.Scale, rPos.Y.Offset + (nh - rSize.Y) / 2)
		end
	end)
	win:_Connect(UIS.InputEnded, function(input)
		if isPress(input) then resizing = false end
	end)

	-- GUI per Keybind öffnen/schließen
	win:_Connect(UIS.InputBegan, function(input, gp)
		if gp or win.Listening or not win.Ready then return end
		if win.ToggleKey and input.KeyCode == win.ToggleKey then win:Toggle() end
	end)

	-- Ablauf: Laden -> (Key-System) -> Window öffnen
	task.spawn(function()
		win:_RunLoading(opts)
		if win.Destroyed then return end
		local ks = opts.KeySystem
		if type(ks) == "table" and ks.Enabled then win:_RunKeySystem(ks) end
		if win.Destroyed then return end
		win.Ready = true
		win:Toggle(true)
		safe(opts.OnLoaded, win)
	end)

	return win
end

return CGui
