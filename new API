-- Slider
--------------------------------------------------------------------
function Container:AddSlider(opts)
	opts = opts or {}
	local win = self.Window
	local min, max = opts.Min or 0, opts.Max or 100
	local inc = (opts.Increment and opts.Increment > 0) and opts.Increment or 1
	local b = buildBase(self, opts, 24, 96)
	local el = { Kind = "Slider" }

	local function snap(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		return math.floor(v * 1e6 + 0.5) / 1e6
	end
	local value = snap(opts.Default or opts.Start or min)

	local valLabel = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(84, 18), Position = UDim2.new(1, -96, 0, b.NameY),
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right, Parent = b.Header,
	})
	local track = new("Frame", {
		BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Position = UDim2.new(0, 14, 0, b.HeadH + 9),
		Size = UDim2.new(1, -28, 0, 6), Parent = b.Frame,
	}, { corner(3) })
	local fill = new("Frame", {
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = track,
	}, { corner(3) })
	local knob = new("Frame", {
		BackgroundColor3 = Theme.OnAccent, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14),
		Position = UDim2.fromScale(0, 0.5), ZIndex = 2, Parent = track,
	}, { corner(9) })
	local area = new("TextButton", {
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
		Position = UDim2.new(0, 0, 0, b.HeadH), Size = UDim2.new(1, 0, 0, 24), Parent = b.Frame,
	})

	local function render()
		local a = (max > min) and (value - min) / (max - min) or 0
		tween(fill, 0.1, { Size = UDim2.fromScale(a, 1) })
		tween(knob, 0.1, { Position = UDim2.fromScale(a, 0.5) })
		valLabel.Text = tostring(value) .. (opts.Suffix or "")
	end

	padSlider(win, area, knob, function(dir)
		if not el.Locked then el:Set(value + dir * inc) end
	end)
	el._onLock = function(l) area.Selectable = not l end

	function el:Get() return value end
	function el:Set(v, silent)
		local nv = snap(tonumber(v) or value)
		local changed = nv ~= value
		value = nv
		render()
		if changed and not silent then safe(opts.Callback, value) end
	end

	bindSliderInput(win, area, track, knob, function(a)
		if el.Locked then return end
		el:Set(min + a * (max - min))
	end)

	render()
	finalize(self, el, b, opts)
	return el
end

