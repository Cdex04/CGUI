-- Schliessen / Verstecken
function Window:Show() self:Toggle(true) end

function Window:Hide()
	self:Toggle(false)
	if self.ToggleKey then
		self:Notify({
			Title = self.Name, Type = "CGui", Duration = 4,
			Content = "Versteckt. Mit " .. self.ToggleKey.Name .. " wieder öffnen.",
		})
	end
end

function Window:Close()
	if not self.Ready then self:Destroy(); return end
	self:Toggle(false)
	task.delay(0.45, function() self:Destroy() end)
end

function Window:RequestClose()
	local mode = self.CloseAction
	if mode == "Hide" then self:Hide(); return end
	if mode == "Destroy" then self:Close(); return end
	self:Prompt({
		Title = "Fenster schließen?",
		Content = "Was möchtest du mit diesem Fenster tun?",
		Scope = self.PromptScope,
		Options = {
			{ Text = "Abbrechen" },
			{ Text = "Komplett schließen", Style = "Danger", Callback = function() self:Close() end },
			{ Text = "Verstecken", Style = "Primary", Callback = function() self:Hide() end },
		},
	})
end

--------------------------------------------------------------------
-- Prompt (Abfrage mit 1-6 Optionen und X)
--------------------------------------------------------------------
-- Window:Prompt({
--     Title = "Frage", Content = "Text", Scope = "Window" | "Screen",
--     Options = { "Ja", "Nein" }  oder  { { Text = "Loeschen", Style = "Danger", Callback = fn }, ... },  -- Style: Normal, Primary, Danger
--     Cancelable = true, OnCancel = fn, Callback = function(text, index) end,
--     Yield = false   -- true: wartet und gibt (text, index) zurueck (nil bei Abbruch)
-- })
function Window:CreatePrompt(opts)
	local p = { Opts = opts or {}, Window = self }
	function p:Show() self.Window:_QueuePrompt(self); return self end
	function p:Close() if self._close then self._close() end end
	return p
end

function Window:Prompt(opts)
	local p = self:CreatePrompt(opts)
	p:Show()
	if opts and opts.Yield then
		repeat task.wait() until p.Done or self.Destroyed
		return p.Result, p.Index
	end
	return p
end

function Window:_QueuePrompt(p)
	table.insert(self._promptQueue, p)
	if not self._activePrompt then self:_NextPrompt() end
end

function Window:_NextPrompt()
	local p = table.remove(self._promptQueue, 1)
	if p then self:_ShowPrompt(p) end
end

function Window:_ShowPrompt(p)
	local o = p.Opts
	local screen = (o.Scope or self.PromptScope) == "Screen"
	local parent = screen and self.Gui or self.Main
	local cancelable = o.Cancelable ~= false

	local options = {}
	for i, v in ipairs(o.Options or { "OK" }) do
		if i > 6 then break end
		options[i] = (type(v) == "table") and v or { Text = tostring(v) }
	end
	if #options == 0 then options[1] = { Text = "OK" } end

	local overlay = new("Frame", {
		Name = "CGuiPrompt", BackgroundColor3 = Theme.Overlay, BackgroundTransparency = 0.3, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), Active = true, ZIndex = screen and 200 or 150, Parent = parent,
	}, screen and {} or { corner(14) })

	local CARD_W = 360
	local card = new("Frame", {
		BackgroundColor3 = Theme.Main, BorderSizePixel = 0, Size = UDim2.fromOffset(CARD_W, 120), Parent = overlay,
	}, { corner(14), stroke(Theme.Accent, 1, 0.4) })
	local inner = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 18), Size = UDim2.new(1, -40, 0, 0), Parent = card,
	})
	local layout = new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner })

	new("TextLabel", {
		LayoutOrder = 1, BackgroundTransparency = 1, Size = UDim2.new(1, -34, 0, 22), Text = o.Title or "Hinweis",
		Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = inner,
	})
	if o.Content and o.Content ~= "" then
		new("TextLabel", {
			LayoutOrder = 2, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			Text = o.Content, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.SubText, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			RichText = o.RichText == true, Parent = inner,
		})
	end

	local n = #options
	local cols = (n == 1 and 1) or (n == 2 and 2) or (n == 3 and 3) or (n == 4 and 2) or 3
	local rows = math.ceil(n / cols)
	local grid = new("Frame", {
		LayoutOrder = 3, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, rows * 36 + (rows - 1) * 8), Parent = inner,
	})
	new("UIGridLayout", {
		CellPadding = UDim2.fromOffset(8, 8), CellSize = UDim2.new(1 / cols, -(8 * (cols - 1)) / cols, 0, 36),
		SortOrder = Enum.SortOrder.LayoutOrder, FillDirectionMaxCells = cols, Parent = grid,
	})

	-- Position: immer auf ganzen Pixeln (scharfer Text)
	local placed = false
	local function place()
		local h = layout.AbsoluteContentSize.Y + 38
		card.Size = UDim2.fromOffset(CARD_W, h)
		local pw, ph
		if screen then
			pw, ph = self.Gui.AbsoluteSize.X, self.Gui.AbsoluteSize.Y
		else
			pw, ph = self.Main.Size.X.Offset, self.Main.Size.Y.Offset
		end
		local tx, ty = math.floor((pw - CARD_W) / 2), math.floor((ph - h) / 2)
		if not placed then
			placed = true
			card.Position = UDim2.fromOffset(tx, ty + 18)
			tween(card, 0.35, { Position = UDim2.fromOffset(tx, ty) })
		else
			card.Position = UDim2.fromOffset(tx, ty)
		end
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(place)
	task.defer(place)

	local closed = false
	local function finish(opt, idx)
		if closed then return end
		closed = true
		self._activePrompt = nil
		p.Done, p.Result, p.Index = true, opt and tostring(opt.Text or "") or nil, idx
		local sel = GuiService.SelectedObject
		if sel and sel:IsDescendantOf(overlay) then GuiService.SelectedObject = nil end
		fadeTween(fadeCapture(overlay), 0.2, 1)
		task.delay(0.22, function()
			overlay:Destroy()
			if opt then
				safe(opt.Callback, opt.Text, idx)
				safe(o.Callback, opt.Text, idx)
			else
				safe(o.OnCancel)
			end
			self:_NextPrompt()
		end)
	end
	p._close = function() finish(nil, nil) end
	p._cancel = cancelable and p._close or nil
	self._activePrompt = p

	if cancelable then
		local x = new("TextButton", {
			BackgroundColor3 = Theme.Element, AutoButtonColor = false, Text = "", Size = UDim2.fromOffset(26, 26),
			Position = UDim2.new(1, -38, 0, 14), Parent = card,
		}, { corner(8) })
		local _, lines = drawX(x, 10, Theme.SubText, 2)
		local function xin()
			tween(x, 0.15, { BackgroundColor3 = Theme.Error })
			for _, l in ipairs(lines) do tween(l, 0.15, { BackgroundColor3 = Theme.OnAccent }) end
		end
		local function xout()
			tween(x, 0.15, { BackgroundColor3 = Theme.Element })
			for _, l in ipairs(lines) do tween(l, 0.15, { BackgroundColor3 = Theme.SubText }) end
		end
		x.MouseEnter:Connect(xin)
		x.MouseLeave:Connect(xout)
		selectFX(self, x, xin, xout)
		x.Activated:Connect(function() finish(nil, nil) end)
	end

	local first
	for i, opt in ipairs(options) do
		local style = opt.Style or "Normal"
		local btn = new("TextButton", {
			BackgroundColor3 = (style == "Primary" and Theme.Accent) or (style == "Danger" and Theme.Error) or Theme.Off,
			AutoButtonColor = false, Text = tostring(opt.Text or "Option"), Font = Enum.Font.GothamMedium, TextSize = 13,
			TextColor3 = (style == "Normal") and Theme.Text or Theme.OnAccent, TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = i, Parent = grid,
		}, { corner(9), padding(8, 0, 8, 0) })
		local function bin() tween(btn, 0.15, { BackgroundTransparency = 0.2 }) end
		local function bout() tween(btn, 0.15, { BackgroundTransparency = 0 }) end
		btn.MouseEnter:Connect(bin)
		btn.MouseLeave:Connect(bout)
		selectFX(self, btn, bin, bout)
		btn.Activated:Connect(function() finish(opt, i) end)
		first = first or btn
	end

	local snap = fadeCapture(overlay)
	fadeSet(snap, 1)
	fadeTween(snap, 0.25, 0)
	if isGamepadActive() and first then
		task.defer(function() GuiService.SelectedObject = first end)
	end
end

--------------------------------------------------------------------
-- Konfigurationen (Executor: writefile / readfile)
--------------------------------------------------------------------
function Window:_Dir()
	if not isfolder("CGui") then makefolder("CGui") end
	local d = "CGui/" .. cleanName(self.Name)
	if not isfolder(d) then makefolder(d) end
	return d
end

function Window:ListConfigs()
	local out = {}
	if not fsOk() then return out end
	local ok, files = pcall(function() return listfiles(self:_Dir()) end)
	if ok and files then
		for _, f in ipairs(files) do
			local n = tostring(f):match("([^/\\]+)%.json$")
			if n then table.insert(out, n) end
		end
	end
	table.sort(out)
	return out
end

function Window:SaveConfig(name)
	if not fsOk() then return false, "Dateisystem nicht verfügbar" end
	name = cleanName(name or "default")
	if name == "" then name = "default" end
	local data = {}
	for flag, el in pairs(self.Elements) do
		if el.Get then
			local v = el:Get()
			if el.Kind == "ColorPicker" and typeof(v) == "Color3" then
				v = { math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5) }
			elseif el.Kind == "Keybind" then
				v = v and v.Name or ""
			end
			data[flag] = v
		end
	end
	local ok, err = pcall(function()
		writefile(self:_Dir() .. "/" .. name .. ".json", HttpService:JSONEncode(data))
	end)
	return ok, err
end

function Window:LoadConfig(name)
	if not fsOk() then return false, "Dateisystem nicht verfügbar" end
	name = cleanName(name or "default")
	local path = self:_Dir() .. "/" .. name .. ".json"
	if not isfile(path) then return false, "Konfiguration nicht gefunden: " .. name end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "Datei beschädigt" end
	for flag, v in pairs(data) do
		local el = self.Elements[flag]
		if el and el.Set then
			if el.Kind == "ColorPicker" and type(v) == "table" then
				v = Color3.fromRGB(v[1] or 0, v[2] or 0, v[3] or 0)
			elseif el.Kind == "Keybind" and v == "" then
				v = nil
			end
			pcall(function() el:Set(v) end)
		end
	end
	return true
end

function Window:DeleteConfig(name)
	if not (fsOk() and delfile) then return false, "Dateisystem nicht verfügbar" end
	local ok, err = pcall(function() delfile(self:_Dir() .. "/" .. cleanName(name) .. ".json") end)
	return ok, err
end

function Window:SetAutoload(name)
	if not fsOk() then return false, "Dateisystem nicht verfügbar" end
	local ok, err = pcall(function() writefile(self:_Dir() .. "/_autoload.txt", cleanName(name or "default")) end)
	return ok, err
end

function Window:_TryAutoload()
	if not fsOk() then return end
	pcall(function()
		local f = self:_Dir() .. "/_autoload.txt"
		if isfile(f) then
			local n = trim(readfile(f))
			if n ~= "" then self:LoadConfig(n) end
		end
	end)
end

