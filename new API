--------------------------------------------------------------------
function Window:Toggle(state)
	if not self.Ready then return end
	if state == nil then state = not self.Visible end
	if state == self.Visible then return end
	self.Visible = state
	self._fade = (self._fade or 0) + 1
	local token = self._fade
	local main, scale, sf = self.Main, self.Scale, self.SettingsFrame
	local us = self.UserScale or 1
	self:_HideTip()
	if state then
		if self._snap then fadeSet(self._snap, 0); self._snap = nil end
		local snap = mergeSnap(fadeCapture(main), fadeCapture(sf))
		self._rest = snap
		self._openedAt = os.clock()
		fadeSet(snap, 1)
		main.Visible = true
		scale.Scale = 0.9 * us
		tween(scale, 0.45, { Scale = us }, Enum.EasingStyle.Back)
		fadeTween(snap, 0.35, 0)
		if isGamepadActive() then
			task.delay(0.45, function()
				if self.Visible and self._fade == token and self.CurrentTab then
					GuiService.SelectedObject = self.CurrentTab.Button
				end
			end)
		end
	else
		if self._stopEdit then self._stopEdit() end
		local sel = GuiService.SelectedObject
		if sel and (sel:IsDescendantOf(main) or sel:IsDescendantOf(sf)) then GuiService.SelectedObject = nil end
		if self._rest and os.clock() - (self._openedAt or 0) < 0.4 then fadeSet(self._rest, 0) end
		local snap = mergeSnap(fadeCapture(main), fadeCapture(sf))
		self._snap = snap
		tween(scale, 0.3, { Scale = 0.92 * us })
		fadeTween(snap, 0.3, 1)
		task.delay(0.33, function()
			if self._fade == token then
				fadeSet(snap, 0)
				self._snap = nil
				main.Visible = false
				sf.Visible = false
			end
		end)
	end
end

function Window:SetTheme(t) CGui:SetTheme(t) end

function Window:SetUIScale(s)
	s = math.clamp(tonumber(s) or 1, 0.5, 2)
	self.UserScale = s
	if self.Visible then tween(self.Scale, 0.2, { Scale = s }) else self.Scale.Scale = s end
end

function Window:SetBackgroundTransparency(a)
	a = math.clamp(tonumber(a) or 0, 0, 0.8)
	self.Main.BackgroundTransparency = a
	self.Topbar.BackgroundTransparency = a
end

function Window:CenterWindow()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	tween(self.Main, 0.4, { Position = UDim2.fromOffset(math.floor(vp.X / 2), math.floor(vp.Y / 2)) })
end

function Window:GetSettings() return self.Settings end

-- Settings-Panel hinter dem Hauptfenster ein-/ausschieben
function Window:ToggleSettings(state)
	if state == nil then state = not self._settingsOpen end
	self._settingsOpen = state
	self._sTarget = state and 1 or 0
	tween(self.SettingsBtn, 0.25, { BackgroundColor3 = state and Theme.Accent or Theme.Element })
	tween(self.SettingsBtnLabel, 0.25, { TextColor3 = state and Theme.OnAccent or Theme.Text })
	if state and isGamepadActive() then
		task.delay(0.4, function()
			for _, inst in ipairs(self.Settings.Page:GetDescendants()) do
				if inst:IsA("TextButton") and inst.Selectable and inst.Visible then
					GuiService.SelectedObject = inst
					break
