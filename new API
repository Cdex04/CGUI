	local style = opts.Style or "Plain"
	local function barColor(st)
		if st == "Info" then return Theme.Accent end
		if st == "Success" then return Theme.Success end
		if st == "Warning" then return Theme.Warning end
		if st == "Error" then return Theme.Error end
		return Theme.SubText
	end

	local frame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 28), Parent = self.Page })
	local bar = new("Frame", {
		BackgroundColor3 = barColor(style), BorderSizePixel = 0, Position = UDim2.fromOffset(0, 2),
		Size = UDim2.new(0, 3, 1, -4), Parent = frame,
	}, { corner(2) })
	local content = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 4), Size = UDim2.new(1, -18, 0, 0), Parent = frame,
	})
	local layout = new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = content })

	local title, body
	local function mk(order, text, size, font, color)
		return new("TextLabel", {
			LayoutOrder = order, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, Text = text, Font = font, TextSize = size, TextColor3 = color,
			TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			RichText = opts.RichText == true, Parent = content,
		})
	end
	if opts.Title and opts.Title ~= "" then title = mk(1, opts.Title, 14, Enum.Font.GothamBold, Theme.Text) end
	body = mk(2, tostring(opts.Text or ""), 13, Enum.Font.Gotham, title and Theme.SubText or Theme.Text)
	autoHeight(frame, layout, 8, 26, false)

	local el = { Kind = "Label", Frame = frame }
	function el:Get() return body.Text end
	function el:SetText(t) body.Text = tostring(t) end
	function el:SetTitle(t)
		if title then
			title.Text = tostring(t)
		else
			title = mk(1, tostring(t), 14, Enum.Font.GothamBold, Theme.Text)
			body.TextColor3 = Theme.SubText
		end
	end
	function el:SetStyle(st) tween(bar, 0.2, { BackgroundColor3 = barColor(st) }) end
	function el:SetVisible(v) frame.Visible = v and true or false end
	function el:Destroy() frame:Destroy() end
	return el
end
