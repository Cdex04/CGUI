	local status = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 192), Size = UDim2.new(1, -90, 0, 16), Text = "",
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
	})
