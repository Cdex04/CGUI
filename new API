	local grad = new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = ringStroke,
	})
	local rot = 0
	local spin = RunService.RenderStepped:Connect(function(dt)
		rot = (rot + dt * 300) % 360
		grad.Rotation = rot
	end)

	local barTrack = new("Frame", {
		BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, Position = UDim2.fromOffset(30, 180),
		Size = UDim2.new(1, -60, 0, 6), Parent = box,
	}, { corner(3) })
