-- Notifications
--------------------------------------------------------------------
local function buildCard(parent, opts, duration)
	local card = new("Frame", {
		BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 64), Parent = parent,
	}, { corner(10), stroke(Theme.Accent, 1, 0.45) })
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 7), Size = UDim2.new(1, -24, 0, 18),
		Text = opts.Title or "CGui", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card,
	})
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -24, 0, 30),
		Text = opts.Content or "", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true, Parent = card,
	})
	local bar = new("Frame", {
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 2), Parent = card,
	})
	tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
	return card
end

function Window:Notify(opts)
	if type(opts) == "string" then opts = { Content = opts } end
	opts = opts or {}
	local kind = opts.Type or self.NotifyType
	if kind == "Roblox" then
		pcall(function()
			StarterGui:SetCore("SendNotification", {
				Title = opts.Title or self.Name, Text = opts.Content or "", Duration = opts.Duration or 4,
			})
		end)
		return
	end
	local duration = opts.Duration or 4

	if kind == "Window" then
		local card = buildCard(self.WinNotifs, opts, duration)
		card.Position = UDim2.new(0, 0, 0, 80)
		card.BackgroundTransparency = 1
		local wrap = card
		-- im Window: einfaches Einblenden von unten
		tween(card, 0.35, { BackgroundTransparency = 0 })
		task.delay(duration, function()
			if card.Parent then
				tween(card, 0.3, { BackgroundTransparency = 1 })
				task.wait(0.3)
				card:Destroy()
			end
		end)
		return wrap
	end

	-- CGui-Notification unten rechts
	local stack = opts.Stack
	if stack == nil then stack = self.NotifyStack end
	local holder = stack and self.NotifStack or self.NotifOverlap
	local wrap = new("Frame", { BackgroundTransparency = 1, Parent = holder })
	if stack then
		wrap.Size = UDim2.new(1, 0, 0, 0)
		tween(wrap, 0.3, { Size = UDim2.new(1, 0, 0, 64) })
	else
		wrap.AnchorPoint = Vector2.new(0, 1)
		wrap.Position = UDim2.new(0, 0, 1, 0)
		wrap.Size = UDim2.new(1, 0, 0, 64)
	end
	local card = buildCard(wrap, opts, duration)
	card.Position = UDim2.new(1, 40, 0, 0)
	tween(card, 0.4, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
	task.delay(duration, function()
		if not card.Parent then return end
		tween(card, 0.3, { Position = UDim2.new(1, 40, 0, 0) })
		task.wait(0.3)
		if stack and wrap.Parent then
			tween(wrap, 0.25, { Size = UDim2.new(1, 0, 0, 0) })
			task.wait(0.25)
		end
		wrap:Destroy()
	end)
end

--------------------------------------------------------------------
-- Öffnen / Schließen
--------------------------------------------------------------------
function Window:Toggle(state)
	if not self.Ready then return end
	if state == nil then state = not self.Visible end
	self.Visible = state
	local main, scale = self.Main, self.Scale
	self:_HideTip()
	if state then
		main.Visible = true
		scale.Scale = 0.9
		main.GroupTransparency = 1
		tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		tween(main, 0.35, { GroupTransparency = 0 })
	else
		tween(scale, 0.3, { Scale = 0.92 })
		tween(main, 0.3, { GroupTransparency = 1 }).Completed:Connect(function()
			if not self.Visible then main.Visible = false end
		end)
	end
end

function Window:SetToggleKey(key) self.ToggleKey = key end

function Window:Destroy()
	self.Destroyed = true
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	if self.Gui then self.Gui:Destroy() end
end

-- Elemente per Flag ansprechen: Window:SetValue("flag", wert, silent)
function Window:GetElement(flag) return self.Elements[flag] end
function Window:GetValue(flag) local e = self.Elements[flag]; return e and e:Get() end
function Window:SetValue(flag, value, silent)
	local e = self.Elements[flag]
	if e and e.Set then e:Set(value, silent) end
end

--------------------------------------------------------------------
-- Sub-Settings
--------------------------------------------------------------------
function Window:_OpenSub(panel)
	if self._openSub and self._openSub ~= panel then self:_CloseSub() end
	self._openSub = panel
	panel.Visible = true
	tween(panel, 0.4, { Position = UDim2.new(0.1, 0, 0, 0) })
end

function Window:_CloseSub()
	local panel = self._openSub
	if not panel then return end
	self._openSub = nil
	tween(panel, 0.35, { Position = UDim2.new(1, 0, 0, 0) }).Completed:Connect(function()
		if self._openSub ~= panel then panel.Visible = false end
	end)
end

local function attachSub(container, el, b)
	if container.IsSub then return end
	local win = container.Window
	function el:SubSettings(title)
		if self._sub then return self._sub end
		local panel = new("Frame", {
			BackgroundColor3 = Theme.Main, BorderSizePixel = 0, ZIndex = 30, Visible = false,
			Size = UDim2.new(0.9, 0, 1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = win.Body,
		}, { corner(10), stroke(Theme.Accent, 1, 0.5) })
		local head = new("Frame", {
			BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 38), Parent = panel,
		}, { corner(10) })
		local back = new("TextButton", {
			BackgroundColor3 = Theme.Element, AutoButtonColor = false, Text = "‹  Back", Font = Enum.Font.GothamMedium,
			TextSize = 13, TextColor3 = Theme.Text, Size = UDim2.fromOffset(70, 26), Position = UDim2.fromOffset(8, 6),
			Parent = head,
		}, { corner(6) })
		back.MouseEnter:Connect(function() tween(back, 0.15, { BackgroundColor3 = Theme.Accent }) end)
		back.MouseLeave:Connect(function() tween(back, 0.15, { BackgroundColor3 = Theme.Element }) end)
		back.MouseButton1Click:Connect(function() win:_CloseSub() end)
		new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(88, 0), Size = UDim2.new(1, -96, 1, 0),
			Text = title or self.Name or "Settings", Font = Enum.Font.GothamBold, TextSize = 15,
			TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, Parent = head,
		})
		local page = new("ScrollingFrame", {
			BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(8, 46),
			Size = UDim2.new(1, -16, 1, -54), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, ScrollingDirection = Enum.ScrollingDirection.Y,
			Parent = panel,
		}, { new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), padding(0, 2, 4, 6) })
		local sub = setmetatable({ Window = win, Page = page, Panel = panel, IsSub = true }, SubPage)
		self._sub = sub
		b.Hit.MouseButton2Click:Connect(function()
			if not self.Locked then win:_OpenSub(panel) end
		end)
		return sub
	end
end

--------------------------------------------------------------------
-- Element-Grundgerüst
--------------------------------------------------------------------
local function buildBase(container, opts, extraH, rightW)
	local win = container.Window
	local desc = opts.Description
	local hasDesc = type(desc) == "string" and desc ~= ""
	local below = hasDesc and opts.DescriptionMode ~= "Hover"   -- "Below" (Standard) oder "Hover"
	local headH = below and 52 or 40
	rightW = rightW or 20

	local frame = new("Frame", {
		BackgroundColor3 = Theme.Element, BorderSizePixel = 0, ClipsDescendants = true,
		Size = UDim2.new(1, -6, 0, headH + (extraH or 0)), Parent = container.Page,
	}, { corner(8), stroke() })
	local header = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, headH), Parent = frame })
	local hit = new("TextButton", {
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), Parent = header,
	})

	local left = 12
	if opts.Icon then
		local img = new("ImageLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0, 12, 0.5, -10),
			ImageColor3 = Theme.Accent, Parent = header,
		})
		if applyIcon(img, opts.Icon) then left = 42 else img:Destroy() end
	end

	local nameY = below and UDim2.new(0, left, 0, 8) or UDim2.new(0, left, 0.5, -9)
	local name = new("TextLabel", {
		BackgroundTransparency = 1, Position = nameY, Size = UDim2.new(1, -(left + rightW), 0, 18),
		Text = opts.Name or "Element", Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = header,
	})
	local descLabel
	if below then
		descLabel = new("TextLabel", {
			BackgroundTransparency = 0.2 + 0, Position = UDim2.new(0, left, 0, 28), Size = UDim2.new(1, -(left + rightW), 0, 16),
			Text = desc, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = header,
		})
		descLabel.BackgroundTransparency = 1
		descLabel.TextTransparency = 0.15
	end

	hit.MouseEnter:Connect(function()
		tween(frame, 0.15, { BackgroundColor3 = Theme.ElementHover })
		if hasDesc and not below then win:_ShowTip(desc) end
	end)
	hit.MouseLeave:Connect(function()
		tween(frame, 0.15, { BackgroundColor3 = Theme.Element })
		win:_HideTip()
	end)

	return {
		Frame = frame, Header = header, Hit = hit, Name = name, Desc = descLabel, HeadH = headH,
		Left = left, NameY = below and 8 or 11, Below = below, Description = desc,
	}
end

-- gemeinsame Methoden: Lock, Update, Destroy ...
local function finalize(container, el, b, opts)
	local win = container.Window
	el.Frame = b.Frame
	el.Locked = false
	el.LockMode = opts.LockMode or "Gray"

	local overlay = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(4, 12, 14), BackgroundTransparency = 0.35, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), Active = true, ZIndex = 20, Visible = false, Parent = b.Frame,
	}, { corner(8) })

	function el:SetLock(state, mode)
		mode = mode or self.LockMode or "Gray"
		self.Locked = state and true or false
		self.LockMode = mode
		if self.Locked then
			if self.Close then self:Close() end
			if mode == "Hide" then
				b.Frame.Visible = false
				overlay.Visible = false
			else
				b.Frame.Visible = true
				overlay.Visible = true
				overlay.BackgroundTransparency = 1
				tween(overlay, 0.25, { BackgroundTransparency = 0.35 })
			end
		else
			b.Frame.Visible = true
			overlay.Visible = false
		end
	end
	function el:Lock(mode) self:SetLock(true, mode) end
	function el:Unlock() self:SetLock(false) end

	function el:SetName(text) b.Name.Text = tostring(text) end
	function el:SetDescription(text) if b.Desc then b.Desc.Text = tostring(text) end; b.Description = text end
	function el:SetVisible(v) b.Frame.Visible = v and true or false end
	function el:Destroy()
		if opts.Flag then win.Elements[opts.Flag] = nil end
		b.Frame:Destroy()
	end

	if opts.Flag then win.Elements[opts.Flag] = el end
	if opts.Locked then el:SetLock(true, opts.LockMode) end
	return el
end

--------------------------------------------------------------------
-- Button
--------------------------------------------------------------------
function Container:AddButton(opts)
	if type(opts) == "string" then opts = { Name = opts } end
	opts = opts or {}
	local b = buildBase(self, opts, 0, 30)
	local el = { Kind = "Button" }

	function el:Fire() safe(opts.Callback) end
	b.Hit.MouseButton1Click:Connect(function()
		if el.Locked then return end
		tween(b.Frame, 0.08, { BackgroundColor3 = Theme.Accent })
		task.delay(0.12, function() tween(b.Frame, 0.3, { BackgroundColor3 = Theme.ElementHover }) end)
		el:Fire()
	end)

	finalize(self, el, b, opts)
	attachSub(self, el, b)
	el.Hit = b.Hit
	return el
end

--------------------------------------------------------------------
-- Toggle
--------------------------------------------------------------------
function Container:AddToggle(opts)
	opts = opts or {}
	local b = buildBase(self, opts, 0, 64)
	local el = { Kind = "Toggle" }
	local state = opts.Default and true or false

	local track = new("Frame", {
		Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -52, 0.5, -10),
		BackgroundColor3 = state and Theme.Accent or Theme.Off, Parent = b.Header,
	}, { corner(10) })
	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14), Position = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.new(1, 1, 1), Parent = track,
	}, { corner(7) })

	local function render()
		tween(track, 0.2, { BackgroundColor3 = state and Theme.Accent or Theme.Off })
		tween(knob, 0.25, { Position = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3) }, Enum.EasingStyle.Back)
	end

	function el:Get() return state end
	function el:Set(v, silent)
		state = v and true or false
		render()
		if not silent then safe(opts.Callback, state) end
	end
	function el:Toggle(silent) self:Set(not state, silent) end

	b.Hit.MouseButton1Click:Connect(function()
		if not el.Locked then el:Set(not state) end
	end)

	finalize(self, el, b, opts)
	attachSub(self, el, b)
	el.Hit = b.Hit
	return el
end

--------------------------------------------------------------------
-- Slider
--------------------------------------------------------------------
function Container:AddSlider(opts)
	opts = opts or {}
	local win = self.Window
	local min, max = opts.Min or 0, opts.Max or 100
	local inc = (opts.Increment and opts.Increment > 0) and opts.Increment or 1
	local b = buildBase(self, opts, 24, 96)
	local el = { Kind = "Slider" }

	local function snap(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		return math.floor(v * 1e6 + 0.5) / 1e6
	end
	local value = snap(opts.Default or opts.Start or min)

	local valLabel = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(84, 18), Position = UDim2.new(1, -96, 0, b.NameY),
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right, Parent = b.Header,
	})
	local track = new("Frame", {
		BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Position = UDim2.new(0, 14, 0, b.HeadH + 9),
		Size = UDim2.new(1, -28, 0, 6), Parent = b.Frame,
	}, { corner(3) })
	local fill = new("Frame", {
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = track,
	}, { corner(3) })
	local knob = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14),
		Position = UDim2.fromScale(0, 0.5), ZIndex = 2, Parent = track,
	}, { corner(9) })
	local area = new("TextButton", {
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
		Position = UDim2.new(0, 0, 0, b.HeadH), Size = UDim2.new(1, 0, 0, 24), Parent = b.Frame,
	})

	local function render()
		local a = (max > min) and (value - min) / (max - min) or 0
		tween(fill, 0.1, { Size = UDim2.fromScale(a, 1) })
		tween(knob, 0.1, { Position = UDim2.fromScale(a, 0.5) })
		valLabel.Text = tostring(value) .. (opts.Suffix or "")
	end

	function el:Get() return value end
	function el:Set(v, silent)
		local nv = snap(tonumber(v) or value)
		local changed = nv ~= value
		value = nv
		render()
		if changed and not silent then safe(opts.Callback, value) end
	end

	bindSliderInput(win, area, track, knob, function(a)
		if el.Locked then return end
		el:Set(min + a * (max - min))
	end)

	render()
	finalize(self, el, b, opts)
	return el
end

