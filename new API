--------------------------------------------------------------------
-- Helfer
--------------------------------------------------------------------
local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }) end

local function stroke(color, thickness, transparency)
	return new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function padding(l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
	})
end

local function safe(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then warn("[CGui] " .. tostring(err)) end
end

local function trim(s) return (tostring(s):gsub("^%s+", ""):gsub("%s+$", "")) end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

-- Icons: rbxassetid-Strings / Zahlen direkt, Lucide-Namen über einen Provider.
-- CGui:SetIconProvider(function(name) return "rbxassetid://123" -- oder {Image=, ImageRectSize=, ImageRectOffset=} end)
function CGui:SetIconProvider(fn) CGui.IconProvider = fn end

local function applyIcon(img, icon)
	if not icon or icon == "" then return false end
	local res = icon
	local direct = type(icon) == "number" or tonumber(icon) or (type(icon) == "string" and icon:find("rbx"))
	if not direct and CGui.IconProvider then
		local ok, r = pcall(CGui.IconProvider, icon)
		if ok and r then res = r end
	end
	if type(res) == "table" then
		img.Image = res.Image or res[1] or ""
		if res.ImageRectSize then img.ImageRectSize = res.ImageRectSize end
		if res.ImageRectOffset then img.ImageRectOffset = res.ImageRectOffset end
		return img.Image ~= ""
	elseif type(res) == "number" or tonumber(res) then
		img.Image = "rbxassetid://" .. tostring(res)
		return true
	elseif type(res) == "string" and res:find("rbx") then
		img.Image = res
		return true
	end
	return false
end

-- Slider-Eingabe (wird vom Slider und vom Color Picker benutzt)
local function bindSliderInput(win, area, track, knob, onAlpha)
	local dragging, hovering = false, false
	local function update(x)
		onAlpha(math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1))
	end
	local function knobSize(big)
		tween(knob, 0.15, { Size = big and UDim2.fromOffset(18, 18) or UDim2.fromOffset(14, 14) })
	end
	area.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			knobSize(true)
			update(input.Position.X)
		end
	end)
	area.MouseEnter:Connect(function() hovering = true; knobSize(true) end)
	area.MouseLeave:Connect(function() hovering = false; if not dragging then knobSize(false) end end)
	win:_Connect(UIS.InputChanged, function(input)
		if dragging and isMove(input) then update(input.Position.X) end
	end)
	win:_Connect(UIS.InputEnded, function(input)
		if dragging and isPress(input) then
			dragging = false
			if not hovering then knobSize(false) end
		end
	end)
end

