local TextService = game:GetService("TextService")

local CGui = { Version = "1.0.0" }

local Theme = {
	LoadBg       = Color3.fromRGB(3, 9, 18),
	Main         = Color3.fromRGB(8, 22, 26),
	Topbar       = Color3.fromRGB(11, 30, 35),
	Element      = Color3.fromRGB(14, 38, 43),
	ElementHover = Color3.fromRGB(19, 50, 56),
	Accent       = Color3.fromRGB(0, 168, 150),
	Off          = Color3.fromRGB(28, 62, 66),
	Text         = Color3.fromRGB(226, 245, 243),
