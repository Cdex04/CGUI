-- Dropdown im Inline-Modus: alle Optionen sofort sichtbar, mehrere pro Reihe (Chips)
local function addInlineDropdown(container, opts)
	local win = container.Window
	local multi = opts.Multi and true or false
	local options = opts.Options or {}
	local b = buildBase(container, opts, 0, 20)
	local el = { Kind = "Dropdown" }
	local selected = {}

	local function setSel(def)
		selected = {}
		if type(def) == "table" then
			if multi then
				for _, v in ipairs(def) do selected[v] = true end
			elseif def[1] ~= nil then
				selected[def[1]] = true
			end
		elseif def ~= nil then
			selected[def] = true
		end
	end
	setSel(opts.Default)

	local body = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, b.HeadH), Size = UDim2.new(1, -24, 0, 0), Parent = b.Frame,
	})
	local layout = new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = body,
	})
	autoHeight(b.Frame, layout, b.HeadH + 6, b.HeadH + 8, true)

	local chips = {}
	local function list()
		local out = {}
		for _, o in ipairs(options) do if selected[o] then table.insert(out, o) end end
		return out
	end
	local function paint(instant)
		for o, c in pairs(chips) do
			local on = selected[o] and true or false
			local goal = {
				BackgroundColor3 = on and Theme.Accent or Theme.Off,
				TextColor3 = on and Theme.OnAccent or Theme.Text,
			}
			if instant then
				for k, v in pairs(goal) do c[k] = v end
			else
				tween(c, 0.2, goal)
			end
		end
	end
	local function fire()
		if multi then safe(opts.Callback, list()) else safe(opts.Callback, list()[1]) end
	end
	local function build()
		for _, c in pairs(chips) do c.Parent:Destroy() end
		chips = {}
		for i, o in ipairs(options) do
			local w = TextService:GetTextSize(tostring(o), 13, Enum.Font.GothamMedium, Vector2.new(1000, 30)).X + 28
			local holder = new("Frame", {
				BackgroundTransparency = 1, Size = UDim2.fromOffset(math.floor(w), 34), LayoutOrder = i, Parent = body,
			})
			local c = new("TextButton", {
				BackgroundColor3 = Theme.Off, AutoButtonColor = false, Text = tostring(o), Font = Enum.Font.GothamMedium,
				TextSize = 13, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
				Size = UDim2.new(1, 0, 0, 28), Parent = holder,
			}, { corner(8) })
			c.Activated:Connect(function()
				if el.Locked then return end
				if multi then selected[o] = (not selected[o]) or nil else selected = { [o] = true } end
				paint(false)
				fire()
			end)
			selectFX(win, c,
				function() tween(c, 0.15, { BackgroundTransparency = 0.25 }) end,
				function() tween(c, 0.15, { BackgroundTransparency = 0 }) end)
			chips[o] = c
		end
		paint(true)
	end

	function el:Get()
		if multi then return list() end
		return list()[1]
	end
	function el:Set(v, silent)
		setSel(v)
		paint(false)
		if not silent then fire() end
	end
	function el:Refresh(newOptions, keep)
		options = newOptions or {}
		if keep then
			local k = {}
			for _, o in ipairs(options) do if selected[o] then k[o] = true end end
			selected = k
		else
			selected = {}
		end
		build()
	end
	el._onLock = function(l) for _, c in pairs(chips) do c.Selectable = not l end end

	build()
	finalize(container, el, b, opts)
	return el
end

function Container:AddDropdown(opts)
	if opts and (opts.Mode == "Inline" or opts.Inline) then return addInlineDropdown(self, opts) end
	opts = opts or {}
	local multi = opts.Multi and true or false
	local win = self.Window
	local options = opts.Options or {}
	local b = buildBase(self, opts, 0, 190)
	local el = { Kind = "Dropdown" }
	local open = false
	local selected = {}

	local function setDefault(def)
		selected = {}
		if type(def) == "table" then
			for _, v in ipairs(def) do selected[v] = true end
			if not multi then
				local first = def[1]; selected = first and { [first] = true } or {}
			end
		elseif def ~= nil then
			selected[def] = true
		end
	end
	setDefault(opts.Default)

	local current = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(130, 18), Position = UDim2.new(1, -172, 0, b.NameY),
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = b.Header,
	})
	local arrow = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 18), Position = UDim2.new(1, -30, 0, b.NameY),
		Text = "▼", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.Accent, Parent = b.Header,
	})

	local function list()
		local out = {}
		for _, o in ipairs(options) do if selected[o] then table.insert(out, o) end end
		return out
	end

	local function updateText()
		local l = list()
		current.Text = (#l == 0) and "Auswählen..." or table.concat(l, ", ")
	end

	local bodyH = math.min(#options * 34, 156)
	local scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 8, 0, b.HeadH + 2),
		Size = UDim2.new(1, -16, 0, bodyH), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent, Parent = b.Frame,
	}, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })

	local buttons = {}
	local function paint()
		for o, btn in pairs(buttons) do
			local on = selected[o]
			tween(btn, 0.2, { BackgroundColor3 = on and Theme.Accent or Theme.Off, TextColor3 = on and Theme.OnAccent or Theme.Text })
		end
		updateText()
	end

	local function fire()
		if multi then safe(opts.Callback, list()) else safe(opts.Callback, list()[1]) end
	end

	local function build()
		for _, btn in pairs(buttons) do btn:Destroy() end
		buttons = {}
		bodyH = math.min(#options * 34, 156)
		scroll.Size = UDim2.new(1, -16, 0, bodyH)
		for i, o in ipairs(options) do
			local btn = new("TextButton", {
				BackgroundColor3 = Theme.Off, AutoButtonColor = false, Text = tostring(o), Font = Enum.Font.Gotham,
				TextSize = 13, TextColor3 = Theme.Text, Size = UDim2.new(1, -4, 0, 30), LayoutOrder = i, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, Parent = scroll,
			}, { corner(6) })
			btn.Activated:Connect(function()
				if el.Locked then return end
				if multi then
					selected[o] = (not selected[o]) or nil
				else
					selected = { [o] = true }
				end
				paint()
				fire()
				if not multi then el:Close() end
			end)
			padding(10, 0, 10, 0).Parent = btn
			btn.MouseEnter:Connect(function()   -- voller Name als Tooltip, falls abgeschnitten
				local w = TextService:GetTextSize(tostring(o), 13, Enum.Font.Gotham, Vector2.new(10000, 100)).X
				if w > btn.AbsoluteSize.X - 20 then win:_ShowTip(tostring(o)) end
			end)
			btn.MouseLeave:Connect(function() win:_HideTip() end)
			selectFX(win, btn,
				function() tween(btn, 0.15, { BackgroundTransparency = 0.35 }) end,
				function() tween(btn, 0.15, { BackgroundTransparency = 0 }) end)
			btn.Selectable = open
			buttons[o] = btn
		end
		paint()
	end

	function el:Open()
		if open or self.Locked then return end
		open = true
		for _, bt in pairs(buttons) do bt.Selectable = true end
		tween(b.Frame, 0.35, { Size = UDim2.new(1, -6, 0, b.HeadH + bodyH + 10) })
		tween(arrow, 0.3, { Rotation = 180 })
	end
	function el:Close()
		if not open then return end
		open = false
		for _, bt in pairs(buttons) do bt.Selectable = false end
		tween(b.Frame, 0.3, { Size = UDim2.new(1, -6, 0, b.HeadH) })
		tween(arrow, 0.3, { Rotation = 0 })
	end

	function el:Get()
		if multi then return list() end
		return list()[1]
	end
	function el:Set(v, silent)
		setDefault(v)
		paint()
		if not silent then fire() end
	end
	function el:Refresh(newOptions, keep)
		options = newOptions or {}
		if keep then
			local keepSel = {}
			for _, o in ipairs(options) do if selected[o] then keepSel[o] = true end end
			selected = keepSel
		else
			selected = {}
		end
		build()
		if open then tween(b.Frame, 0.3, { Size = UDim2.new(1, -6, 0, b.HeadH + bodyH + 10) }) end
	end

	b.Hit.Activated:Connect(function()
		if el.Locked then return end
		if open then el:Close() else el:Open() end
	end)

	build()
