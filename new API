local Window = {}; Window.__index = Window
local Container = {}; Container.__index = Container            -- gemeinsame Element-Methoden
local Tab = setmetatable({}, { __index = Container }); Tab.__index = Tab
local SubPage = setmetatable({}, { __index = Container }); SubPage.__index = SubPage

function Window:_Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

--------------------------------------------------------------------
-- Tooltip
--------------------------------------------------------------------
function Window:_ShowTip(text)
	if not text or text == "" then return end
	local tip = self.Tip
	tip.Text = text
	tip.BackgroundTransparency = 1
	tip.TextTransparency = 1
	tip.Visible = true
	tween(tip, 0.15, { BackgroundTransparency = 0, TextTransparency = 0 })
end

function Window:_HideTip()
	self.Tip.Visible = false
end

