local function collectKeys(ks)
	local keys = {}
	if ks.Key then table.insert(keys, trim(ks.Key)) end
	if type(ks.Keys) == "table" then for _, k in ipairs(ks.Keys) do table.insert(keys, trim(k)) end end
	if ks.KeyUrl then
		local ok, res = pcall(function() return game:HttpGet(ks.KeyUrl) end)
		if ok and type(res) == "string" then
			for line in res:gmatch("[^\r\n]+") do
				local t = trim(line)
				if t ~= "" then table.insert(keys, t) end
			end
		else
			return keys, false
		end
	end
	return keys, true
end

function Window:_RunKeySystem(ks)
	local gui = self.Gui
	local maxTries = ks.MaxAttempts or 5
	local lockSecs = ks.LockSeconds or 15
	local remember = (ks.Remember ~= false) and fsOk()
	local keyFile = "CGui/" .. cleanName(self.Name) .. "_key.txt"

	local function check(input)
		local keys, fetched = collectKeys(ks)
		input = trim(input)
		for _, k in ipairs(keys) do
			if input ~= "" and k == input then return true, true end
		end
		return false, fetched
	end

	-- gespeicherter Key: Key-System ueberspringen
	if remember then
		local ok, saved = pcall(function()
			if isfile(keyFile) then return readfile(keyFile) end
		end)
		if ok and saved and trim(saved) ~= "" and (check(saved)) then
			safe(ks.OnSuccess, trim(saved))
			return
		end
	end

	local links = {}
	if ks.GetKeyLink then table.insert(links, { Text = ks.GetKeyText or "Key holen", Url = ks.GetKeyLink }) end
	if type(ks.Links) == "table" then
		for _, l in ipairs(ks.Links) do
			if #links < 3 and type(l) == "table" and l.Url then table.insert(links, { Text = l.Text or "Link", Url = l.Url }) end
		end
	end

	local W = 400
	local submitY = remember and 218 or 182
	local H = submitY + 44 + 24 + (#links > 0 and 46 or 0)
	H = H - H % 2

	local backdrop = new("Frame", {
		BackgroundColor3 = Theme.LoadBg, BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), Active = true, ZIndex = 89, Parent = gui,
	})
	local card = new("Frame", {
		BackgroundColor3 = Theme.Main, BorderSizePixel = 0, Size = UDim2.fromOffset(W, H), ZIndex = 90, Parent = gui,
	}, { corner(16) })
	local border = spinBorder(card, 1.5)
	local vp = gui.AbsoluteSize
	local cx, cy = math.floor((vp.X - W) / 2), math.floor((vp.Y - H) / 2)
	card.Position = UDim2.fromOffset(cx, cy + 20)

	local function label(y, h, text, size, font, color, align)
		return new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(24, y), Size = UDim2.new(1, -48, 0, h), Text = text,
			Font = font, TextSize = size, TextColor3 = color, TextXAlignment = align or Enum.TextXAlignment.Left, Parent = card,
		})
	end
	label(22, 14, string.upper(tostring(self.Name)), 11, Enum.Font.GothamBold, Theme.Accent)
	label(38, 30, ks.Title or "Key System", 24, Enum.Font.GothamBold, Theme.Text)
	label(72, 18, ks.Subtitle or "Gib deinen Key ein, um fortzufahren.", 13, Enum.Font.Gotham, Theme.SubText)

	local holder = new("Frame", {
		BackgroundColor3 = Theme.Element, Position = UDim2.fromOffset(24, 104), Size = UDim2.new(1, -48, 0, 44), Parent = card,
	}, { corner(10), stroke(Theme.Stroke, 1, 0) })
	local inStroke = holder:FindFirstChildOfClass("UIStroke")
	local hasPaste = getclipboard ~= nil
	local box = new("TextBox", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -(hasPaste and 92 or 28), 1, 0),
		Text = "", PlaceholderText = "Key eingeben...", PlaceholderColor3 = Theme.SubText, ClearTextOnFocus = false,
		Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		ClipsDescendants = true, Parent = holder,
	})
	box.Focused:Connect(function() tween(inStroke, 0.15, { Color = Theme.Accent }) end)
	box.FocusLost:Connect(function() tween(inStroke, 0.15, { Color = Theme.Stroke }) end)
	if hasPaste then
		local paste = new("TextButton", {
			BackgroundColor3 = Theme.Off, AutoButtonColor = false, Text = "Einfügen", Font = Enum.Font.GothamMedium,
			TextSize = 12, TextColor3 = Theme.Text, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(70, 28), Parent = holder,
		}, { corner(8) })
		paste.Activated:Connect(function() pcall(function() box.Text = trim(getclipboard()) end) end)
	end

	local status = label(156, 18, "", 12, Enum.Font.Gotham, Theme.SubText)
	status.Size = UDim2.fromOffset(230, 18)
	local attemptsLbl = label(156, 18, "Versuche: 0/" .. maxTries, 12, Enum.Font.Gotham, Theme.SubText, Enum.TextXAlignment.Right)
	local function setStatus(text, color)
		status.Text = text
		status.TextColor3 = color or Theme.SubText
	end

	local rememberOn = ks.RememberDefault ~= false
	if remember then
		label(184, 24, "Key merken", 13, Enum.Font.Gotham, Theme.SubText)
		local chip = new("TextButton", {
			BackgroundColor3 = rememberOn and Theme.Accent or Theme.Off, AutoButtonColor = false,
			Text = rememberOn and "ON" or "OFF", Font = Enum.Font.GothamBold, TextSize = 11,
			TextColor3 = rememberOn and Theme.OnAccent or Theme.SubText,
			Position = UDim2.fromOffset(W - 24 - 52, 184), Size = UDim2.fromOffset(52, 24), Parent = card,
		}, { corner(7) })
		chip.Activated:Connect(function()
			rememberOn = not rememberOn
			chip.Text = rememberOn and "ON" or "OFF"
			tween(chip, 0.2, {
				BackgroundColor3 = rememberOn and Theme.Accent or Theme.Off,
				TextColor3 = rememberOn and Theme.OnAccent or Theme.SubText,
			})
		end)
	end

	local submit = new("TextButton", {
		BackgroundColor3 = Theme.Accent, AutoButtonColor = false, Text = "Bestätigen", Font = Enum.Font.GothamBold,
		TextSize = 14, TextColor3 = Theme.OnAccent, Position = UDim2.fromOffset(24, submitY),
		Size = UDim2.new(1, -48, 0, 44), Parent = card,
	}, { corner(10) })
	local passed, busy, tries, lockedUntil = false, false, 0, 0
	submit.MouseEnter:Connect(function() if not passed then tween(submit, 0.15, { BackgroundColor3 = Theme.AccentHover }) end end)
	submit.MouseLeave:Connect(function() if not passed then tween(submit, 0.15, { BackgroundColor3 = Theme.Accent }) end end)

	if #links > 0 then
		local gap = 8
		local bw = math.floor((W - 48 - gap * (#links - 1)) / #links)
		for i, l in ipairs(links) do
			local lb = new("TextButton", {
				BackgroundColor3 = Theme.Off, AutoButtonColor = false, Text = l.Text, Font = Enum.Font.GothamMedium,
				TextSize = 13, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
				Position = UDim2.fromOffset(24 + (i - 1) * (bw + gap), submitY + 56), Size = UDim2.fromOffset(bw, 34), Parent = card,
			}, { corner(9), padding(6, 0, 6, 0) })
			lb.MouseEnter:Connect(function() tween(lb, 0.15, { BackgroundTransparency = 0.2 }) end)
			lb.MouseLeave:Connect(function() tween(lb, 0.15, { BackgroundTransparency = 0 }) end)
			lb.Activated:Connect(function()
				if setclipboard then
					pcall(setclipboard, l.Url)
					setStatus("Link kopiert: " .. l.Text, Theme.Success)
				else
					setStatus(l.Url, Theme.SubText)
				end
			end)
		end
	end

	-- Einblenden
	local rot = 0
	local rc = RunService.RenderStepped:Connect(function(dt)
		rot = (rot + dt * 60) % 360
		border.Rotation = rot
	end)
	table.insert(self._conns, rc)
	local snap = fadeCapture(card)
	fadeSet(snap, 1)
	fadeTween(snap, 0.35, 0)
	tween(card, 0.45, { Position = UDim2.fromOffset(cx, cy) })
	tween(backdrop, 0.4, { BackgroundTransparency = 0.25 })

	local function shake()
		for _, dx in ipairs({ 10, -10, 6, -6, 0 }) do
			tween(card, 0.05, { Position = UDim2.fromOffset(cx + dx, cy) })
			task.wait(0.05)
		end
	end
	local function startLock()
		lockedUntil = os.clock() + lockSecs
		task.spawn(function()
			while os.clock() < lockedUntil and not passed and not self.Destroyed do
				submit.Text = "Gesperrt (" .. math.ceil(lockedUntil - os.clock()) .. "s)"
				setStatus("Zu viele Versuche - bitte warten.", Theme.Warning)
				task.wait(0.25)
			end
			if not passed then
				submit.Text = "Bestätigen"
				setStatus("", Theme.SubText)
				tries = 0
				attemptsLbl.Text = "Versuche: 0/" .. maxTries
			end
		end)
	end

	local function doSubmit()
		if busy or passed or os.clock() < lockedUntil then return end
		local text = trim(box.Text)
		if text == "" then
			setStatus("Bitte gib einen Key ein.", Theme.Warning)
			shake()
			return
		end
		busy = true
		local dots = true
		task.spawn(function()
			local i = 0
			while busy and dots do
				i = i % 3 + 1
				submit.Text = "Prüfe" .. string.rep(".", i)
				task.wait(0.25)
			end
		end)
		setStatus("Key wird überprüft...", Theme.SubText)
		local ok, fetched = check(text)
		dots = false
		busy = false
		if ok then
			passed = true
			submit.Text = "Akzeptiert!"
			tween(submit, 0.2, { BackgroundColor3 = Theme.Success })
			tween(inStroke, 0.2, { Color = Theme.Success })
			setStatus("Key akzeptiert - willkommen!", Theme.Success)
			if remember and rememberOn then
				pcall(function()
					if not isfolder("CGui") then makefolder("CGui") end
					writefile(keyFile, text)
				end)
			end
			safe(ks.OnSuccess, text)
		else
			tries = tries + 1
			attemptsLbl.Text = "Versuche: " .. tries .. "/" .. maxTries
			setStatus(fetched == false and "Key konnte nicht geladen werden." or "Ungültiger Key.", Theme.Error)
			submit.Text = "Bestätigen"
			tween(inStroke, 0.15, { Color = Theme.Error })
			task.delay(0.8, function() if not passed then tween(inStroke, 0.3, { Color = Theme.Stroke }) end end)
			shake()
			if tries >= maxTries then startLock() end
		end
	end
	submit.Activated:Connect(doSubmit)
	box.FocusLost:Connect(function(enter) if enter then doSubmit() end end)

	repeat task.wait(0.1) until passed or self.Destroyed
	task.wait(0.6)
	fadeTween(fadeCapture(card), 0.4, 1)
	tween(card, 0.4, { Position = UDim2.fromOffset(cx, cy - 16) })
	tween(backdrop, 0.4, { BackgroundTransparency = 1 })
	task.wait(0.45)
	rc:Disconnect()
	card:Destroy()
	backdrop:Destroy()
end

