function Container:AddColorPicker(opts)
	opts = opts or {}
	local win = self.Window
	local showBright = opts.ShowBrightness ~= false     -- Helligkeits-Slider ein/aus
	local rows = showBright and 4 or 3
	local bodyH = rows * 28 + 40
	local b = buildBase(self, opts, 0, 70)
	local el = { Kind = "ColorPicker" }
	local open = false

	local committed = opts.Default or Theme.Accent
	local work = { r = 0, g = 0, b = 0, br = 100 }

	local function finalColor(w)
		local function ch(v)
			if w.br <= 100 then v = v * w.br / 100 else v = v + (255 - v) * (w.br - 100) / 100 end
			return math.clamp(math.floor(v + 0.5), 0, 255)
		end
		return Color3.fromRGB(ch(w.r), ch(w.g), ch(w.b))
	end

	local swatch = new("Frame", {
		BackgroundColor3 = committed, NoTheme = true, Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -52, 0.5, -10), Parent = b.Header,
	}, { corner(6), stroke(Theme.Text, 1, 0.7) })

	local sliders = {}
	local areas = {}
	local function makeRow(y, label, min, max, key, suffix)
		local row = new("Frame", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, b.HeadH + 4 + y), Size = UDim2.new(1, -20, 0, 24), Parent = b.Frame,
		})
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromOffset(74, 24), Text = label, Font = Enum.Font.Gotham,
			TextSize = 12, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
		})
		local val = new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromOffset(44, 24), Position = UDim2.new(1, -44, 0, 0),
			Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
		})
		local track = new("Frame", {
			BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Position = UDim2.new(0, 78, 0.5, -3), Size = UDim2.new(1, -130, 0, 6), Parent = row,
		}, { corner(3) })
		local fill = new("Frame", { BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = track }, { corner(3) })
		local knob = new("Frame", {
			BackgroundColor3 = Theme.OnAccent, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14),
			Position = UDim2.fromScale(0, 0.5), ZIndex = 2, Parent = track,
		}, { corner(9) })
		local area = new("TextButton", {
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), Parent = row,
		})
		local obj = {}
		function obj.render()
			local a = (work[key] - min) / (max - min)
			tween(fill, 0.08, { Size = UDim2.fromScale(a, 1) })
			tween(knob, 0.08, { Position = UDim2.fromScale(a, 0.5) })
			val.Text = tostring(work[key]) .. (suffix or "")
		end
		bindSliderInput(win, area, track, knob, function(a)
			if not open then return end
			work[key] = math.floor(min + a * (max - min) + 0.5)
			obj.render()
			swatch.BackgroundColor3 = finalColor(work)
			safe(opts.Changed, finalColor(work))
		end)
		padSlider(win, area, knob, function(dir)
			if not open then return end
			work[key] = math.clamp(work[key] + dir * math.max(1, math.floor((max - min) / 50)), min, max)
			obj.render()
			swatch.BackgroundColor3 = finalColor(work)
			safe(opts.Changed, finalColor(work))
		end)
		area.Selectable = false
		table.insert(areas, area)
		sliders[key] = obj
	end

	makeRow(0, "Rot", 0, 255, "r")
	makeRow(28, "Grün", 0, 255, "g")
	makeRow(56, "Blau", 0, 255, "b")
	if showBright then makeRow(84, "Helligkeit", 0, 200, "br", "%") end

	local function loadWork(c)
		work.r, work.g, work.b = math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
		work.br = 100
		for _, s in pairs(sliders) do s.render() end
	end

	local btnY = b.HeadH + 4 + rows * 28 + 2
	local cancel = new("TextButton", {
		BackgroundColor3 = Theme.Off, AutoButtonColor = false, Text = "Abbrechen", Font = Enum.Font.GothamMedium,
		TextSize = 13, TextColor3 = Theme.Text, Position = UDim2.new(0, 10, 0, btnY), Size = UDim2.new(0.5, -14, 0, 28), Parent = b.Frame,
	}, { corner(6) })
	local done = new("TextButton", {
		BackgroundColor3 = Theme.Accent, AutoButtonColor = false, Text = "Fertig", Font = Enum.Font.GothamMedium,
		TextSize = 13, TextColor3 = Theme.OnAccent, Position = UDim2.new(0.5, 4, 0, btnY), Size = UDim2.new(0.5, -14, 0, 28), Parent = b.Frame,
	}, { corner(6) })
	cancel.MouseEnter:Connect(function() tween(cancel, 0.15, { BackgroundColor3 = Theme.Error }) end)
	cancel.MouseLeave:Connect(function() tween(cancel, 0.15, { BackgroundColor3 = Theme.Off }) end)
	selectFX(win, cancel,
		function() tween(cancel, 0.15, { BackgroundColor3 = Theme.Error }) end,
		function() tween(cancel, 0.15, { BackgroundColor3 = Theme.Off }) end)
	selectFX(win, done,
		function() tween(done, 0.15, { BackgroundColor3 = Theme.AccentHover }) end,
		function() tween(done, 0.15, { BackgroundColor3 = Theme.Accent }) end)
	local function setBodySel(v)
		cancel.Selectable = v
		done.Selectable = v
		for _, a in ipairs(areas) do a.Selectable = v end
	end
	setBodySel(false)

	function el:Open()
		if open or self.Locked then return end
		open = true
		loadWork(committed)
		setBodySel(true)
		tween(b.Frame, 0.35, { Size = UDim2.new(1, -6, 0, b.HeadH + bodyH) })
	end
	function el:Close()
		if not open then return end
		open = false
		setBodySel(false)
		tween(b.Frame, 0.3, { Size = UDim2.new(1, -6, 0, b.HeadH) })
	end

	function el:Cancel()
		tween(swatch, 0.2, { BackgroundColor3 = committed })
		self:Close()
	end

	function el:Get() return committed end
	function el:Set(c, silent)
		committed = c
		tween(swatch, 0.2, { BackgroundColor3 = c })
		if open then loadWork(c) end
		if not silent then safe(opts.Callback, c) end
	end

	cancel.Activated:Connect(function()
		tween(swatch, 0.2, { BackgroundColor3 = committed })
		el:Close()
	end)
	done.Activated:Connect(function()
		committed = finalColor(work)
		tween(swatch, 0.2, { BackgroundColor3 = committed })
		el:Close()
		safe(opts.Callback, committed)
	end)
	b.Hit.Activated:Connect(function()
		if el.Locked then return end
		if open then el:Cancel() else el:Open() end
	end)

	finalize(self, el, b, opts)
	return el
end

