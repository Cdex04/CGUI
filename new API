	barFill:GetPropertyChangedSignal("Size"):Connect(function()
		pct.Text = math.floor(barFill.Size.X.Scale * 100 + 0.5) .. "%"
	end)

	local function setStatus(text)
		tween(status, 0.12, { TextTransparency = 1 })
