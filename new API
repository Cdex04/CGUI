		Size = UDim2.fromOffset(56, 56), Parent = box,
	}, { corner(28) })
	local ringStroke = new("UIStroke", { Color = Theme.Accent, Thickness = 4, Parent = ring })
	local grad = new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = ringStroke,
	})
	local rot = 0
	local spin = RunService.RenderStepped:Connect(function(dt)
		rot = (rot + dt * 300) % 360
		grad.Rotation = rot
	end)

	local barTrack = new("Frame", {
		BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, Position = UDim2.fromOffset(30, 180),
		Size = UDim2.new(1, -60, 0, 6), Parent = box,
	}, { corner(3) })
	local barFill = new("Frame", { BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = barTrack }, { corner(3) })
	local pct = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 192), Size = UDim2.new(1, -60, 0, 16), Text = "0%",
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = box,
