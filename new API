	local per = total / #steps
	for i, text in ipairs(steps) do
		if self.Destroyed then spin:Disconnect(); return end
		task.spawn(setStatus, text)
		tween(barFill, per, { Size = UDim2.fromScale(i / #steps, 1) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		task.wait(per)
	end
	setStatus(opts.LoadedText or "Fertig!")
	task.wait(0.35)

	tween(scale, 0.6, { Scale = 1.08 })
	tween(scr, 0.6, { GroupTransparency = 1 })
	task.wait(0.65)
	spin:Disconnect()
	scr:Destroy()
end

--------------------------------------------------------------------
-- Key-System
--------------------------------------------------------------------
local function collectKeys(ks)
	local keys = {}
	if ks.Key then table.insert(keys, trim(ks.Key)) end
	if type(ks.Keys) == "table" then for _, k in ipairs(ks.Keys) do table.insert(keys, trim(k)) end end
	if ks.KeyUrl then
		local ok, res = pcall(function() return game:HttpGet(ks.KeyUrl) end)
		if ok and type(res) == "string" then
			for line in res:gmatch("[^\r\n]+") do
				local t = trim(line)
				if t ~= "" then table.insert(keys, t) end
			end
		else
			return keys, false
		end
	end
	return keys, true
end

function Window:_RunKeySystem(ks)
	local gui = self.Gui
	local backdrop = new("Frame", {
		BackgroundColor3 = Theme.LoadBg, BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), ZIndex = 89, Parent = gui,
	})
	local panel = new("CanvasGroup", {
		BackgroundColor3 = Theme.Main, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, ks.GetKeyLink and 250 or 212), GroupTransparency = 1, ZIndex = 90, Parent = gui,
	}, { corner(12), stroke(Theme.Accent, 1, 0.45) })
	local scale = new("UIScale", { Scale = 0.9, Parent = panel })

	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 16), Size = UDim2.new(1, -40, 0, 26),
		Text = ks.Title or "Key System", Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
	})
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 44), Size = UDim2.new(1, -40, 0, 18),
		Text = ks.Subtitle or "Bitte gib deinen Key ein, um fortzufahren.", Font = Enum.Font.Gotham, TextSize = 12,
		TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
	})
	local box = new("TextBox", {
		BackgroundColor3 = Theme.Element, Position = UDim2.fromOffset(20, 76), Size = UDim2.new(1, -40, 0, 36),
		Text = "", PlaceholderText = "Key eingeben...", PlaceholderColor3 = Theme.SubText, ClearTextOnFocus = false,
		Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Theme.Text, Parent = panel,
	}, { corner(8), stroke(), padding(10, 0, 10, 0) })
	local status = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 118), Size = UDim2.new(1, -40, 0, 18), Text = "",
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
	})
	local submit = new("TextButton", {
		BackgroundColor3 = Theme.Accent, AutoButtonColor = false, Text = "Bestätigen", Font = Enum.Font.GothamBold,
		TextSize = 14, TextColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(20, 148), Size = UDim2.new(1, -40, 0, 38), Parent = panel,
	}, { corner(8) })
	submit.MouseEnter:Connect(function() tween(submit, 0.15, { BackgroundColor3 = Color3.fromRGB(0, 196, 175) }) end)
	submit.MouseLeave:Connect(function() tween(submit, 0.15, { BackgroundColor3 = Theme.Accent }) end)

	if ks.GetKeyLink then
		local get = new("TextButton", {
			BackgroundColor3 = Theme.Off, AutoButtonColor = false, Text = "Key holen (Link kopieren)", Font = Enum.Font.GothamMedium,
			TextSize = 13, TextColor3 = Theme.Text, Position = UDim2.fromOffset(20, 194), Size = UDim2.new(1, -40, 0, 34), Parent = panel,
		}, { corner(8) })
		get.MouseButton1Click:Connect(function()
			if setclipboard then
				pcall(setclipboard, ks.GetKeyLink)
				status.TextColor3 = Theme.Accent
				status.Text = "Link in die Zwischenablage kopiert."
			else
				status.TextColor3 = Theme.SubText
				status.Text = ks.GetKeyLink
			end
		end)
	end

	tween(backdrop, 0.4, { BackgroundTransparency = 0.25 })
	tween(panel, 0.4, { GroupTransparency = 0 })
	tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)

	local passed, busy = false, false
	local function shake()
		local base = panel.Position
		for _, dx in ipairs({ 10, -10, 6, -6, 0 }) do
			tween(panel, 0.05, { Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset) })
			task.wait(0.05)
		end
	end
	local function check()
		if busy then return end
		busy = true
		status.TextColor3 = Theme.SubText
		status.Text = "Key wird überprüft..."
		local keys, ok = collectKeys(ks)
		local input = trim(box.Text)
		local valid = false
		for _, k in ipairs(keys) do if k == input and input ~= "" then valid = true end end
		if valid then
			status.TextColor3 = Theme.Accent
			status.Text = "Key akzeptiert!"
			passed = true
			safe(ks.OnSuccess, input)
		else
			status.TextColor3 = Theme.Error
			status.Text = (ok == false) and "Key konnte nicht geladen werden." or "Ungültiger Key."
			shake()
			busy = false
		end
	end
	submit.MouseButton1Click:Connect(check)
	box.FocusLost:Connect(function(enter) if enter then check() end end)

	repeat task.wait(0.1) until passed or self.Destroyed
	task.wait(0.4)
	tween(scale, 0.4, { Scale = 1.06 })
	tween(panel, 0.4, { GroupTransparency = 1 })
	tween(backdrop, 0.4, { BackgroundTransparency = 1 })
	task.wait(0.45)
	panel:Destroy()
	backdrop:Destroy()
end

