-- Rahmen mit umlaufendem Farbverlauf (Rotation wird im Render-Loop gesetzt)
local function spinBorder(frame, thickness)
	local st = new("UIStroke", {
		Color = Color3.fromRGB(255, 255, 255), NoTheme = true, Thickness = thickness or 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame,
	})
	local g = new("UIGradient", { Parent = st })
	local function paint()
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Stroke), ColorSequenceKeypoint.new(0.35, Theme.Stroke),
			ColorSequenceKeypoint.new(0.5, Theme.Accent),
			ColorSequenceKeypoint.new(0.65, Theme.Stroke), ColorSequenceKeypoint.new(1, Theme.Stroke),
		})
	end
	paint()
	return g, paint, st
end

-- Hoehe eines Frames automatisch an den Inhalt (UIListLayout) anpassen
local function autoHeight(frame, layout, extra, minH, animate)
	local function upd()
		local h = math.max(minH or 0, layout.AbsoluteContentSize.Y + (extra or 0))
		local sz = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, h)
		if animate and frame.Visible then tween(frame, 0.2, { Size = sz }) else frame.Size = sz end
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(upd)
	task.defer(upd)
end

