local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k == "NoTheme" then inst:SetAttribute("NoTheme", v) else inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }) end

local function stroke(color, thickness, transparency)
	return new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function padding(l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
	})
end

local function safe(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then warn("[CGui] " .. tostring(err)) end
end

local function trim(s) return (tostring(s):gsub("^%s+", ""):gsub("%s+$", "")) end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isGamepadActive()
	return UIS:GetLastInputType().Name:find("Gamepad") ~= nil
end

-- Fade ueber alle Transparenzen (statt CanvasGroup -> bleibt gestochen scharf)
local FADE_PROPS = {
	Frame = { "BackgroundTransparency" },
	TextLabel = { "BackgroundTransparency", "TextTransparency" },
	TextButton = { "BackgroundTransparency", "TextTransparency" },
	TextBox = { "BackgroundTransparency", "TextTransparency" },
	ImageLabel = { "BackgroundTransparency", "ImageTransparency" },
	ImageButton = { "BackgroundTransparency", "ImageTransparency" },
	ScrollingFrame = { "BackgroundTransparency", "ScrollBarImageTransparency" },
	UIStroke = { "Transparency" },
}

local function fadeCapture(root)
	local snap = {}
	local function add(inst)
		local props = FADE_PROPS[inst.ClassName]
		if props then
			local rec = {}
			for _, p in ipairs(props) do rec[p] = inst[p] end
			snap[inst] = rec
		end
	end
	add(root)
	for _, d in ipairs(root:GetDescendants()) do add(d) end
	return snap
end

local function fadeSet(snap, alpha)   -- sofort; alpha 1 = unsichtbar, 0 = Originalwerte
	for inst, rec in pairs(snap) do
		if inst.Parent then
			for p, v in pairs(rec) do inst[p] = v + (1 - v) * alpha end
		end
	end
end

local function fadeTween(snap, t, alpha)
	for inst, rec in pairs(snap) do
		if inst.Parent then
			local goal = {}
			for p, v in pairs(rec) do goal[p] = v + (1 - v) * alpha end
			tween(inst, t, goal, Enum.EasingStyle.Quad)
		end
	end
end

-- Gamepad: eigene Auswahl-Hervorhebung statt des Standard-Rahmens
local function selectFX(win, btn, onGain, onLost)
