-- Zeichnet ein X aus zwei Linien (keine Glyph-Abhaengigkeit)
local function drawX(parent, size, color, thickness)
	local holder = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Parent = parent,
	})
	local lines = {}
	for i, rot in ipairs({ 45, -45 }) do
		lines[i] = new("Frame", {
			BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(math.floor(size * 1.3), thickness or 2),
			Rotation = rot, Parent = holder,
		}, { corner(1) })
	end
	return holder, lines
