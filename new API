function Window:_BuildSettings()
	local win = self
	local S = self.Settings

	S:AddSection("Fenster")
	self._themeDD = S:AddDropdown({
		Name = "Theme", Description = "Farbschema der gesamten GUI", Options = CGui:GetThemeNames(),
		Default = CGui.CurrentTheme or "Teal", Flag = "CGui.Theme",
		Callback = function(n) if n and n ~= CGui.CurrentTheme then CGui:SetTheme(n) end end,
	})
	S:AddKeybind({
		Name = "Fenster-Taste", Description = "Öffnet und schließt die GUI", Default = self.ToggleKey, Flag = "CGui.ToggleKey",
		Callback = function(k) if k then win.ToggleKey = k end end,
	})
	S:AddSlider({
		Name = "UI-Größe", Description = "Skaliert das ganze Fenster", Min = 70, Max = 140, Default = 100,
		Increment = 5, Suffix = "%", Flag = "CGui.Scale", Callback = function(v) win:SetUIScale(v / 100) end,
	})
	S:AddSlider({
		Name = "Hintergrund-Transparenz", Min = 0, Max = 50, Default = 0, Increment = 5, Suffix = "%",
		Flag = "CGui.Transparency", Callback = function(v) win:SetBackgroundTransparency(v / 100) end,
	})
	S:AddToggle({
		Name = "Effekte", Description = "Animierter Rahmen um das Fenster", Default = self.Effects,
		Flag = "CGui.Effects", Callback = function(v) win.Effects = v end,
	})
	S:AddButton({ Name = "Position zurücksetzen", Description = "Zentriert das Fenster", Callback = function() win:CenterWindow() end })

	S:AddSection("Benachrichtigungen")
	S:AddDropdown({
		Name = "Art", Description = "Wo Benachrichtigungen erscheinen", Options = { "CGui", "Roblox", "Window" },
		Default = self.NotifyType, Mode = "Inline", Flag = "CGui.NotifyType", Callback = function(v) if v then win.NotifyType = v end end,
	})
	S:AddToggle({
		Name = "Stapeln", Description = "Aus = neue Benachrichtigungen überdecken die alten", Default = self.NotifyStack,
		Flag = "CGui.NotifyStack", Callback = function(v) win.NotifyStack = v end,
	})
	S:AddButton({
		Name = "Test-Benachrichtigung",
		Callback = function() win:Notify({ Title = "CGui", Content = "So sieht eine Benachrichtigung aus." }) end,
	})

	S:AddSection("Konfiguration")
	if fsOk() then
		local cfgName = "default"
		local cfgDD
		local function refresh() if cfgDD then cfgDD:Refresh(win:ListConfigs(), true) end end
		local function report(ok, okText, err)
			win:Notify({ Title = "Konfiguration", Content = ok and okText or tostring(err), Duration = 3 })
		end
		S:AddTextBox({
			Name = "Name", Description = "Name der Konfiguration", Placeholder = "default", Default = "default",
			Changed = function(t) cfgName = (t ~= "" and t) or "default" end,
		})
		cfgDD = S:AddDropdown({
			Name = "Gespeichert", Description = "Vorhandene Konfigurationen", Options = win:ListConfigs(),
			Callback = function(sel) if sel then cfgName = sel end end,
		})
		S:AddButton({ Name = "Speichern", Callback = function()
			local ok, err = win:SaveConfig(cfgName)
			report(ok, "Gespeichert: " .. cfgName, err)
			refresh()
		end })
		S:AddButton({ Name = "Laden", Callback = function()
			local ok, err = win:LoadConfig(cfgName)
			report(ok, "Geladen: " .. cfgName, err)
		end })
		S:AddButton({ Name = "Löschen", Callback = function()
			local ok, err = win:DeleteConfig(cfgName)
			report(ok, "Gelöscht: " .. cfgName, err)
			refresh()
		end })
		S:AddButton({ Name = "Als Autoload setzen", Description = "Wird beim Start automatisch geladen", Callback = function()
			local ok, err = win:SetAutoload(cfgName)
			report(ok, "Autoload: " .. cfgName, err)
		end })
	else
		S:AddLabel({ Title = "Nicht verfügbar", Text = "Dein Executor unterstützt kein writefile/readfile.", Style = "Warning" })
	end

	S:AddSection("Info")
	S:AddLabel({
		Title = "CGui " .. CGui.Version,
		Text = "Eigene Einstellungen kannst du mit Window.Settings:AddToggle(...) und den anderen Add-Funktionen hier ergänzen.",
		Style = "Info",
	})
end

function Window:SetToggleKey(key) self.ToggleKey = key end

function Window:Destroy()
	self.Destroyed = true
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	for i = #CGui._windows, 1, -1 do if CGui._windows[i] == self then table.remove(CGui._windows, i) end end
	if self.Gui then self.Gui:Destroy() end
end

-- Elemente per Flag ansprechen: Window:SetValue("flag", wert, silent)
function Window:GetElement(flag) return self.Elements[flag] end
function Window:GetValue(flag) local e = self.Elements[flag]; return e and e:Get() end
function Window:SetValue(flag, value, silent)
	local e = self.Elements[flag]
	if e and e.Set then e:Set(value, silent) end
end

