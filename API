    local hueCorner = Instance.new("UICorner")
    hueCorner.CornerRadius = UDim.new(0, 4)
    hueCorner.Parent = hueBar

    local hueCursor = Instance.new("Frame")
    hueCursor.Size = UDim2.new(1, 0, 0, 4)
    hueCursor.AnchorPoint = Vector2.new(0, 0.5)
    hueCursor.Position = UDim2.new(0, 0, 1 - h, 0)
    hueCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    hueCursor.Parent = hueBar

    local okBtn = Instance.new("TextButton")
    okBtn.Text = "OK"
    okBtn.Size = UDim2.new(0, 80, 0, 26)
    okBtn.Position = UDim2.new(0, 220, 0, 10)
    okBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 220)
    okBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    okBtn.Font = Enum.Font.SourceSansBold
    okBtn.TextSize = 14
    okBtn.Parent = container

    local okCorner = Instance.new("UICorner")
    okCorner.CornerRadius = UDim.new(0, 4)
    okCorner.Parent = okBtn

    local cancelBtn = Instance.new("TextButton")
    cancelBtn.Text = "Abbrechen"
    cancelBtn.Size = UDim2.new(0, 80, 0, 26)
    cancelBtn.Position = UDim2.new(0, 220, 0, 44)
    cancelBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    cancelBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    cancelBtn.Font = Enum.Font.SourceSansBold
    cancelBtn.TextSize = 14
    cancelBtn.Parent = container

    local cancelCorner = Instance.new("UICorner")
    cancelCorner.CornerRadius = UDim.new(0, 4)
    cancelCorner.Parent = cancelBtn

    local function updateColor()
        currentColor = Color3.fromHSV(h, s, v)
        hsvBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        previewBox.BackgroundColor3 = currentColor
    end

    local draggingHSV = false
    local draggingHue = false

    hsvBox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then 
            draggingHSV = true 
            isInteracting = true
        end
    end)
    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then 
            draggingHue = true 
            isInteracting = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingHSV = false
            draggingHue = false
            isInteracting = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            if draggingHSV then
                local posX = math.clamp((input.Position.X - hsvBox.AbsolutePosition.X) / hsvBox.AbsoluteSize.X, 0, 1)
                local posY = math.clamp((input.Position.Y - hsvBox.AbsolutePosition.Y) / hsvBox.AbsoluteSize.Y, 0, 1)
                s = posX
                v = 1 - posY
                hsvCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                updateColor()
            elseif draggingHue then
                local posY = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
                h = 1 - posY
                hueCursor.Position = UDim2.new(0, 0, 1 - h, 0)
                updateColor()
            end
        end
    end)

    local function toggleExpand(state)
        expanded = state
        local targetHeight = expanded and 170 or 38
        TweenService:Create(pickerFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, -10, 0, targetHeight)}):Play()
    end

    headerBtn.MouseButton1Click:Connect(function()
        toggleExpand(not expanded)
    end)

    okBtn.MouseButton1Click:Connect(function()
        confirmedColor = currentColor
        toggleExpand(false)
        if callback then pcall(callback, confirmedColor) end
    end)

    cancelBtn.MouseButton1Click:Connect(function()
        currentColor = confirmedColor
        h, s, v = confirmedColor:ToHSV()
        hsvCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(0, 0, 1 - h, 0)
        updateColor()
        toggleExpand(false)
    end)
end

