function Library:Notify(options)
    options = options or {}
    local title = options.Title or "Notification"
    local text = options.Text or ""
    local duration = options.Duration or 3
    local mode = options.Mode or "Screen"

    if mode == "Roblox" then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = title,
                Text = text,
                Duration = duration
            })
        end)

    elseif mode == "Screen" then
        local notifBox = Instance.new("Frame")
        notifBox.Size = UDim2.new(1, 0, 0, 0)
        notifBox.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
        notifBox.ClipsDescendants = true
        notifBox.Parent = NotifyStackFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = notifBox

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5
        stroke.Color = Color3.fromRGB(0, 187, 255)
        stroke.Parent = notifBox

        local tLabel = Instance.new("TextLabel")
        tLabel.Text = title
        tLabel.Size = UDim2.new(1, -16, 0, 20)
        tLabel.Position = UDim2.new(0, 10, 0, 6)
        tLabel.TextColor3 = Color3.fromRGB(0, 187, 255)
        tLabel.Font = Enum.Font.SourceSansBold
        tLabel.TextSize = 15
        tLabel.TextXAlignment = Enum.TextXAlignment.Left
        tLabel.BackgroundTransparency = 1
        tLabel.Parent = notifBox

        local descLabel = Instance.new("TextLabel")
        descLabel.Text = text
        descLabel.Size = UDim2.new(1, -16, 0, 18)
        descLabel.Position = UDim2.new(0, 10, 0, 26)
        descLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        descLabel.Font = Enum.Font.SourceSans
        descLabel.TextSize = 13
        descLabel.TextXAlignment = Enum.TextXAlignment.Left
        descLabel.BackgroundTransparency = 1
        descLabel.Parent = notifBox

        TweenService:Create(notifBox, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 52)}):Play()

        task.delay(duration, function()
            local tw = TweenService:Create(notifBox, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 0)})
            tw:Play()
            tw.Completed:Connect(function()
                notifBox:Destroy()
            end)
        end)

    elseif mode == "Window" and self.WindowFrame then
        local banner = Instance.new("Frame")
        banner.Size = UDim2.new(1, -20, 0, 32)
        banner.Position = UDim2.new(0, 10, 0, -40)
        banner.BackgroundColor3 = Color3.fromRGB(0, 187, 255)
        banner.Parent = self.WindowFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = banner

        local bLabel = Instance.new("TextLabel")
        bLabel.Text = title .. ": " .. text
        bLabel.Size = UDim2.new(1, -20, 1, 0)
        bLabel.Position = UDim2.new(0, 10, 0, 0)
        bLabel.TextColor3 = Color3.fromRGB(15, 15, 15)
        bLabel.Font = Enum.Font.SourceSansBold
        bLabel.TextSize = 14
        bLabel.TextXAlignment = Enum.TextXAlignment.Left
        bLabel.BackgroundTransparency = 1
        bLabel.Parent = banner

        TweenService:Create(banner, TweenInfo.new(0.3), {Position = UDim2.new(0, 10, 0, 8)}):Play()

        task.delay(duration, function()
            local tw = TweenService:Create(banner, TweenInfo.new(0.3), {Position = UDim2.new(0, 10, 0, -40)})
            tw:Play()
            tw.Completed:Connect(function()
                banner:Destroy()
            end)
        end)
    end
end

