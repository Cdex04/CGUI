    container.BackgroundTransparency = 1
    container.Parent = pickerFrame

    local h, s, v = defaultColor:ToHSV()

    local hsvBox = Instance.new("ImageLabel")
    hsvBox.Size = UDim2.new(0, 180, 0, 80)
    hsvBox.Position = UDim2.new(0, 0, 0, 0)
    hsvBox.Image = "rbxassetid://4155801252"
    hsvBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    hsvBox.Parent = container

    local hsvCorner = Instance.new("UICorner")
    hsvCorner.CornerRadius = UDim.new(0, 4)
