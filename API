    local default = options.Default or list[1] or "Keine Optionen"

    local expanded = false
    local selected = default

    local dropFrame = Instance.new("Frame")
    dropFrame.Size = UDim2.new(1, -10, 0, 38)
    dropFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    dropFrame.BackgroundTransparency = 0.2
