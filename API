function TabClass:AddToggle(options, callback)
    options = options or {}
    local titleText = options.Title or "Toggle"
    local descriptionText = options.Description or ""
    local defaultState = options.Default or false

    local hasDesc = descriptionText ~= ""
    local frameHeight = hasDesc and 50 or 38

    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, -10, 0, frameHeight)
    toggleFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    toggleFrame.BackgroundTransparency = 0.2
    toggleFrame.Parent = self.Page

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = toggleFrame

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(45, 45, 45)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = toggleFrame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Text = titleText
    titleLabel.Size = UDim2.new(1, -70, 0, hasDesc and 20 or frameHeight)
    titleLabel.Position = UDim2.new(0, 12, 0, hasDesc and 4 or 0)
    titleLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.SourceSansBold
    titleLabel.TextSize = 16
    titleLabel.BackgroundTransparency = 1
    titleLabel.Parent = toggleFrame

    if hasDesc then
        local descLabel = Instance.new("TextLabel")
        descLabel.Text = descriptionText
        descLabel.Size = UDim2.new(1, -70, 0, 18)
        descLabel.Position = UDim2.new(0, 12, 0, 24)
        descLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
        descLabel.TextXAlignment = Enum.TextXAlignment.Left
        descLabel.Font = Enum.Font.SourceSans
        descLabel.TextSize = 13
        descLabel.BackgroundTransparency = 1
        descLabel.Parent = toggleFrame
    end

    local toggleBox = Instance.new("TextButton")
    toggleBox.Text = ""
    toggleBox.AutoButtonColor = false
    toggleBox.Size = UDim2.new(0, 42, 0, 22)
    toggleBox.Position = UDim2.new(1, -54, 0.5, -11)
    toggleBox.BackgroundColor3 = defaultState and Color3.fromRGB(0, 187, 255) or Color3.fromRGB(40, 40, 40)
    toggleBox.Parent = toggleFrame

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(1, 0)
    boxCorner.Parent = toggleBox

    local toggleKnob = Instance.new("Frame")
    toggleKnob.Size = UDim2.new(0, 16, 0, 16)
    toggleKnob.Position = defaultState and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    toggleKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleKnob.Parent = toggleBox

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = toggleKnob

    toggleFrame.MouseEnter:Connect(function()
        TweenService:Create(toggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 187, 255)}):Play()
        TweenService:Create(titleLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end)

    toggleFrame.MouseLeave:Connect(function()
        TweenService:Create(toggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 25)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 45, 45)}):Play()
        TweenService:Create(titleLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(230, 230, 230)}):Play()
    end)

    local state = defaultState

    local function toggle()
        state = not state
        
        local targetColor = state and Color3.fromRGB(0, 187, 255) or Color3.fromRGB(40, 40, 40)
        local targetPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)

        TweenService:Create(toggleBox, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(toggleKnob, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()

        if callback then
            pcall(callback, state)
        end
    end

    toggleBox.MouseButton1Click:Connect(toggle)
    
    local invisibleBtn = Instance.new("TextButton")
    invisibleBtn.Size = UDim2.new(1, -50, 1, 0)
    invisibleBtn.BackgroundTransparency = 1
    invisibleBtn.Text = ""
    invisibleBtn.Parent = toggleFrame
    invisibleBtn.MouseButton1Click:Connect(toggle)
end

return Library
