-- 3. TABS
-- ===================================================
function Library:CreateTab(tabName)
    local tabObj = setmetatable({}, TabClass)
    
    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.Position = UDim2.new(1, 20, 0, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 2
    Page.Parent = self.ContentContainer

    local PageLayout = Instance.new("UIListLayout")
    PageLayout.Padding = UDim.new(0, 8)
    PageLayout.Parent = Page

    local TabButton = Instance.new("TextButton")
    TabButton.Text = tabName
    TabButton.Size = UDim2.new(1, -5, 0, 35)
    TabButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    TabButton.BackgroundTransparency = 0.3
    TabButton.TextColor3 = Color3.fromRGB(150, 150, 150)
    TabButton.Font = Enum.Font.SourceSansBold
    TabButton.TextSize = 16
    TabButton.Parent = self.TabBar

    local ButtonST = Instance.new("UIStroke")
    ButtonST.Thickness = 1.5
    ButtonST.Color = Color3.fromRGB(45, 45, 45)
    ButtonST.Parent = TabButton

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 6)
    ButtonCorner.Parent = TabButton

    local function select()
        if self.ActiveTab == tabName then return end

        if self.ActiveTab and self.Tabs[self.ActiveTab] then
            local oldTab = self.Tabs[self.ActiveTab]
            TweenService:Create(oldTab.Button, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
            TweenService:Create(oldTab.Button.UIStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(45, 45, 45)}):Play()
            oldTab.Page:TweenPosition(UDim2.new(-1, -20, 0, 0), "Out", "Quad", 0.3, true)
        end

        self.ActiveTab = tabName
        TweenService:Create(TabButton, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(0, 187, 255)}):Play()
        TweenService:Create(ButtonST, TweenInfo.new(0.3), {Color = Color3.fromRGB(0, 187, 255)}):Play()

        Page.Position = UDim2.new(1, 20, 0, 0)
        Page:TweenPosition(UDim2.new(0, 0, 0, 0), "Out", "Quad", 0.4, true)
    end

    TabButton.MouseButton1Click:Connect(select)

    self.Tabs[tabName] = {Page = Page, Button = TabButton}

    if #self.TabBar:GetChildren() == 2 then
        task.spawn(select)
    end

    tabObj.Page = Page
    return tabObj
end

