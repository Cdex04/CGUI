-- 4. EXTRA SETTINGS WINDOW FOR MODULES
-- =================================================================
function WaterClient:OpenModuleSettings(modData)
    ModulesHolder.Parent = nil
    HUDFrame.Visible = false
    SettingsFrame.Visible = false

    -- Clear old settings UI elements
    for _, child in pairs(ModSettingsFrame:GetChildren()) do
        if not child:IsA("UICorner") and not child:IsA("UIStroke") and child.Text ~= "X" then
            child:Destroy()
        end
    end

    ModSettingsFrame.Visible = true

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -40, 0, 30)
    Title.Position = UDim2.new(0, 12, 0, 5)
    Title.Text = modData.Name .. " Settings"
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14
    Title.TextColor3 = WaterClient.AccentColor
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1
    Title.Parent = ModSettingsFrame

    local ContentContainer = Instance.new("Frame")
    ContentContainer.Size = UDim2.new(1, -20, 1, -45)
    ContentContainer.Position = UDim2.new(0, 10, 0, 38)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = ModSettingsFrame

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 8)
    Layout.Parent = ContentContainer

    -- Keybind Selector
    local KeyBtn = Instance.new("TextButton")
    KeyBtn.Size = UDim2.new(1, 0, 0, 34)
    KeyBtn.Text = "Keybind: " .. (modData.Keybind and modData.Keybind.Name or "None")
    KeyBtn.Font = Enum.Font.Gotham
    KeyBtn.TextSize = 12
    KeyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    KeyBtn.BackgroundColor3 = WaterClient.CardColor
    KeyBtn.Parent = ContentContainer
    AddCorner(KeyBtn, 6)

    KeyBtn.MouseButton1Click:Connect(function()
        KeyBtn.Text = "Press Key..."
        local conn; conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                modData.Keybind = input.KeyCode
                KeyBtn.Text = "Keybind: " .. input.KeyCode.Name
                conn:Disconnect()
            end
        end)
    end)

    -- Dropdown Mode Button (Toggle vs Hold)
    local ModeBtn = Instance.new("TextButton")
    ModeBtn.Size = UDim2.new(1, 0, 0, 34)
    ModeBtn.Text = "Trigger Mode: " .. modData.Mode
    ModeBtn.Font = Enum.Font.Gotham
    ModeBtn.TextSize = 12
    ModeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ModeBtn.BackgroundColor3 = WaterClient.CardColor
    ModeBtn.Parent = ContentContainer
    AddCorner(ModeBtn, 6)

    ModeBtn.MouseButton1Click:Connect(function()
        modData.Mode = (modData.Mode == "Toggle") and "Hold" or "Toggle"
        ModeBtn.Text = "Trigger Mode: " .. modData.Mode
    end)
end

