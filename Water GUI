local frameCount, lastFpsUpdate = 0, os.clock()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    if os.clock() - lastFpsUpdate >= 1 then
        -- Zeige FPS/Ping nur an, wenn GUI geschlossen ist!
        if WaterClient.HUD.ShowFPS and not WaterClient.Open then
            local fps = frameCount
            local ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            local pCount = #Players:GetPlayers()
            StatsLabel.Text = string.format("Water Client | FPS: %d | Ping: %dms | Players: %d", fps, ping, pCount)
            StatsLabel.Visible = true
        else
            StatsLabel.Visible = false
        end
        frameCount = 0
        lastFpsUpdate = os.clock()
    end
end)

