-- 3. RIGHT-CLICK MODULE SETTINGS MENU (Keybind & Dropdown + Options)
-- =================================================================
function WaterClient:OpenModuleSettings(modData, parentBtn)
    if ScreenGui:FindFirstChild("ModuleSettingsMenu") then
        ScreenGui.ModuleSettingsMenu:Destroy()
    end

    local Menu = Instance.new("Frame")
    Menu.Name = "ModuleSettingsMenu"
    Menu.Size = UDim2.new(0, 170, 0, 75)
    Menu.Position = UDim2.new(0, parentBtn.AbsolutePosition.X + 180, 0, parentBtn.AbsolutePosition.Y)
    Menu.BackgroundColor3 = WaterClient.SecondaryColor
    Menu.Parent = ScreenGui
    AddCorner(Menu, 6)
    AddStroke(Menu, WaterClient.AccentColor, 1)

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 4)
    Layout.Parent = Menu

    -- Keybind Selector Button
    local KeyBtn = Instance.new("TextButton")
    KeyBtn.Size = UDim2.new(1, -8, 0, 32)
    KeyBtn.Position = UDim2.new(0, 4, 0, 4)
    KeyBtn.Text = "Keybind: " .. (modData.Keybind and modData.Keybind.Name or "None")
    KeyBtn.Font = Enum.Font.Gotham
    KeyBtn.TextSize = 12
    KeyBtn.TextColor3 = Color3.fromRGB(220, 240, 255)
    KeyBtn.BackgroundColor3 = WaterClient.CardColor
    KeyBtn.Parent = Menu
    AddCorner(KeyBtn, 4)

    KeyBtn.MouseButton1Click:Connect(function()
        KeyBtn.Text = "Press Key..."
        local conn; conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                modData.Keybind = input.KeyCode
                KeyBtn.Text = "Keybind: " .. input.KeyCode.Name
                conn:Disconnect()
            end
        end)
    end)

    -- Dropdown Mode Button (Toggle vs Hold)
    local ModeBtn = Instance.new("TextButton")
    ModeBtn.Size = UDim2.new(1, -8, 0, 32)
    ModeBtn.Text = "Mode: " .. modData.Mode
    ModeBtn.Font = Enum.Font.Gotham
    ModeBtn.TextSize = 12
    ModeBtn.TextColor3 = Color3.fromRGB(220, 240, 255)
    ModeBtn.BackgroundColor3 = WaterClient.CardColor
    ModeBtn.Parent = Menu
    AddCorner(ModeBtn, 4)

    ModeBtn.MouseButton1Click:Connect(function()
        modData.Mode = (modData.Mode == "Toggle") and "Hold" or "Toggle"
        ModeBtn.Text = "Mode: " .. modData.Mode
    end)
end

