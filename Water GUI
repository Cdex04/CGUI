-- 3. MODULE TABS SYSTEM
-- =================================================================
function WaterClient:CreateTab(name)
    local tabCount = #WaterClient.Tabs
    local tabWidth = 175
    local tabSpacing = 15
    local xOffset = 30 + (tabCount * (tabWidth + tabSpacing))

    local TabFrame = Instance.new("Frame")
    TabFrame.Name = name .. "Tab"
    TabFrame.Size = UDim2.new(0, tabWidth, 0, 36)
    TabFrame.Position = UDim2.new(0, xOffset, 0, 80)
    TabFrame.BackgroundColor3 = WaterClient.SecondaryColor
    TabFrame.BackgroundTransparency = 0.1
    TabFrame.Active = true
    TabFrame.Draggable = true
    TabFrame.Parent = ModulesHolder
    AddCorner(TabFrame, 8)
    AddStroke(TabFrame, Color3.fromRGB(35, 60, 90), 1)

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -10, 1, 0)
    Title.Position = UDim2.new(0, 10, 0, 0)
    Title.Text = name
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14
    Title.TextColor3 = Color3.fromRGB(240, 245, 255)
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1
    Title.Parent = TabFrame

    local Container = Instance.new("Frame")
    Container.Name = "Container"
    Container.Size = UDim2.new(1, 0, 0, 0)
    Container.Position = UDim2.new(0, 0, 1, 4)
    Container.BackgroundColor3 = WaterClient.SecondaryColor
    Container.BackgroundTransparency = 0.2
    Container.Parent = TabFrame
    AddCorner(Container, 8)

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Padding = UDim.new(0, 2)
    UIListLayout.Parent = Container

    local tabData = {Frame = TabFrame, Container = Container, Modules = {}}
    table.insert(WaterClient.Tabs, tabData)

    function tabData:CreateModule(modName, callback)
        local modData = {
            Name = modName,
            Enabled = false,
            Mode = "Toggle",
            Keybind = nil,
            Callback = callback or function() end
        }

        local ModButton = Instance.new("TextButton")
        ModButton.Size = UDim2.new(1, 0, 0, 30)
        ModButton.Text = "  " .. modName
        ModButton.Font = Enum.Font.GothamMedium
        ModButton.TextSize = 13
        ModButton.TextColor3 = Color3.fromRGB(160, 180, 200)
        ModButton.TextXAlignment = Enum.TextXAlignment.Left
        ModButton.BackgroundColor3 = WaterClient.CardColor
        ModButton.BackgroundTransparency = 0.5
        ModButton.Parent = Container
        AddCorner(ModButton, 4)

        UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Container.Size = UDim2.new(1, 0, 0, UIListLayout.AbsoluteContentSize.Y)
        end)

        local function ToggleModule()
            modData.Enabled = not modData.Enabled
            
            TweenService:Create(ModButton, TweenInfo.new(0.2), {
                TextColor3 = modData.Enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 180, 200),
                BackgroundColor3 = modData.Enabled and WaterClient.AccentColor or WaterClient.CardColor,
                BackgroundTransparency = modData.Enabled and 0.2 or 0.5
            }):Play()

            modData.Callback(modData.Enabled)
            WaterClient:UpdateActiveHUD()
        end

        ModButton.MouseButton1Click:Connect(function()
            if modData.Mode == "Toggle" then ToggleModule() end
        end)

        -- Rechtsklick schließt alles andere und öffnet Settings-Fenster
        ModButton.MouseButton2Click:Connect(function()
            WaterClient:OpenModuleSettings(modData)
        end)

        -- Keybind Support
        UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and modData.Keybind and input.KeyCode == modData.Keybind then
                if modData.Mode == "Toggle" then
                    ToggleModule()
                elseif modData.Mode == "Hold" then
                    modData.Enabled = true
                    ModButton.BackgroundColor3 = WaterClient.AccentColor
                    modData.Callback(true)
                    WaterClient:UpdateActiveHUD()
                end
            end
        end)

        UserInputService.InputEnded:Connect(function(input, gpe)
            if modData.Mode == "Hold" and modData.Keybind and input.KeyCode == modData.Keybind then
                modData.Enabled = false
                ModButton.BackgroundColor3 = WaterClient.CardColor
                modData.Callback(false)
                WaterClient:UpdateActiveHUD()
            end
        end)

        table.insert(WaterClient.Modules, modData)
        return modData
    end

    return tabData
end

