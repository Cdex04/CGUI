RunService.RenderStepped:Connect(function()
    -- Radar wird nur angezeigt, wenn GUI Geschlossen ist!
    local shouldShowRadar = WaterClient.HUD.ShowRadar and not WaterClient.Open
    RadarFrame.Visible = shouldShowRadar
    
    if not shouldShowRadar then return end

    for _, child in pairs(RadarFrame:GetChildren()) do
        if child.Name == "PlayerDot" then child:Destroy() end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local enemyPos = p.Character.HumanoidRootPart.Position
                local relPos = enemyPos - myPos
                
                local mapX = math.clamp(relPos.X / 150 * 50, -50, 50)
                local mapZ = math.clamp(relPos.Z / 150 * 50, -50, 50)

                local dot = Instance.new("Frame")
                dot.Name = "PlayerDot"
                dot.Size = UDim2.new(0, 4, 0, 4)
                dot.Position = UDim2.new(0.5, mapX - 2, 0.5, mapZ - 2)
                dot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                dot.Parent = RadarFrame
                AddCorner(dot, 2)
            end
        end
    end
end)

