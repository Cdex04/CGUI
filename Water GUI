local frameCount, lastFpsUpdate = 0, os.clock()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    if os.clock() - lastFpsUpdate >= 1 then
        if WaterClient.HUD.ShowFPS then
            local fps = frameCount
            local ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            local pCount = #Players:GetPlayers()
            StatsLabel.Text = string.format("Water Client | FPS: %d | Ping: %dms | Players: %d", fps, ping, pCount)
            StatsLabel.Visible = true
        else
            StatsLabel.Visible = false
        end
        frameCount = 0
        lastFpsUpdate = os.clock()
    end
end)

-- 2D Radar Implementation
local RadarFrame = Instance.new("Frame")
RadarFrame.Size = UDim2.new(0, 120, 0, 120)
RadarFrame.Position = UDim2.new(1, -135, 1, -135)
RadarFrame.BackgroundColor3 = WaterClient.SecondaryColor
RadarFrame.BackgroundTransparency = 0.3
RadarFrame.Parent = ScreenGui
AddCorner(RadarFrame, 60)
AddStroke(RadarFrame, WaterClient.AccentColor, 1.5)

local CenterDot = Instance.new("Frame")
CenterDot.Size = UDim2.new(0, 4, 0, 4)
CenterDot.Position = UDim2.new(0.5, -2, 0.5, -2)
CenterDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
CenterDot.Parent = RadarFrame
AddCorner(CenterDot, 2)

RunService.RenderStepped:Connect(function()
    RadarFrame.Visible = WaterClient.HUD.ShowRadar
    if not WaterClient.HUD.ShowRadar then return end

    -- Clean old player dots
    for _, child in pairs(RadarFrame:GetChildren()) do
        if child.Name == "PlayerDot" then child:Destroy() end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local enemyPos = p.Character.HumanoidRootPart.Position
                local relPos = enemyPos - myPos
                
                -- Map world offset to 2D Radar (Range ~150 studs)
                local mapX = math.clamp(relPos.X / 150 * 50, -50, 50)
                local mapZ = math.clamp(relPos.Z / 150 * 50, -50, 50)

                local dot = Instance.new("Frame")
                dot.Name = "PlayerDot"
                dot.Size = UDim2.new(0, 4, 0, 4)
                dot.Position = UDim2.new(0.5, mapX - 2, 0.5, mapZ - 2)
                dot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                dot.Parent = RadarFrame
                AddCorner(dot, 2)
            end
        end
    end
end)

