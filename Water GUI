function WaterClient:UpdateActiveHUD()
    for _, child in pairs(ActiveListFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end

    if not WaterClient.HUD.ShowActiveMods then return end

    for _, mod in pairs(WaterClient.Modules) do
        if mod.Enabled then
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 18)
            lbl.Text = mod.Name .. "  "
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 13
            lbl.TextColor3 = WaterClient.AccentColor
            lbl.TextXAlignment = Enum.TextXAlignment.Right
            lbl.BackgroundTransparency = 1
            lbl.Parent = ActiveListFrame
        end
    end
end

