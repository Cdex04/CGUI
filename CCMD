-- Commands: Registry, Ausfuehrung, Settings pro Command
---------------------------------------------------------------------------------------------------
local Commands, CommandList = {}, {}
local History = Data.history

local DEF_ST = {keybind = "", mode = "Tap", args = {}, autostart = false, notify = true, hidden = false, fav = false, custom = {}}
local function csr(cmd) return Data.commands[cmd.Name] or DEF_ST end          -- nur lesen
local function cs(cmd)                                                         -- lesen + anlegen
	local t = Data.commands[cmd.Name]
	if not t then
		t = {keybind = "", mode = "Tap", args = {}, autostart = false, notify = true, hidden = false, fav = false, custom = {}}
		Data.commands[cmd.Name] = t
	end
	t.args = t.args or {}; t.custom = t.custom or {}
	return t
end
local function effArg(cmd, i)
	local v = csr(cmd).args and csr(cmd).args[tostring(i)]
	if v ~= nil then return v end
	return cmd.Args[i].Default
end
local function findPlayer(q)
	q = tostring(q):lower()
	if q == "me" then return LP end
	local list = Players:GetPlayers()
	if q == "random" then return list[math.random(#list)] end
	for _, p in ipairs(list) do if p.Name:lower() == q or p.DisplayName:lower() == q then return p end end
	for _, p in ipairs(list) do if p.Name:lower():sub(1, #q) == q or p.DisplayName:lower():sub(1, #q) == q then return p end end
	for _, p in ipairs(list) do if p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true) then return p end end
end
local function coerce(def, tok)
	local t = def.Type or "string"
	if t == "number" or t == "integer" then
		local n = tonumber(tok)
		if not n then return nil, "Zahl erwartet für '" .. def.Name .. "'" end
		if t == "integer" then n = math.floor(n + 0.5) end
		if def.Min then n = math.max(def.Min, n) end
		if def.Max then n = math.min(def.Max, n) end
		return n
	elseif t == "boolean" then
		local l = tok:lower()
		if l == "true" or l == "on" or l == "1" or l == "yes" or l == "an" or l == "ja" then return true end
		if l == "false" or l == "off" or l == "0" or l == "no" or l == "aus" or l == "nein" then return false end
		return nil, "true/false erwartet für '" .. def.Name .. "'"
	elseif t == "player" then
		local p = findPlayer(tok)
		if not p then return nil, "Spieler nicht gefunden: " .. tok end
		return p
	end
	return tok
end
local function typeLabel(def)
	local t = def.Type or "string"
	if t == "boolean" then return "true|false" end
	return t
end

-- eigene Command-Settings (Settings = {...} im Command)
local function convertSetting(def, v)
	if def.Type == "color" then
		local ok, c = pcall(Color3.fromHex, tostring(v))
		return ok and c or Color3.new(1, 1, 1)
	end
	return v
end
local function settingValue(cmd, def)
	local st = csr(cmd)
	local v = st.custom and st.custom[def.Key]
	if v == nil then v = def.Default end
	return v
end
local function buildCfg(cmd)
	local cfg = {}
	for _, def in ipairs(cmd.Settings or {}) do
		if def.Key then cfg[def.Key] = convertSetting(def, settingValue(cmd, def)) end
	end
	return cfg
end
function Lib:GetSetting(name, key)
	local cmd = Commands[tostring(name):lower()]
	if not cmd then return nil end
	for _, def in ipairs(cmd.Settings or {}) do
		if def.Key == key then return convertSetting(def, settingValue(cmd, def)) end
	end
end

function Lib:AddCommand(def)
	assert(type(def) == "table" and def.Name and def.Callback, "AddCommand: Name und Callback nötig")
	local cmd = {Name = def.Name:lower(), Aliases = def.Aliases or {}, Description = def.Description or "", Category = def.Category or "General",
		Toggle = def.Toggle == true, Args = def.Args or {}, Settings = def.Settings or {}, Callback = def.Callback, On = false}
	cmd.names = {cmd.Name}
	for _, a in ipairs(cmd.Aliases) do cmd.names[#cmd.names + 1] = a:lower() end
	for _, n in ipairs(cmd.names) do Commands[n] = cmd end
	CommandList[#CommandList + 1] = cmd
	table.sort(CommandList, function(a, b) if a.Category ~= b.Category then return a.Category < b.Category end return a.Name < b.Name end)
	if Lib.OnCommandAdded then Lib.OnCommandAdded(cmd) end
	return cmd
end

local function addHistory(text)
	for i = #History, 1, -1 do if History[i] == text then table.remove(History, i) end end
	table.insert(History, 1, text)
	while #History > 30 do table.remove(History) end
	save()
end

function Lib:RunCommand(cmd, args, force, silent)
	local final = {}
	local needArgs = not (cmd.Toggle and force == false)
	for i, def in ipairs(cmd.Args) do
		local v = args and args[i]
		if v == nil then v = effArg(cmd, i) end
		if v == nil and needArgs and (def.Type or "string") ~= "boolean" and not def.Optional then
			notify(cmd.Name, "Argument fehlt: <" .. def.Name .. ": " .. typeLabel(def) .. ">", "error")
			return false
		end
		final[i] = v; final[def.Name] = v
	end
	local cfg = buildCfg(cmd)
	local ok, err
	if cmd.Toggle then
		local new = force
		if new == nil then new = not cmd.On end
		local prev = cmd.On
		cmd.On = new
		ok, err = pcall(cmd.Callback, final, new, cfg)
		if not ok then cmd.On = prev end
	else
		ok, err = pcall(cmd.Callback, final, nil, cfg)
	end
	refreshRow(cmd, false)
	if applyCmdFilter then applyCmdFilter() end
	if not ok then
		notify(cmd.Name, "Fehler: " .. tostring(err), "error")
		warn("[NeonCmd] " .. cmd.Name .. ": " .. tostring(err))
		return false
	end
	if not silent and S.notifyCommands and csr(cmd).notify then
		notify(cmd.Name, cmd.Toggle and (cmd.On and "aktiviert" or "deaktiviert") or "ausgeführt")
	end
	return true
end

function Lib:Execute(text, opts)
	opts = opts or {}
	text = trim(text or "")
	if text == "" then return false end
	local tokens = {}
	for w in text:gmatch("%S+") do tokens[#tokens + 1] = w end
	local cmd = Commands[tokens[1]:lower()]
	if not cmd then
		local found
		for name in pairs(Commands) do if name:find(tokens[1]:lower(), 1, true) then found = name break end end
		notify("Unbekannter Command", "'" .. tokens[1] .. "' existiert nicht" .. (found and ("\nMeintest du: " .. found .. "?") or ""), "error")
		return false
	end
	local args = {}
	for i, def in ipairs(cmd.Args) do
		local tok
		if (def.Type or "string") == "string" and i == #cmd.Args then
			if tokens[i + 1] then tok = table.concat(tokens, " ", i + 1) end
		else tok = tokens[i + 1] end
		if tok then
			local v, err = coerce(def, tok)
			if v == nil then notify("Ungültiges Argument", err, "error") return false end
			args[i] = v
		end
	end
	local force
	if cmd.Toggle then force = not (cmd.On and #tokens == 1) end
	if not opts.noHistory then addHistory(text) end
	return Lib:RunCommand(cmd, args, force, opts.silent)
end

function Lib:Panic()
	for _, cmd in ipairs(CommandList) do
		if cmd.Toggle and cmd.On then Lib:RunCommand(cmd, nil, false, true) end
	end
	notify("Panic", "Alle Toggle-Commands wurden ausgeschaltet")
end

local function searchCommands(q)
	q = q:lower()
	local res = {}
	for _, cmd in ipairs(CommandList) do
		if not csr(cmd).hidden then
			local best, bestName
			for _, n in ipairs(cmd.names) do
				local s = n:find(q, 1, true)
				if s and (s == 1 or S.substring) then
					local score = (n == q) and 0 or ((s == 1 and 1 or 2) + s * 0.001 + #n * 0.0001)
					if not best or score < best then best, bestName = score, n end
				end
			end
			if best then res[#res + 1] = {cmd = cmd, name = bestName, score = best} end
		end
	end
	table.sort(res, function(a, b) if a.score ~= b.score then return a.score < b.score end return a.name < b.name end)
	return res
end

-- Profile anwenden: Settings + ALLE Command-Settings; unbekannte Commands werden gemeldet und uebersprungen
local function applyProfile(p)
	local missing = {}
	local src = p.settings
	if not src then
		src = {}
		for _, k in ipairs({"theme", "bgAnim", "animSpeed", "windowTransparency", "uiScale", "corner", "blur", "customTheme"}) do src[k] = p[k] end
	end
	for k, v in pairs(src) do
		if v ~= nil and not PROFILE_SKIP[k] then S[k] = deepcopy(v) end
	end
	if type(p.commands) == "table" then
		Data.commands = deepcopy(p.commands)
		for name in pairs(p.commands) do
			local c = Commands[name]
			if not (c and c.Name == name) then missing[#missing + 1] = name end
		end
		table.sort(missing)
	end
	return missing
end
local function reportMissing(profileName, missing)
	if #missing == 0 then return end
	warn("[NeonCmd] Profil '" .. profileName .. "': Commands nicht gefunden (übersprungen): " .. table.concat(missing, ", "))
	notify("Profil '" .. profileName .. "'", #missing .. " Command(s) nicht gefunden – übersprungen:\n" .. table.concat(missing, ", "), "error")
end
function Lib:LoadProfile(name, quiet)
	local p = Data.profiles[name]
	if not p then notify("Profil", "'" .. tostring(name) .. "' existiert nicht", "error") return false end
	local missing = applyProfile(p)
	ActiveProfile = name
	for cmd in pairs(Lib._rows or {}) do refreshRow(cmd, true) end
	if closeCommandSettings then closeCommandSettings() end
	applyAppearance(false)
	if renderSettings then renderSettings() end
	if applyCmdFilter then applyCmdFilter() end
	if not quiet then notify("Profil", "'" .. name .. "' geladen") end
	reportMissing(name, missing)
	return true
end

