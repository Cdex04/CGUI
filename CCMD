-- Hintergrund-Animationen (Partikel, Regen, Gradient, Scanline, Pulse Glow)
---------------------------------------------------------------------------------------------------
local BGLayer, ParticleHolder, GradFrame, Grad, ScanBand, PulseFrame, PulseStroke
local Particles, Tm = {}, 0
local NSK = NumberSequenceKeypoint.new

local function buildBg()
	BGLayer = New("Frame", {Name = "BG", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, ClipsDescendants = true, Parent = Win})
	-- Gradient Flow
	GradFrame = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Visible = false, Parent = BGLayer})
	Grad = New("UIGradient", {Transparency = NumberSequence.new({NSK(0, 0.72), NSK(1, 1)}), Parent = GradFrame})
	hook(GradFrame, function() Grad.Color = ColorSequence.new(Current.accent, Current.bg) end)
	-- Scanline: breites weiches Band mit heller Vorderkante
	ScanBand = New("Frame", {Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = Color3.new(1, 1, 1), Visible = false, Parent = BGLayer})
	local sg = New("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({NSK(0, 1), NSK(0.65, 0.9), NSK(0.97, 0.55), NSK(1, 1)}), Parent = ScanBand})
	local edge = New("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2), BackgroundTransparency = 0.25, Parent = ScanBand})
	hook(ScanBand, function() sg.Color = ColorSequence.new(Current.accent); edge.BackgroundColor3 = Current.text end)
	-- Pulse Glow: pulsierender Rand innen im Fenster
	PulseFrame = New("Frame", {Position = UDim2.fromOffset(7, 7), Size = UDim2.new(1, -14, 1, -14), BackgroundTransparency = 1, Visible = false, Parent = BGLayer})
	corner(PulseFrame, 1.2)
	PulseStroke = New("UIStroke", {Thickness = 4, Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = PulseFrame})
	themed(PulseStroke, {Color = "accent"})
	-- Partikel / Regen
	ParticleHolder = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = BGLayer})
	for i = 1, 40 do
		local f = New("Frame", {BackgroundTransparency = 0.55, Parent = ParticleHolder})
		round_(f)
		Particles[i] = {f = f, x = math.random(), y = math.random(), v = 0.02 + math.random() * 0.05, w = 1 + math.random() * 2, ph = math.random() * 6, s = math.random(2, 5)}
		hook(f, function() f.BackgroundColor3 = Current.accent end)
	end
end
function setBgMode(mode)
	if not BGLayer then return end
	local pm = (mode == "Particles" or mode == "Rain") and not S.perfMode
	ParticleHolder.Visible = pm
	GradFrame.Visible = (mode == "Gradient Flow")
	ScanBand.Visible = (mode == "Scanline")
	PulseFrame.Visible = (mode == "Pulse Glow")
	if mode ~= "Pulse Glow" and WinStroke then tw(WinStroke, 0.3, {Transparency = 0.35, Thickness = 1}) end
	for i, p in ipairs(Particles) do
		p.f.Visible = i <= S.particles
		if mode == "Rain" then p.f.Size = UDim2.fromOffset(1, p.s * 6) else p.f.Size = UDim2.fromOffset(p.s, p.s) end
	end
end
local function bgStep(dt)
	if not (Win and Win.Visible) or S.perfMode then return end
	local mode, sp = S.bgAnim, S.animSpeed
	if mode == "None" then return end
	Tm = Tm + dt * sp
	if mode == "Particles" then
		for i = 1, S.particles do
			local p = Particles[i]
			p.y = p.y - p.v * dt * sp
			if p.y < -0.05 then p.y = 1.05; p.x = math.random() end
			p.f.Position = UDim2.fromScale(p.x + math.sin(Tm * p.w + p.ph) * 0.01, p.y)
		end
	elseif mode == "Rain" then
		for i = 1, S.particles do
			local p = Particles[i]
			p.y = p.y + p.v * dt * sp * 4
			if p.y > 1.05 then p.y = -0.05; p.x = math.random() end
			p.f.Position = UDim2.fromScale(p.x, p.y)
		end
	elseif mode == "Gradient Flow" then
		Grad.Rotation = (Tm * 25) % 360
	elseif mode == "Scanline" then
		ScanBand.Position = UDim2.fromScale(0, (Tm * 0.32) % 1.3 - 0.25)
	elseif mode == "Pulse Glow" then
		local k = (math.sin(Tm * 2.4) + 1) / 2
		PulseStroke.Thickness = 2 + k * 5
		PulseStroke.Transparency = 0.7 - k * 0.6
		WinStroke.Thickness = 1 + k * 2
		WinStroke.Transparency = 0.5 - k * 0.45
	end
end

