		Callback = function(a)
			local q = a.name:lower()
			for _, n in ipairs(ThemeOrder) do if n:lower() == q then S.theme = n; applyAppearance(false) return end end
			if q == "custom" then S.theme = "Custom"; applyAppearance(false) return end
			error("Theme nicht gefunden. Verfügbar: " .. table.concat(ThemeOrder, ", "))
		end})
	add({Name = "uiscale", Category = "UI", Description = "UI-Skalierung", Args = {N("scale", 1, 0.7, 1.3)}, Callback = function(a) S.uiScale = a.scale; applyAppearance(false) end})
	add({Name = "opacity", Category = "UI", Description = "Fenster-Transparenz", Args = {N("value", 0.04, 0, 0.6)}, Callback = function(a) S.windowTransparency = a.value; applyAppearance(false) end})
	add({Name = "notify", Category = "UI", Description = "Zeigt eine Benachrichtigung", Args = {{Name = "text", Type = "string", Default = "Hallo!"}}, Callback = function(a) notify("Notify", a.text) end})
	add({Name = "clearhistory", Category = "UI", Description = "Suchverlauf löschen", Callback = function() for i = #History, 1, -1 do History[i] = nil end save() end})
	add({Name = "panic", Category = "UI", Description = "Alle Toggle-Commands ausschalten", Callback = function() Lib:Panic() end})
	add({Name = "commands", Aliases = {"cmds"}, Category = "UI", Description = "Öffnet das Fenster", Callback = function() Lib:OpenWindow() end})
	add({Name = "settings", Category = "UI", Description = "Öffnet die Settings", Callback = function() Lib:OpenWindow(); switchTab("Settings") end})
	add({Name = "unload", Aliases = {"destroy"}, Category = "UI", Description = "Entlädt NeonCmd komplett", Callback = function() task.defer(function() Lib:Unload() end) end})
end

