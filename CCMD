---------------------------------------------------------------------------------------------------
-- Theme-Engine
---------------------------------------------------------------------------------------------------
local Current = {}
local Registry, ThemeHooks, Corners = {}, {}, {}

local function resolveTheme()
	local t = (S.theme == "Custom") and S.customTheme or Themes[S.theme] or Themes["Neon Blue"]
	local out = {}
	for _, k in ipairs(THEME_KEYS) do
		local ok, c = pcall(Color3.fromHex, t[k] or Themes["Neon Blue"][k])
		out[k] = ok and c or Color3.fromHex(Themes["Neon Blue"][k])
	end
	return out
end
Current = resolveTheme()

local function themed(inst, map)
	Registry[#Registry + 1] = {inst, map}
	for p, k in pairs(map) do inst[p] = Current[k] end
	return inst
end
local function hook(inst, fn)
	ThemeHooks[#ThemeHooks + 1] = {inst, fn}
	fn(true)
end
local function applyTheme(instant)
	Current = resolveTheme()
	local t = instant and 0 or 0.35
	for i = #Registry, 1, -1 do
		local e = Registry[i]
		if not e[1].Parent then table.remove(Registry, i)
		else for p, k in pairs(e[2]) do tw(e[1], t, {[p] = Current[k]}) end end
	end
	for i = #ThemeHooks, 1, -1 do
		local h = ThemeHooks[i]
		if not h[1].Parent then table.remove(ThemeHooks, i) else pcall(h[2], instant) end
	end
end

