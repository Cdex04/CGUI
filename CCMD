local Suggestions = {}

function layoutSemi()
	if not Semi.Root then return end
	Semi.Root.Size = UDim2.fromOffset(S.semiWidth, 40)
	Semi.Root.Position = UDim2.new(0.5, 0, S.semiY / 100, 0)
	Semi.Scale.Scale = S.uiScale
	Semi.Box.TextSize = S.searchFont; Semi.Ghost.TextSize = S.searchFont
end

function refreshSemi()
	if not Semi.Root then return end
	local visible = (State == "semi")
	if visible then Semi.Root.Visible = true end
	local active = visible and (Semi.Focused or Semi.Hover)
	tw(Semi.Bar, 0.3, {GroupTransparency = (not visible) and 1 or (active and 0 or S.semiIdle)})
	local showPanel = visible and Semi.Focused
	if showPanel then Semi.Panel.Visible = true end
	tw(Semi.Panel, 0.25, {GroupTransparency = showPanel and 0 or 1})
	if not showPanel then task.delay(0.3, function() if not (State == "semi" and Semi.Focused) then Semi.Panel.Visible = false end end) end
	if not visible then
		task.delay(0.35, function() if State ~= "semi" then Semi.Root.Visible = false end end)
		if Semi.Box and Semi.Box:IsFocused() then Semi.Box:ReleaseFocus() end
	end
end

local function Chip(parent, text, top, onClick)
	local b = New("TextButton", {AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), Text = text, Font = Enum.Font.Code, TextSize = 13,
		BackgroundTransparency = 0.1, LayoutOrder = nextLO(), Parent = parent})
	themed(b, {BackgroundColor3 = "panel", TextColor3 = top and "accent" or "text"})
	corner(b, 0.7); stroke(b, top and 0.2 or 0.75); padding(b, 10, 0, 10, 0)
	b.MouseButton1Click:Connect(onClick)
	return b
end
local function renderPanel()
	clearKids(Semi.Left); clearKids(Semi.Right)
	for i, s in ipairs(Suggestions) do
		if i > S.maxSuggest then break end
		Chip(Semi.Left, (i == 1 and S.tabComplete and "⇥ " or "") .. s.name, i == 1, function()
			Semi.Box.Text = s.name .. (#s.cmd.Args > 0 and " " or "")
			Semi.Box:CaptureFocus(); Semi.Box.CursorPosition = #Semi.Box.Text + 1
		end)
	end
	for i, h in ipairs(History) do
		if i > S.maxHistory then break end
		Chip(Semi.Right, "↺ " .. h, false, function()
			Semi.Box.Text = h; Semi.Box:CaptureFocus(); Semi.Box.CursorPosition = #h + 1
		end)
	end
end
local function argHint(cmd, i)
	local d = cmd.Args[i]
	return "<" .. d.Name .. ": " .. typeLabel(d) .. ">"
end
local function defaultsString(cmd)
	local parts = {}
	for i, d in ipairs(cmd.Args) do parts[#parts + 1] = d.Name .. "=" .. tostring(effArg(cmd, i)) end
	return table.concat(parts, ", ")
end
local function updateSuggestions()
	local text = Semi.Box.Text
	local first = text:match("^%s*(%S*)") or ""
	local hasSpace = text:find("^%s*%S+%s") ~= nil
	Suggestions = {}
	local exact = Commands[first:lower()]
	if first ~= "" then
		if hasSpace then
			if exact then Suggestions = {{cmd = exact, name = first:lower()}} end
		else
			Suggestions = searchCommands(first)
		end
	end
	local ghost = ""
	if S.ghostText and text ~= "" then
		if not hasSpace then
			local top = Suggestions[1]
			if top and top.name:sub(1, #first) == first:lower() and #top.name > #first then
				ghost = string.rep(" ", #text) .. top.name:sub(#first + 1)
			elseif exact and #exact.Args > 0 then
				ghost = string.rep(" ", #text) .. " " .. argHint(exact, 1) .. "   ↵ Standard: " .. defaultsString(exact)
			end
		elseif exact then
			local tokens = {}
			for w in text:gmatch("%S+") do tokens[#tokens + 1] = w end
			local typed = #tokens - 1
			local endsSpace = text:match("%s$") ~= nil
			local idx = endsSpace and (typed + 1) or typed
			if endsSpace then
				if idx <= #exact.Args then ghost = string.rep(" ", #text) .. argHint(exact, idx)
				else ghost = string.rep(" ", #text) .. "↵" end
			elseif idx < #exact.Args then
				ghost = string.rep(" ", #text) .. " " .. argHint(exact, idx + 1)
			end
		end
	end
	Semi.Ghost.Text = ghost
	renderPanel()
end

local function acceptTop()
	local top = Suggestions[1]
	if top and S.tabComplete and not Semi.Box.Text:find("^%s*%S+%s") then
		Semi.Box.Text = top.name .. (#top.cmd.Args > 0 and " " or "")
		Semi.Box.CursorPosition = #Semi.Box.Text + 1
	end
end

