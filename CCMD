---------------------------------------------------------------------------------------------------
-- Theme-Engine (Registry + weicher Farbuebergang ueber einen einzigen Heartbeat)
---------------------------------------------------------------------------------------------------
local Registry, ThemeHooks, Corners = {}, {}, {}
local Current = {}
local themeConn

local function resolveTheme()
	local t = (S.theme == "Custom") and S.customTheme or Themes[S.theme] or Themes["Neon Blue"]
	local out = {}
	for _, k in ipairs(THEME_KEYS) do
		local ok, c = pcall(Color3.fromHex, t[k] or Themes["Neon Blue"][k])
		out[k] = ok and c or Color3.fromHex(Themes["Neon Blue"][k])
	end
	return out
end
Current = resolveTheme()

local function themed(inst, map)
	Registry[#Registry + 1] = {inst, map}
	for p, k in pairs(map) do inst[p] = Current[k] end
	return inst
end
local function hook(inst, fn)
	ThemeHooks[#ThemeHooks + 1] = {inst, fn}
	fn(true)
end
local function prune()
	for i = #Registry, 1, -1 do if not Registry[i][1].Parent then table.remove(Registry, i) end end
	for i = #ThemeHooks, 1, -1 do if not ThemeHooks[i][1].Parent then table.remove(ThemeHooks, i) end end
	for i = #Corners, 1, -1 do if not Corners[i][1].Parent then table.remove(Corners, i) end end
end
local function paint(colors)
	for i = 1, #Registry do
		local e = Registry[i]
		if e[1].Parent then for p, k in pairs(e[2]) do e[1][p] = colors[k] end end
	end
end
local function runHooks(instant)
	for i = #ThemeHooks, 1, -1 do
		local h = ThemeHooks[i]
		if h[1].Parent then pcall(h[2], instant) end
	end
end
local function applyTheme(instant)
	local old = Current
	Current = resolveTheme()
	prune()
	if themeConn then themeConn:Disconnect(); themeConn = nil end
	runHooks(instant)
	if instant then paint(Current) return end
	local t0, new = os.clock(), Current
	themeConn = RunService.Heartbeat:Connect(function()
		local a = math.min((os.clock() - t0) / 0.3, 1)
		local mix = {}
		for _, k in ipairs(THEME_KEYS) do mix[k] = old[k]:Lerp(new[k], a) end
		paint(mix)
		if a >= 1 and themeConn then themeConn:Disconnect(); themeConn = nil end
	end)
end

