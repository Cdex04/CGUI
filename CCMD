-- Trigger-Laufzeit
local Runtime, PollList, LastFire = {}, {}, {}
local RunTool
RunTool = function(tool, depth)
	if depth > 5 then return end
	if tool.type == "code" then
		if not loadstring then notify("Quick Tool", "loadstring nicht verfügbar", "error") return end
		local f, err = loadstring(tool.code or "")
		if not f then notify(tool.name or "Quick Tool", "Syntaxfehler: " .. tostring(err), "error") return end
		local ok, e = pcall(f)
		if not ok then notify(tool.name or "Quick Tool", tostring(e), "error") end
	else
		for _, st in ipairs(tool.steps or {}) do
			if st.type == "command" then Lib:Execute(st.value or "", {silent = true, noHistory = true})
			elseif st.type == "wait" then task.wait(tonumber(st.value) or 1)
			elseif st.type == "notify" then notify(tool.name or "Quick Tool", st.value or "")
			elseif st.type == "tool" then
				for _, t in ipairs(Data.quicktools) do if t.name == st.value then RunTool(t, depth + 1) end end
			end
		end
	end
end
function Lib:FireTool(tool)
	local now = os.clock()
	local id = tool.id or tool.name
	if LastFire[id] and now - LastFire[id] < (tonumber(tool.cooldown) or 0) then return end
	LastFire[id] = now
	task.spawn(RunTool, tool, 0)
end
function restartTriggers()
	for _, c in ipairs(Runtime) do pcall(c) end
	Runtime, PollList = {}, {}
	for _, tool in ipairs(Data.quicktools) do
		if tool.enabled ~= false then
			for _, trg in ipairs(tool.triggers or {}) do
				local ev = Events[trg.event]
				if ev and trg.enabled ~= false then
					local p = trg.param
					if ev.Param and (ev.Param.Type or "number") == "number" then p = tonumber(p) or ev.Param.Default or 0 end
					if ev.Kind == "signal" then
						local ok, cleanup = pcall(ev.Connect, p, function() Lib:FireTool(tool) end)
						if ok and type(cleanup) == "function" then Runtime[#Runtime + 1] = cleanup end
					else
						PollList[#PollList + 1] = {ev = ev, p = p, tool = tool, last = false, st = {}}
					end
				end
			end
		end
	end
end
local function pollTriggers()
	for _, t in ipairs(PollList) do
		local ok, v = pcall(t.ev.Check, t.p, t.st)
		v = (ok and v) and true or false
		if v and not t.last then Lib:FireTool(t.tool) end
		t.last = v
	end
end

