function renderSettings()
	if not SettingsScroll then return end
	prune()
	local pos = SettingsScroll.CanvasPosition
	clearKids(SettingsScroll)
	for _, sec in ipairs(SettingsSections) do
		if sec.name == SettingsCur then
			local ok, err = pcall(sec.build, SettingsScroll)
			if not ok then warn("[NeonCmd] Settings-Bereich '" .. sec.name .. "': " .. tostring(err)) end
		end
	end
	SettingsScroll.CanvasPosition = pos
end
function Lib._renderSidebar()
	if not SettingsSide then return end
	clearKids(SettingsSide)
	local draws = {}
	for _, sec in ipairs(SettingsSections) do
		local b = New("TextButton", {Size = UDim2.new(1, 0, 0, 34), Text = "  " .. sec.name, Font = Enum.Font.GothamMedium, TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 0, LayoutOrder = nextLO(), Parent = SettingsSide})
		corner(b, 0.7)
		local function draw()
			local on = (SettingsCur == sec.name)
			b.BackgroundColor3 = on and Current.accent or Current.panel2
			b.TextColor3 = on and Current.bg or Current.text
			b.BackgroundTransparency = on and 0 or 0.2
		end
		draws[#draws + 1] = draw
		hook(b, draw)
		b.MouseButton1Click:Connect(function()
			SettingsCur = sec.name
			for _, d in ipairs(draws) do d() end
			renderSettings()
		end)
	end
end

