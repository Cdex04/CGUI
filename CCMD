-- Ladescreen (animierter Ring, Shimmer-Balken, Schritt-Log)
---------------------------------------------------------------------------------------------------
local function runLoader(steps)
	local dim = New("Frame", {Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 50, Active = true, Parent = Gui})
	local card = New("CanvasGroup", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.54), Size = UDim2.fromOffset(460, 288), GroupTransparency = 1, ZIndex = 51, Parent = dim})
	themed(card, {BackgroundColor3 = "panel"}); corner(card, 1.7); stroke(card, 0.3)

	local topLine = New("Frame", {Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 52, Parent = card})
	local tlg = New("UIGradient", {Transparency = NumberSequence.new({NSK(0, 1), NSK(0.5, 0), NSK(1, 1)}), Parent = topLine})
	hook(topLine, function() tlg.Color = ColorSequence.new(Current.accent) end)

	local ring0 = New("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24), Size = UDim2.fromOffset(66, 66), BackgroundTransparency = 1, ZIndex = 52, Parent = card})
	round_(ring0); New("UIStroke", {Thickness = 4, Transparency = 0.85, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = Color3.new(1, 1, 1), Parent = ring0})
	local ring = New("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24), Size = UDim2.fromOffset(66, 66), BackgroundTransparency = 1, ZIndex = 53, Parent = card})
	round_(ring)
	local rs = New("UIStroke", {Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ring})
	themed(rs, {Color = "accent"})
	local rg = New("UIGradient", {Transparency = NumberSequence.new({NSK(0, 0), NSK(0.5, 0.2), NSK(0.72, 1), NSK(1, 1)}), Parent = rs})
	Label({Text = Lib.Name:sub(1, 1):upper(), Font = Enum.Font.GothamBlack, TextSize = 26, Position = UDim2.new(0.5, -33, 0, 24), Size = UDim2.fromOffset(66, 66),
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 53, Parent = card}, "accent")

	local spaced = {}
	for ch in Lib.Name:upper():gmatch(".") do spaced[#spaced + 1] = ch end
	local title = Label({Text = table.concat(spaced, " "), Font = Enum.Font.GothamBlack, TextSize = 20, Position = UDim2.fromOffset(0, 100), Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 52, Parent = card}, "text")
	title.TextTransparency = 1
	Label({Text = "Command UI  •  v" .. Lib.Version, TextSize = 11, Position = UDim2.fromOffset(0, 126), Size = UDim2.new(1, 0, 0, 14),
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 52, Parent = card}, "sub")
	local stepLbl = Label({Text = "Starte…", TextSize = 13, Position = UDim2.fromOffset(28, 152), Size = UDim2.new(1, -120, 0, 18), ZIndex = 52, Parent = card}, "text")
	local pct = Label({Text = "0%", Font = Enum.Font.GothamBold, Position = UDim2.new(1, -90, 0, 152), Size = UDim2.fromOffset(62, 18), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 52, Parent = card}, "accent")
	local track_ = New("Frame", {Position = UDim2.fromOffset(28, 176), Size = UDim2.new(1, -56, 0, 8), BackgroundTransparency = 0, ZIndex = 52, Parent = card})
	themed(track_, {BackgroundColor3 = "bg"}); round_(track_)
	local fill = New("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 53, Parent = track_})
	round_(fill)
	local fg = New("UIGradient", {Parent = fill})
	hook(fill, function() fg.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Current.accent), ColorSequenceKeypoint.new(0.5, Current.text), ColorSequenceKeypoint.new(1, Current.accent)}) end)
	local counter = Label({Text = "Schritt 0 / " .. #steps, TextSize = 11, Position = UDim2.fromOffset(28, 190), Size = UDim2.new(1, -56, 0, 14), ZIndex = 52, Parent = card}, "sub")
	local log = New("Frame", {Position = UDim2.fromOffset(28, 214), Size = UDim2.new(1, -56, 0, 60), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 52, Parent = card})
	List(log, 2, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)

	local t0 = os.clock()
	local lc = RunService.Heartbeat:Connect(function(dt)
		rg.Rotation = (rg.Rotation + dt * 300) % 360
		fg.Offset = Vector2.new(((os.clock() - t0) * 0.8) % 2 - 1, 0)
	end)
	tw(dim, 0.7, {BackgroundTransparency = 0.4}); tw(card, 0.7, {GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5)})
	tw(title, 1.0, {TextTransparency = 0})
	task.wait(0.9)
	local lines = {}
	for i, st in ipairs(steps) do
		stepLbl.Text = st[1] .. "…"; counter.Text = "Schritt " .. i .. " / " .. #steps
		local ok, err = pcall(st[2])
		if not ok then warn("[NeonCmd] Schritt '" .. st[1] .. "' fehlgeschlagen: " .. tostring(err)) end
		tw(fill, 0.5, {Size = UDim2.new(i / #steps, 0, 1, 0)})
		pct.Text = math.floor(i / #steps * 100) .. "%"
		local line = Label({Text = (ok and "✓  " or "⚠  ") .. st[1], TextSize = 12, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = i, ZIndex = 53, Parent = log}, ok and "accent" or "sub")
		line.TextTransparency = 1
		tw(line, 0.35, {TextTransparency = ok and 0.15 or 0.4})
		lines[#lines + 1] = line
		if #lines > 4 then local o = table.remove(lines, 1); tw(o, 0.2, {TextTransparency = 1}); task.delay(0.25, function() o:Destroy() end) end
		task.wait(0.55)
	end
	stepLbl.Text = "Bereit"
	task.wait(0.7)
	tw(card, 0.55, {GroupTransparency = 1, Position = UDim2.fromScale(0.5, 0.46)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	tw(dim, 0.7, {BackgroundTransparency = 1})
	task.wait(0.8)
	lc:Disconnect()
	dim:Destroy()
end

