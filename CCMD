-- Eingaben (Keybinds, Open/Focus, Tab, Escape)
---------------------------------------------------------------------------------------------------
local Held = {}
local function flip(cmd) if cmd.Toggle then return not cmd.On end return nil end
local function handleBinds(kn, down)
	for _, cmd in ipairs(CommandList) do
		local st = Data.commands[cmd.Name]
		if st and st.keybind == kn then
			local mode = st.mode or "Tap"
			if down then
				if mode == "Hold" then
					Held[cmd] = true
					Lib:RunCommand(cmd, nil, cmd.Toggle and true or nil)
				elseif mode == "Tap" then Lib:RunCommand(cmd, nil, flip(cmd)) end
			else
				if mode == "Hold" then
					if Held[cmd] then Held[cmd] = nil; if cmd.Toggle then Lib:RunCommand(cmd, nil, false) end end
				elseif mode == "Release" then Lib:RunCommand(cmd, nil, flip(cmd)) end
			end
		end
	end
	for _, tool in ipairs(Data.quicktools) do
		if tool.enabled ~= false and tool.keybind == kn and tool.keybind ~= "" then
			if (tool.mode == "Release") == (not down) then Lib:FireTool(tool) end
		end
	end
end

local function connectInput()
	track(UIS.InputBegan:Connect(function(input, gpe)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if Semi.Box and Semi.Box:IsFocused() then
			if input.KeyCode == Enum.KeyCode.Tab then acceptTop() end
			return
		end
		if Listening or State == "loading" then return end
		if input.KeyCode == Enum.KeyCode.Escape and S.escClose and State == "full" then Lib:CloseWindow() return end
		if gpe then return end
		local kn = input.KeyCode.Name
		if kn == S.openKey then Lib:ToggleWindow() return end
		if kn == S.focusKey then Lib:FocusSearch() return end
		if S.panicKey ~= "" and kn == S.panicKey then Lib:Panic() return end
		handleBinds(kn, true)
	end))
	track(UIS.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard or Listening then return end
		handleBinds(input.KeyCode.Name, false)
	end))
end

