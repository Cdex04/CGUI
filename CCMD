	themed(head, {BackgroundColor3 = "panel2"}); corner(head, 0.8)
	Label({Text = text, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.5, 0, 1, 0), Parent = head})
	local arrow = Label({Text = "▾", Position = UDim2.new(1, -26, 0, 0), Size = UDim2.fromOffset(16, 38), TextXAlignment = Enum.TextXAlignment.Center, Parent = head}, "accent")
	local cur = Label({Text = tostring(get()), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -34, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Parent = head}, "accent")
	local box = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, LayoutOrder = 2, Parent = r})
	List(box, 3); padding(box, 14, 0, 0, 0)
	local function build()
		for _, c in ipairs(box:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
		local list = type(options) == "function" and options() or options
		for _, o in ipairs(list) do
			local b = Btn({Size = UDim2.new(1, 0, 0, 28), Text = tostring(o), TextSize = 13, LayoutOrder = nextLO(), Parent = box}, "bg", (o == get()) and "accent" or "text")
			corner(b, 0.6)
			b.MouseButton1Click:Connect(function()
				set(o); cur.Text = tostring(get()); box.Visible = false; arrow.Text = "▾"
			end)
		end
