local BGLayer, ParticleHolder, GradFrame, Grad, ScanLine
local Particles, Tm = {}, 0
local function buildBg()
	BGLayer = New("Frame", {Name = "BG", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, ClipsDescendants = true, Parent = Win})
	GradFrame = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Visible = false, Parent = BGLayer})
	Grad = New("UIGradient", {Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1)}), Parent = GradFrame})
	hook(GradFrame, function() Grad.Color = ColorSequence.new(Current.accent, Current.bg) end)
	ScanLine = New("Frame", {Size = UDim2.new(1, 0, 0, 3), BackgroundTransparency = 0.75, Visible = false, Parent = BGLayer})
	themed(ScanLine, {BackgroundColor3 = "accent"})
	ParticleHolder = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = BGLayer})
	for i = 1, 34 do
		local f = New("Frame", {BackgroundTransparency = 0.7, Parent = ParticleHolder})
		New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = f})
		Particles[i] = {f = f, x = math.random(), y = math.random(), v = 0.02 + math.random() * 0.05, w = 1 + math.random() * 2, ph = math.random() * 6, s = math.random(2, 5)}
		hook(f, function() f.BackgroundColor3 = Current.accent end)
	end
end
function setBgMode(mode)
	if not BGLayer then return end
	ParticleHolder.Visible = (mode == "Particles" or mode == "Rain")
	GradFrame.Visible = (mode == "Gradient Flow")
	ScanLine.Visible = (mode == "Scanline")
	if mode ~= "Pulse Glow" and WinStroke then tw(WinStroke, 0.3, {Transparency = 0.35}) end
	for _, p in ipairs(Particles) do
		if mode == "Rain" then p.f.Size = UDim2.fromOffset(1, p.s * 5) else p.f.Size = UDim2.fromOffset(p.s, p.s) end
	end
end
local function bgStep(dt)
	if not (Win and Win.Visible) then return end
	local mode, sp = S.bgAnim, S.animSpeed
	if mode == "None" then return end
	Tm = Tm + dt * sp
	if mode == "Particles" then
		for _, p in ipairs(Particles) do
			p.y = p.y - p.v * dt * sp
			if p.y < -0.05 then p.y = 1.05; p.x = math.random() end
			p.f.Position = UDim2.fromScale(p.x + math.sin(Tm * p.w + p.ph) * 0.01, p.y)
		end
	elseif mode == "Rain" then
		for _, p in ipairs(Particles) do
			p.y = p.y + p.v * dt * sp * 4
			if p.y > 1.05 then p.y = -0.05; p.x = math.random() end
			p.f.Position = UDim2.fromScale(p.x, p.y)
		end
	elseif mode == "Gradient Flow" then
		Grad.Rotation = (Tm * 25) % 360
	elseif mode == "Scanline" then
		ScanLine.Position = UDim2.fromScale(0, (Tm * 0.25) % 1.1 - 0.05)
	elseif mode == "Pulse Glow" then
		WinStroke.Transparency = 0.25 + (math.sin(Tm * 2) + 1) * 0.3
	end
end

