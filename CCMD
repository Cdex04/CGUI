	Semi.Ghost = Label({Text = "", Font = Enum.Font.Code, TextSize = 16, Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -48, 1, 0), TextTruncate = Enum.TextTruncate.None, Parent = bar}, "sub")
