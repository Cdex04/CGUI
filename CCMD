local function New(class, props, kids)
	local o = Instance.new(class)
	local parent
	props = props or {}
	if (class == "TextLabel" or class == "ImageLabel" or class == "ScrollingFrame") and props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
		o.BackgroundTransparency = 1
	end
	if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
	if class == "TextButton" and props.AutoButtonColor == nil then o.AutoButtonColor = false end
	for k, v in pairs(props) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	if kids then for _, c in ipairs(kids) do c.Parent = o end end
	o.Parent = parent
	return o
end
local function corner(o, m)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, math.floor(S.corner * (m or 1)))
	c.Parent = o
	Corners[#Corners + 1] = {c, m or 1}
	return c
end
local function stroke(o, tr, key)
	local s = Instance.new("UIStroke")
	s.Thickness = 1; s.Transparency = tr or 0.6
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	themed(s, {Color = key or "accent"})
	s.Parent = o
	return s
end
local function padding(o, l, t, r, b)
	return New("UIPadding", {PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or l or 0),
		PaddingRight = UDim.new(0, r or l or 0), PaddingBottom = UDim.new(0, b or t or l or 0), Parent = o})
end
local function List(parent, pad, dir, ha, va)
	return New("UIListLayout", {Padding = UDim.new(0, pad or 6), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = dir or Enum.FillDirection.Vertical, HorizontalAlignment = ha or Enum.HorizontalAlignment.Left,
		VerticalAlignment = va or Enum.VerticalAlignment.Top, Parent = parent})
end
local function Label(props, ck)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextSize = props.TextSize or 14
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextTruncate = props.TextTruncate or Enum.TextTruncate.AtEnd
	local o = New("TextLabel", props)
	themed(o, {TextColor3 = ck or "text"})
	return o
end
local function Btn(props, bgk, tck)
	props.BackgroundTransparency = props.BackgroundTransparency or 0.1
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextSize = props.TextSize or 14
	local o = New("TextButton", props)
	themed(o, {BackgroundColor3 = bgk or "panel2", TextColor3 = tck or "text"})
	return o
end
local function hover(o, a, b)
	o.MouseEnter:Connect(function() tw(o, 0.15, {BackgroundTransparency = a}) end)
	o.MouseLeave:Connect(function() tw(o, 0.15, {BackgroundTransparency = b}) end)
end
local function Scroll(props)
	props.BackgroundTransparency = 1
	props.ScrollBarThickness = props.ScrollBarThickness or 3
	props.AutomaticCanvasSize = props.AutomaticCanvasSize or Enum.AutomaticSize.Y
	props.CanvasSize = UDim2.new()
	props.ScrollingDirection = props.ScrollingDirection or Enum.ScrollingDirection.Y
	local o = New("ScrollingFrame", props)
	themed(o, {ScrollBarImageColor3 = "accent"})
	return o
end
local function clearKids(f)
	for _, c in ipairs(f:GetChildren()) do
		if not (c:IsA("UIListLayout") or c:IsA("UIPadding") or c:IsA("UIGridLayout")) then c:Destroy() end
	end
end

