	corner(b, 0.6); stroke(b, 0.5)
	local function draw() local k = get(); b.Text = (k and k ~= "") and k or "Keine" end
	draw()
	b.MouseButton1Click:Connect(function()
		if Listening then return end
		Listening = true; b.Text = "Taste drücken…"
		local conn
		conn = UIS.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				conn:Disconnect()
				task.defer(function() Listening = false end)
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then set("") else set(input.KeyCode.Name) end
				draw()
			end
		end)
	end)
	return {Row = r, Refresh = draw}
