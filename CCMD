local Suggestions = {}

function layoutSemi()
	if not Semi.Root then return end
	Semi.Root.Size = UDim2.fromOffset(S.semiWidth, 40)
	Semi.Root.Position = UDim2.new(0.5, 0, S.semiY / 100, 0)
