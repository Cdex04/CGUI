local TabNames = {"Commands", "Game", "Players", "Quick Tools", "Settings"}
local Pages, TabBtns, CurrentTab = {}, {}, nil

function switchTab(name, instant)
	if not Pages[name] then name = "Commands" end
	CurrentTab = name
	S.lastTab = name
	for n, p in pairs(Pages) do
		if n == name then
			p.Visible = true
			if not instant and S.tabAnim then
				p.Position = UDim2.fromOffset(0, 14)
				tw(p, 0.3, {Position = UDim2.fromOffset(0, 0)})
			else p.Position = UDim2.fromOffset(0, 0) end
		else p.Visible = false end
	end
	for n, b in pairs(TabBtns) do
		local on = (n == name)
		tw(b.btn, 0.2, {TextColor3 = on and Current.accent or Current.sub})
		tw(b.line, S.tabAnim and 0.25 or 0, {Size = on and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 0, 0, 2)})
	end
	if name == "Players" and refreshPlayers then refreshPlayers() end
	save()
end

function updateCorners()
	for i = #Corners, 1, -1 do
		local c = Corners[i]
		if not c[1].Parent then table.remove(Corners, i) else c[1].CornerRadius = UDim.new(0, math.floor(S.corner * c[2])) end
	end
	if WinCorner then WinCorner.CornerRadius = S.fullscreen and UDim.new(0, 0) or UDim.new(0, math.floor(S.corner * 1.5)) end
end

-- Fenstergroesse / Fullscreen anwenden (setPos = true setzt auch die Position)
function applyWindowMode(setPos)
	if not Win then return end
	local sc = S.uiScale
	if S.fullscreen then
		Win.Size = UDim2.fromScale(1 / sc, 1 / sc)
		if setPos or State == "full" then Win.Position = UDim2.fromScale(0.5, 0.5) end
		if WinStroke then WinStroke.Enabled = false end
	else
		Win.Size = UDim2.fromOffset(S.winW, S.winH)
		if (setPos or State == "full") and State == "full" and not setPos then Win.Position = UDim2.fromScale(S.winX, S.winY) end
		if WinStroke then WinStroke.Enabled = true end
	end
	if WinCorner then WinCorner.CornerRadius = S.fullscreen and UDim.new(0, 0) or UDim.new(0, math.floor(S.corner * 1.5)) end
end

