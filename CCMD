-- Utils
---------------------------------------------------------------------------------------------------
local function deepcopy(t)
	if type(t) ~= "table" then return t end
	local r = {}
	for k, v in pairs(t) do r[k] = deepcopy(v) end
	return r
end
local function fillMissing(dst, src)
	for k, v in pairs(src) do
		if dst[k] == nil then dst[k] = deepcopy(v)
		elseif type(v) == "table" and type(dst[k]) == "table" then fillMissing(dst[k], v) end
	end
end
local function clamp(n, a, b) return math.max(a, math.min(b, n)) end
local function round(n, step)
	step = step or 1
	return tonumber(string.format("%.4f", math.floor(n / step + 0.5) * step))
end
local function trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end
local function parseHex(s)
	s = tostring(s):gsub("#", "")
	if #s == 6 and s:match("^%x+$") then return "#" .. s:upper() end
end
local function tw(o, t, props, style, dir)
	local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end
local LOc = 0
local function nextLO() LOc = LOc + 1 return LOc end

local Connections = {}
local function track(c) Connections[#Connections + 1] = c return c end
local function bind(inst, signal, fn)
	local c = signal:Connect(fn)
	Connections[#Connections + 1] = c
	inst.Destroying:Connect(function() c:Disconnect() end)
	return c
end

local function clip(text)
	if setclipboard then pcall(setclipboard, text) return true end
	if toclipboard then pcall(toclipboard, text) return true end
	return false
end

-- Datei-IO
local FS = {folder = "NeonCmd", file = "NeonCmd/data.json"}
local canFS = (writefile and readfile and isfile and isfolder and makefolder) and true or false
function FS.save(data)
	if not canFS then return end
	pcall(function()
		if not isfolder(FS.folder) then makefolder(FS.folder) end
		writefile(FS.file, HttpService:JSONEncode(data))
	end)
end
function FS.load()
	if not canFS then return nil end
	local ok, r = pcall(function()
		if isfile(FS.file) then return HttpService:JSONDecode(readfile(FS.file)) end
	end)
	return ok and r or nil
end

