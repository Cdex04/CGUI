local Events, EventList = {}, {}
local Bus = {}
local FPS = 60
local function busOn(name, fn)
	Bus[name] = Bus[name] or {}
	local t = Bus[name]; t[#t + 1] = fn
	return function() for i, f in ipairs(t) do if f == fn then table.remove(t, i) break end end end
end
local function busEmit(name, ...)
	local t = Bus[name]; if not t then return end
	for i = 1, #t do if t[i] then task.spawn(t[i], ...) end end
end
function Lib:AddEvent(def)
	assert(def and def.Id and def.Name, "AddEvent: Id und Name nötig")
	def.Kind = def.Kind or "signal"
	Events[def.Id] = def
	EventList[#EventList + 1] = def
end

local function myHum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function myRoot() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function speedOf()
	local r = myRoot(); if not r then return 0 end
	local v = r.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z).Magnitude
end
local function getPing()
	local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
	return ok and v or 0
end
local function withHumanoid(setup)
	local conns, dead = {}, false
	local function add(c) conns[#conns + 1] = c end
	local function attach(char)
		task.spawn(function()
			local hum = char:WaitForChild("Humanoid", 10)
			if hum and not dead then setup(hum, add) end
		end)
	end
	add(LP.CharacterAdded:Connect(attach))
	if LP.Character then attach(LP.Character) end
	return function() dead = true; for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end end
end
local function simpleSignal(getSignal)
	return function(_, fire)
		local c = getSignal(fire)
		return function() c:Disconnect() end
	end
end
local function nearestDist()
	local r = myRoot(); if not r then return math.huge end
	local best = math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local pr = p.Character:FindFirstChild("HumanoidRootPart")
			if pr then best = math.min(best, (pr.Position - r.Position).Magnitude) end
		end
	end
	return best
end
local function nameMatch(plr, q) q = tostring(q):lower() return plr.Name:lower():find(q, 1, true) or plr.DisplayName:lower():find(q, 1, true) end

local function pollEv(id, name, desc, param, check) Lib:AddEvent({Id = id, Name = name, Description = desc, Param = param, Kind = "poll", Check = check}) end
local function sigEv(id, name, desc, param, connect) Lib:AddEvent({Id = id, Name = name, Description = desc, Param = param, Kind = "signal", Connect = connect}) end
