-- Tab: Commands (mit Kategorie-Filtern, Favoriten, Aktiv-Filter)
---------------------------------------------------------------------------------------------------
local CmdList, CmdBody, CmdDivider, CmdPanel, CatChips
local CmdFilter, CatFilter = "", "Alle"
local CmdRows, SelectedCmd = {}, nil
Lib._rows = CmdRows

local function reorderRows()
	for i, cmd in ipairs(CommandList) do if CmdRows[cmd] then CmdRows[cmd].row.LayoutOrder = i end end
end
function applyCmdFilter()
	if not CmdList then return end
	local q = CmdFilter:lower()
	for cmd, r in pairs(CmdRows) do
		local ok = (q == "") or cmd.Name:find(q, 1, true) ~= nil or cmd.Description:lower():find(q, 1, true) ~= nil or cmd.Category:lower():find(q, 1, true) ~= nil
		if ok then
			if CatFilter == "★ Favoriten" then ok = csr(cmd).fav == true
			elseif CatFilter == "● Aktiv" then ok = cmd.On == true
			elseif CatFilter ~= "Alle" then ok = (cmd.Category == CatFilter) end
		end
		r.row.Visible = ok and true or false
	end
end
function rebuildChips()
	if not CatChips then return end
	clearKids(CatChips)
	local cats, seen = {"Alle", "★ Favoriten", "● Aktiv"}, {}
	for _, cmd in ipairs(CommandList) do
		if not seen[cmd.Category] then seen[cmd.Category] = true; cats[#cats + 1] = cmd.Category end
	end
	local draws = {}
	for _, c in ipairs(cats) do
		local b = New("TextButton", {AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), Text = c, Font = Enum.Font.GothamMedium, TextSize = 12,
			BackgroundTransparency = 0, LayoutOrder = nextLO(), Parent = CatChips})
		corner(b, 0.7); padding(b, 12, 0, 12, 0)
		local function draw()
			local on = (CatFilter == c)
			b.BackgroundColor3 = on and Current.accent or Current.panel2
			b.TextColor3 = on and Current.bg or Current.text
			b.BackgroundTransparency = on and 0 or 0.15
		end
		draws[#draws + 1] = draw
		hook(b, draw)
		b.MouseButton1Click:Connect(function()
			CatFilter = c
			for _, d in ipairs(draws) do d() end
			applyCmdFilter()
		end)
	end
end
function refreshRow(cmd, instant)
	local r = CmdRows[cmd]; if not r then return end
	local on = cmd.On
	local t = instant and 0 or 0.2
	tw(r.row, t, {BackgroundColor3 = on and Current.accent or Current.panel2, BackgroundTransparency = on and 0 or 0.15})
	tw(r.name, t, {TextColor3 = on and Current.bg or Current.text})
	tw(r.desc, t, {TextColor3 = on and Current.bg or Current.sub})
	tw(r.badge, t, {TextColor3 = on and Current.bg or Current.accent})
	local st = csr(cmd)
	r.name.Text = ((st.fav and "★ " or "") .. cmd.Name .. r.sig)
	r.badge.Text = ((st.keybind ~= "") and ("[" .. st.keybind .. "]") or "") .. (cmd.Toggle and (on and "  ● AN" or "  ○ AUS") or "")
	r.badge.Visible = S.showBadges
end
local function layoutRow(cmd)
	local r = CmdRows[cmd]; if not r then return end
	if S.showDesc then
		r.row.Size = UDim2.new(1, 0, 0, 46)
		r.name.Position = UDim2.fromOffset(12, 5); r.name.Size = UDim2.new(1, -150, 0, 18)
	else
		r.row.Size = UDim2.new(1, 0, 0, 34)
		r.name.Position = UDim2.fromOffset(12, 0); r.name.Size = UDim2.new(1, -150, 1, 0)
	end
	r.desc.Visible = S.showDesc
end
local function flashRow(cmd)
	local r = CmdRows[cmd]; if not r then return end
	r.row.BackgroundColor3 = Current.accent
	r.row.BackgroundTransparency = 0
	tw(r.row, 0.35, {BackgroundColor3 = Current.panel2, BackgroundTransparency = 0.15})
end
local function argSig(cmd)
	local p = {}
	for _, d in ipairs(cmd.Args) do p[#p + 1] = "<" .. d.Name .. ">" end
	return #p > 0 and ("  " .. table.concat(p, " ")) or ""
end
local function buildCommandRow(cmd)
	if CmdRows[cmd] or not CmdList then return end
	local row = New("TextButton", {Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 0.15, Text = "", Parent = CmdList})
	corner(row, 0.8)
	local name = Label({Text = cmd.Name, Font = Enum.Font.GothamBold, TextSize = 14, Position = UDim2.fromOffset(12, 5), Size = UDim2.new(1, -150, 0, 18), Parent = row})
	local desc = Label({Text = "[" .. cmd.Category .. "] " .. cmd.Description, TextSize = 12, Position = UDim2.fromOffset(12, 24), Size = UDim2.new(1, -150, 0, 16), Parent = row}, "sub")
	local badge = Label({TextSize = 12, Position = UDim2.new(1, -140, 0, 0), Size = UDim2.new(0, 130, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Parent = row}, "accent")
	CmdRows[cmd] = {row = row, name = name, desc = desc, badge = badge, sig = argSig(cmd)}
	layoutRow(cmd)
	hook(row, function(instant) refreshRow(cmd, instant) end)
	row.MouseButton1Click:Connect(function()
		if cmd.Toggle then Lib:RunCommand(cmd, nil, not cmd.On)
		else flashRow(cmd); Lib:RunCommand(cmd) end
	end)
	row.MouseButton2Click:Connect(function()
		if SelectedCmd == cmd then closeCommandSettings() else openCommandSettings(cmd) end
	end)
	reorderRows(); applyCmdFilter()
end
Lib.OnCommandAdded = function(cmd) buildCommandRow(cmd); reorderRows(); rebuildChips() end

function closeCommandSettings()
	SelectedCmd = nil
	if not CmdList then return end
	tw(CmdList, 0.35, {Size = UDim2.fromScale(1, 1)})
	tw(CmdDivider, 0.3, {Position = UDim2.fromScale(1.05, 0)})
	tw(CmdPanel, 0.35, {Position = UDim2.new(1.05, 0, 0, 0)})
	task.delay(0.36, function() if not SelectedCmd then CmdDivider.Visible = false; CmdPanel.Visible = false end end)
end

local function renderCmdSettingDef(sc, cmd, def, st)
	local t = def.Type
	local key = def.Key
	local function get() local v = st.custom[key]; if v == nil then v = def.Default end return v end
	local function set(v) st.custom[key] = v; save() end
	if t == "section" then UI_Section(sc, def.Name or "")
	elseif t == "text" then UI_Text(sc, def.Name or "")
	elseif t == "toggle" then UI_Toggle(sc, def.Name, function() return get() == true end, set)
	elseif t == "slider" then UI_Slider(sc, def.Name, def.Min or 0, def.Max or 100, def.Step or 1, function() return tonumber(get()) or def.Min or 0 end, set, def.Suffix)
	elseif t == "input" then
		UI_Input(sc, def.Name, get, function(v)
			if def.Number then v = tonumber(v) or tonumber(get()) or 0 end
			set(v); return v
		end, def.Placeholder, def.Width or 140)
	elseif t == "dropdown" then UI_Dropdown(sc, def.Name, def.Options or {}, get, set)
	elseif t == "segment" then UI_Segment(sc, def.Name, def.Options or {}, get, set)
	elseif t == "keybind" then UI_Keybind(sc, def.Name, function() return get() or "" end, set)
	elseif t == "color" then UI_Color(sc, def.Name, function() return get() or "#FFFFFF" end, function(v, final) st.custom[key] = v; if final then save() end end)
	elseif t == "button" then UI_Button(sc, def.Name, function() if def.Callback then pcall(def.Callback, cmd) end end)
	end
end

function openCommandSettings(cmd)
	prune()
	SelectedCmd = cmd
	local st = cs(cmd)
	CmdDivider.Visible = true; CmdPanel.Visible = true
	tw(CmdList, 0.35, {Size = UDim2.new(0.5, -8, 1, 0)})
	tw(CmdDivider, 0.35, {Position = UDim2.new(0.5, 0, 0, 0)})
	tw(CmdPanel, 0.35, {Position = UDim2.new(0.5, 8, 0, 0)})
	clearKids(CmdPanel)
	local sc = Scroll({Size = UDim2.fromScale(1, 1), Parent = CmdPanel}); List(sc, 6); padding(sc, 0, 0, 8, 0)
	Label({Text = cmd.Name, Font = Enum.Font.GothamBlack, TextSize = 20, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = nextLO(), Parent = sc}, "accent")
	UI_Text(sc, cmd.Description ~= "" and cmd.Description or "Keine Beschreibung.")
	UI_Text(sc, "Kategorie: " .. cmd.Category .. "   |   Usage: " .. cmd.Name .. (function()
		local p = {}
		for _, d in ipairs(cmd.Args) do p[#p + 1] = "<" .. d.Name .. ": " .. typeLabel(d) .. ">" end
		return #p > 0 and (" " .. table.concat(p, " ")) or ""
	end)())
	UI_Section(sc, "Aktivierung")
	UI_Keybind(sc, "Keybind", function() return st.keybind end, function(v) st.keybind = v; refreshRow(cmd, true); save() end)
	UI_Segment(sc, "Modus", {"Hold", "Tap", "Release"}, function() return st.mode end, function(v) st.mode = v; save() end)
	UI_Text(sc, cmd.Toggle and "Hold: an solange gedrückt, beim Loslassen aus.  Tap: bei Druck umschalten.  Release: beim Loslassen umschalten."
		or "Hold/Tap: einmal beim Drücken ausführen (Loslassen löst nichts aus).  Release: einmal beim Loslassen.")
	if #cmd.Args > 0 then
		UI_Section(sc, "Standardwerte (wenn nur der Command getippt wird)")
		for i, d in ipairs(cmd.Args) do
			if d.Type == "boolean" then
				UI_Toggle(sc, d.Name, function() return effArg(cmd, i) == true end, function(v) st.args[tostring(i)] = v; save() end)
			else
				UI_Input(sc, d.Name .. " (" .. typeLabel(d) .. ")", function() return effArg(cmd, i) end, function(txt)
					local v, err = coerce(d, txt)
					if v == nil then notify("Ungültig", err, "error") return effArg(cmd, i) end
					if typeof(v) == "Instance" then v = txt end
					st.args[tostring(i)] = v; save(); return v
				end, "", 120)
			end
		end
	end
	if cmd.Settings and #cmd.Settings > 0 then
		UI_Section(sc, "Command-Optionen")
		for _, def in ipairs(cmd.Settings) do renderCmdSettingDef(sc, cmd, def, st) end
	end
	UI_Section(sc, "Verhalten")
	UI_Toggle(sc, "Favorit (★)", function() return st.fav end, function(v) st.fav = v; refreshRow(cmd, true); applyCmdFilter(); save() end)
	UI_Toggle(sc, "Beim Laden automatisch starten", function() return st.autostart end, function(v) st.autostart = v; save() end)
	UI_Toggle(sc, "Benachrichtigung bei Ausführung", function() return st.notify end, function(v) st.notify = v; save() end)
	UI_Toggle(sc, "In Vorschlägen verstecken", function() return st.hidden end, function(v) st.hidden = v; save() end)
