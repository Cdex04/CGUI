function applyAppearance(instant)
	applyTheme(instant)
	setBgMode(S.bgAnim)
	if Win then Win.BackgroundTransparency = S.windowTransparency; WinScale.Scale = S.uiScale end
	updateCorners(); applyWindowMode(false)
	if FSButton then FSButton.Text = S.fullscreen and "❐" or "⛶" end
	setBlur(State == "full")
	layoutSemi()
	applyNotifPos()
	save()
end

local function SL(sc, text, min, max, step, key, suffix, fn, deferred)
	return UI_Slider(sc, text, min, max, step, function() return S[key] end, function(v) S[key] = v; if fn then fn(v) end save() end, suffix, deferred)
end
local function TG(sc, text, key, fn)
	return UI_Toggle(sc, text, function() return S[key] end, function(v) S[key] = v; if fn then fn(v) end save() end)
end
local function DD(sc, text, opts, key, fn)
	return UI_Dropdown(sc, text, opts, function() return S[key] end, function(v) S[key] = v; if fn then fn(v) end save() end)
end
local function KB(sc, text, key, default)
	return UI_Keybind(sc, text, function() return S[key] end, function(v) S[key] = (v ~= "" or not default) and v or default; save() end)
end
local function reapply() applyAppearance(false) end

