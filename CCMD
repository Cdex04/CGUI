local function runLoader(steps)
	local dim = New("Frame", {Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 50, Active = true, Parent = Gui})
	local card = New("CanvasGroup", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(380, 146), GroupTransparency = 1, ZIndex = 51, Parent = dim})
	themed(card, {BackgroundColor3 = "panel"}); corner(card, 1.5); stroke(card, 0.35)
	Label({Text = Lib.Name:upper(), Font = Enum.Font.GothamBlack, TextSize = 22, Position = UDim2.fromOffset(20, 14), Size = UDim2.new(1, -40, 0, 28), ZIndex = 52, Parent = card}, "accent")
	local stepLbl = Label({Text = "Starte…", Position = UDim2.fromOffset(20, 54), Size = UDim2.new(1, -110, 0, 20), TextSize = 13, ZIndex = 52, Parent = card}, "text")
	local pct = Label({Text = "0%", Position = UDim2.new(1, -90, 0, 54), Size = UDim2.fromOffset(70, 20), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 52, Parent = card}, "accent")
	local track = New("Frame", {Position = UDim2.fromOffset(20, 90), Size = UDim2.new(1, -40, 0, 8), BackgroundTransparency = 0, ZIndex = 52, Parent = card})
	themed(track, {BackgroundColor3 = "bg"}); New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = track})
	local fill = New("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundTransparency = 0, ZIndex = 53, Parent = track})
	themed(fill, {BackgroundColor3 = "accent"}); New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = fill})
	local counter = Label({Text = "Schritt 0 / " .. #steps, TextSize = 11, Position = UDim2.fromOffset(20, 108), Size = UDim2.new(1, -40, 0, 18), ZIndex = 52, Parent = card}, "sub")
	tw(dim, 0.6, {BackgroundTransparency = 0.45}); tw(card, 0.6, {GroupTransparency = 0})
	task.wait(0.8)
	for i, st in ipairs(steps) do
		stepLbl.Text = st[1] .. "…"; counter.Text = "Schritt " .. i .. " / " .. #steps
		local ok, err = pcall(st[2])
		if not ok then warn("[NeonCmd] Schritt '" .. st[1] .. "' fehlgeschlagen: " .. tostring(err)); stepLbl.Text = "⚠ " .. st[1] .. " (Fehler, siehe Konsole)" end
		tw(fill, 0.45, {Size = UDim2.new(i / #steps, 0, 1, 0)})
		pct.Text = math.floor(i / #steps * 100) .. "%"
		task.wait(0.55)
	end
	stepLbl.Text = "Fertig"
	task.wait(0.6)
	tw(card, 0.5, {GroupTransparency = 1}); tw(dim, 0.6, {BackgroundTransparency = 1})
	task.wait(0.7)
	dim:Destroy()
end

function Lib:Start(cfg)
	if Lib.Built then return end
	Lib.Built = true
	cfg = cfg or {}
	Lib.Name = cfg.Name or Lib.Name

	local container = (gethui and (function() local ok, r = pcall(gethui) return ok and r or nil end)()) or Services.CoreGui
	Gui = New("ScreenGui", {Name = HttpService:GenerateGUID(false):sub(1, 12), ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true, DisplayOrder = 999999})
	if syn and syn.protect_gui then pcall(syn.protect_gui, Gui) end
	Gui.Parent = container
	Lib.Gui = Gui

	local steps = {
		{"Lade gespeicherte Daten", function()
			loadData()
			History = Data.history
			Current = resolveTheme()
		end},
		{"Wende Startprofil an", function()
			local p = Data.profiles[S.startProfile] or Data.profiles.Default
			ActiveProfile = Data.profiles[S.startProfile] and S.startProfile or "Default"
			if p then for _, k in ipairs(APPEARANCE) do if p[k] ~= nil then S[k] = deepcopy(p[k]) end end end
			applyTheme(false)
		end},
		{"Baue Fenster", function()
			NotifHolder = New("Frame", {Name = "Notifs", Size = UDim2.new(0, 300, 1, -32), BackgroundTransparency = 1, ZIndex = 100, Parent = Gui})
			NotifLayout = List(NotifHolder, 8)
			applyNotifPos()
			local ok, b = pcall(function() return Instance.new("BlurEffect") end)
			if ok then Blur = b; Blur.Size = 0; Blur.Name = "NC_Blur"; Blur.Parent = Lighting end
			buildWindow()
		end},
		{"Baue Suchleiste", function() buildSemi(); layoutSemi() end},
		{"Registriere Commands", function()
			if cfg.DefaultCommands ~= false then Lib:LoadDefaultCommands() end
			buildCommandsTab(Pages["Commands"])
		end},
		{"Erstelle Tabs", function()
			buildGameTab(Pages["Game"]); updateGameRows()
			buildPlayersTab(Pages["Players"])
			buildQuickToolsTab(Pages["Quick Tools"]); refreshQTList()
			buildSettingsTab(Pages["Settings"])
			QTPicker.Visible = false
			-- Event-Picker bei jedem Oeffnen neu fuellen
			local old = QTPicker:GetPropertyChangedSignal("Visible")
			old:Connect(function() if QTPicker.Visible then fillEventPicker(function(ev)
				local trigTarget = Lib._pickTarget
				if trigTarget then trigTarget(ev) end
			end) end end)
		end},
		{"Verbinde Eingaben & Events", function()
			connectInput()
			restartTriggers()
			local acc = 0
			track(RunService.Heartbeat:Connect(function(dt)
				FPS = FPS + (1 / math.max(dt, 1e-4) - FPS) * 0.05
				bgStep(dt)
				acc = acc + dt
				if acc >= 0.15 then
					acc = 0
					pollTriggers()
					if CurrentTab == "Game" and State == "full" then updateGameRows() end
				end
				if State == "semi" and S.idleHide > 0 and not Semi.Focused and not Semi.Hover and os.clock() - LastActive > S.idleHide then
					setState("hidden")
				end
			end))
		end},
		{"Starte Hintergrund-Animationen", function() setBgMode(S.bgAnim); applyAppearance(true) end},
		{"Finalisiere", function()
			if S.autoStart then
				for _, cmd in ipairs(CommandList) do
					if Data.commands[cmd.Name] and Data.commands[cmd.Name].autostart then Lib:RunCommand(cmd, nil, cmd.Toggle and true or nil, true) end
				end
			end
		end},
	}
	runLoader(steps)
	State = "hidden"
	if S.startState == "Full" then
		setState("semi"); Lib:OpenWindow()
	else
		setState("semi")
	end
	notify(Lib.Name, "Geladen – " .. S.openKey .. " öffnet das Fenster, " .. S.focusKey .. " die Suche")
end

function Lib:Unload()
	pcall(function() for _, cmd in ipairs(CommandList) do if cmd.Toggle and cmd.On then Lib:RunCommand(cmd, nil, false, true) end end end)
	pcall(stopSpectate)
	for p, h in pairs(Highlights) do pcall(function() h.hl:Destroy(); h.conn:Disconnect() end) end
	for _, c in ipairs(Runtime) do pcall(c) end
	Runtime, PollList = {}, {}
	for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
	Connections = {}
	pcall(function() FS.save(Data) end)
	if Blur then pcall(function() Blur:Destroy() end) end
	if Gui then pcall(function() Gui:Destroy() end) end
	if genv.__NeonCmd == Lib then genv.__NeonCmd = nil end
end

return Lib
