	New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = track}); stroke(track, 0.5)
	local knob = New("Frame", {Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), BackgroundTransparency = 0, Parent = track})
	New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = knob})
