local QTList, QTEditor, QTScroll, QTPicker
local StepTypes = {command = "Command", wait = "Warten (s)", notify = "Notify", tool = "Quick Tool"}

local function newTool()
	return {id = HttpService:GenerateGUID(false), name = "", keybind = "", mode = "Tap", type = "payload", steps = {}, code = "", triggers = {}, cooldown = 1, enabled = true}
end

local function closeEditor() QTEditor.Visible = false; QTPicker.Visible = false end

local function openEditor(tool, isNew)
	local w = deepcopy(tool)
	local codeBox
	QTEditor.Visible = true; QTPicker.Visible = false
	local function render()
		local pos = QTScroll.CanvasPosition
		clearKids(QTScroll)
		Label({Text = isNew and "Neues Quick Tool" or "Quick Tool bearbeiten", Font = Enum.Font.GothamBlack, TextSize = 18, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = nextLO(), Parent = QTScroll}, "accent")
		UI_Input(QTScroll, "Name", function() return w.name end, function(v) w.name = trim(v) return w.name end, "z.B. Panic-Heal", 200)
		UI_Keybind(QTScroll, "Keybind", function() return w.keybind end, function(v) w.keybind = v end)
		UI_Segment(QTScroll, "Keybind-Modus", {"Tap", "Release"}, function() return w.mode end, function(v) w.mode = v end)
		UI_Input(QTScroll, "Cooldown (Sekunden)", function() return w.cooldown end, function(v) w.cooldown = tonumber(v) or 0 return w.cooldown end, "1", 80)
		UI_Segment(QTScroll, "Typ", {"Command Payload", "Custom Code"}, function() return w.type == "code" and "Custom Code" or "Command Payload" end,
			function(v) w.type = (v == "Custom Code") and "code" or "payload"; render() end)
		if w.type == "payload" then
			UI_Section(QTScroll, "Schritte (werden der Reihe nach ausgeführt)")
			if #w.steps == 0 then UI_Text(QTScroll, "Noch keine Schritte. Füge unten Commands, Wartezeiten oder Notifys hinzu.") end
			for i, st in ipairs(w.steps) do
				local r = RowBase(QTScroll, 38)
				Label({Text = i .. ".  " .. (StepTypes[st.type] or st.type), TextSize = 12, Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(110, 38), Parent = r}, "accent")
				local box = New("TextBox", {Position = UDim2.fromOffset(124, 6), Size = UDim2.new(1, -124 - 100, 0, 26), Text = tostring(st.value or ""), ClearTextOnFocus = false,
					PlaceholderText = st.type == "command" and "z.B. walkspeed 50" or (st.type == "wait" and "Sekunden" or "Text"), Font = Enum.Font.Code, TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 0, Parent = r})
				themed(box, {BackgroundColor3 = "bg", TextColor3 = "text", PlaceholderColor3 = "sub"}); corner(box, 0.6); padding(box, 6, 0, 6, 0)
				box.FocusLost:Connect(function() st.value = box.Text end)
				local acts = New("Frame", {Size = UDim2.fromOffset(90, 26), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), BackgroundTransparency = 1, Parent = r})
				List(acts, 3, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
				MiniBtn(acts, "↑", false, function() if i > 1 then w.steps[i], w.steps[i - 1] = w.steps[i - 1], w.steps[i]; render() end end)
				MiniBtn(acts, "↓", false, function() if i < #w.steps then w.steps[i], w.steps[i + 1] = w.steps[i + 1], w.steps[i]; render() end end)
				MiniBtn(acts, "✕", false, function() table.remove(w.steps, i); render() end)
			end
			local add = RowBase(QTScroll, 36)
			List(add, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center); padding(add, 6, 0, 6, 0)
			for _, t in ipairs({"command", "wait", "notify", "tool"}) do
				MiniBtn(add, "+ " .. StepTypes[t], false, function()
					w.steps[#w.steps + 1] = {type = t, value = (t == "wait") and "1" or ""}; render()
				end)
			end
		else
			UI_Section(QTScroll, "Lua-Code (wird mit loadstring ausgeführt)")
			local holder = New("Frame", {Size = UDim2.new(1, 0, 0, 190), BackgroundTransparency = 0, LayoutOrder = nextLO(), Parent = QTScroll})
			themed(holder, {BackgroundColor3 = "bg"}); corner(holder, 0.8); stroke(holder, 0.6)
			codeBox = New("TextBox", {Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8), Text = w.code or "", PlaceholderText = "print('Hallo')\n-- dein Code …", ClearTextOnFocus = false,
				MultiLine = true, TextWrapped = false, Font = Enum.Font.Code, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
				BackgroundTransparency = 1, Parent = holder})
			themed(codeBox, {TextColor3 = "text", PlaceholderColor3 = "sub"})
			codeBox.FocusLost:Connect(function() w.code = codeBox.Text end)
		end
		UI_Section(QTScroll, "Event-Trigger (Quick Tool startet automatisch)")
		if #w.triggers == 0 then UI_Text(QTScroll, "Keine Trigger. Das Tool läuft nur per Keybind oder Run-Button.") end
		for i, trg in ipairs(w.triggers) do
			local ev = Events[trg.event]
			local r = RowBase(QTScroll, 46)
			Label({Text = ev and ev.Name or trg.event, Font = Enum.Font.GothamBold, TextSize = 13, Position = UDim2.fromOffset(12, 5), Size = UDim2.new(0.45, 0, 0, 18), Parent = r}, "accent")
			Label({Text = ev and ev.Description or "", TextSize = 11, Position = UDim2.fromOffset(12, 24), Size = UDim2.new(0.45, 0, 0, 16), Parent = r}, "sub")
			if ev and ev.Param then
				local box = New("TextBox", {Size = UDim2.new(0.22, 0, 0, 26), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -112, 0.5, 0), Text = tostring(trg.param or ""),
					PlaceholderText = ev.Param.Label, ClearTextOnFocus = false, Font = Enum.Font.Code, TextSize = 13, BackgroundTransparency = 0, Parent = r})
				themed(box, {BackgroundColor3 = "bg", TextColor3 = "text", PlaceholderColor3 = "sub"}); corner(box, 0.6); padding(box, 6, 0, 6, 0); stroke(box, 0.7)
				box.FocusLost:Connect(function() trg.param = box.Text end)
			end
			local acts = New("Frame", {Size = UDim2.fromOffset(100, 26), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), BackgroundTransparency = 1, Parent = r})
			List(acts, 3, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
			MiniBtn(acts, trg.enabled ~= false and "An" or "Aus", trg.enabled ~= false, function() trg.enabled = not (trg.enabled ~= false); render() end)
			MiniBtn(acts, "✕", false, function() table.remove(w.triggers, i); render() end)
		end
		UI_Button(QTScroll, "+ Event-Trigger hinzufügen (" .. #EventList .. " verfügbar)", function() QTPicker.Visible = true end)
		UI_Toggle(QTScroll, "Quick Tool aktiv", function() return w.enabled ~= false end, function(v) w.enabled = v end)
		UI_Section(QTScroll, "Aktionen")
		UI_Button(QTScroll, "Speichern", function()
			if codeBox then w.code = codeBox.Text end
			if trim(w.name or "") == "" then notify("Name fehlt", "Gib dem Quick Tool einen Namen", "error") return end
			local replaced = false
			for i, t in ipairs(Data.quicktools) do if t.id == w.id then Data.quicktools[i] = w; replaced = true end end
			if not replaced then table.insert(Data.quicktools, w) end
			save(); restartTriggers(); refreshQTList(); closeEditor()
			notify("Quick Tool", "'" .. w.name .. "' gespeichert")
		end)
		UI_Button(QTScroll, "Testen (jetzt ausführen)", function() if codeBox then w.code = codeBox.Text end task.spawn(RunTool, w, 0) end)
		UI_Button(QTScroll, "Abbrechen", closeEditor)
		QTScroll.CanvasPosition = pos
	end
	render()
end

