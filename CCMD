local PlayersList, PlayersCount
local ThumbCache, Highlights = {}, {}
local Spectating, SpecConn

local function stopSpectate()
	if SpecConn then SpecConn:Disconnect(); SpecConn = nil end
	Spectating = nil
	local h = myHum()
	if h and workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = h end
end
local function startSpectate(plr)
	stopSpectate(); Spectating = plr
	local function apply()
		local c = plr.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if h then workspace.CurrentCamera.CameraSubject = h end
	end
	apply()
	SpecConn = plr.CharacterAdded:Connect(function() task.wait(0.5); if Spectating == plr then apply() end end)
end
local function toggleHighlight(plr)
	local h = Highlights[plr]
	if h then h.hl:Destroy(); h.conn:Disconnect(); Highlights[plr] = nil return end
	local hl = Instance.new("Highlight")
	hl.FillColor = Current.accent; hl.OutlineColor = Current.text; hl.FillTransparency = 0.6
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = plr.Character
	hl.Parent = Gui
	local conn = plr.CharacterAdded:Connect(function(c) hl.Adornee = c end)
	Highlights[plr] = {hl = hl, conn = conn}
end

function refreshPlayers()
	if not PlayersList then return end
	prune()
	local pos = PlayersList.CanvasPosition
	clearKids(PlayersList)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then list[#list + 1] = p end end
	table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
	PlayersCount.Text = "Spieler im Server: " .. (#list + 1)
	if #list == 0 then UI_Text(PlayersList, "Außer dir ist niemand im Server.") end
	for _, plr in ipairs(list) do
		local row = New("Frame", {Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 0.15, LayoutOrder = nextLO(), Parent = PlayersList})
		themed(row, {BackgroundColor3 = "panel2"}); corner(row, 0.8)
		local av = New("ImageLabel", {Size = UDim2.fromOffset(38, 38), Position = UDim2.fromOffset(8, 8), BackgroundTransparency = 0.5, Parent = row})
		themed(av, {BackgroundColor3 = "bg"}); round_(av)
		if ThumbCache[plr.UserId] then av.Image = ThumbCache[plr.UserId]
		else
			task.spawn(function()
				local ok, img = pcall(function() return Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48) end)
				if ok and img then ThumbCache[plr.UserId] = img; if av.Parent then av.Image = img end end
			end)
		end
		Label({Text = plr.DisplayName, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(54, 8), Size = UDim2.new(0.3, 0, 0, 18), Parent = row})
		Label({Text = "@" .. plr.Name .. "  •  " .. plr.UserId, TextSize = 11, Position = UDim2.fromOffset(54, 28), Size = UDim2.new(0.3, 0, 0, 16), Parent = row}, "sub")
		local acts = New("Frame", {Size = UDim2.new(0.68, -10, 0, 26), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), BackgroundTransparency = 1, Parent = row})
		List(acts, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
		MiniBtn(acts, "Spectate", Spectating == plr, function()
			if Spectating == plr then stopSpectate() else startSpectate(plr) end
			refreshPlayers()
		end)
		MiniBtn(acts, "TP me to", false, function()
			local r, tr = myRoot(), plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if r and tr then r.CFrame = tr.CFrame * CFrame.new(0, 0, 3); notify("Teleport", "zu " .. plr.DisplayName) else notify("Teleport", "Charakter nicht gefunden", "error") end
		end)
		MiniBtn(acts, "Highlight", Highlights[plr] ~= nil, function() toggleHighlight(plr); refreshPlayers() end)
		MiniBtn(acts, "Copy ID", false, function() if clip(tostring(plr.UserId)) then notify("Kopiert", "UserId " .. plr.UserId) end end)
	end
	PlayersList.CanvasPosition = pos
end

local function buildPlayersTab(page)
	local header = New("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Parent = page})
	PlayersCount = Label({Text = "Spieler", Font = Enum.Font.GothamBold, Size = UDim2.new(1, -140, 1, 0), Parent = header}, "accent")
	local b = Btn({Size = UDim2.new(0, 130, 1, 0), Position = UDim2.new(1, -130, 0, 0), Text = "↻ Aktualisieren", Parent = header}, "panel2", "accent")
	corner(b, 0.8); stroke(b, 0.5); b.MouseButton1Click:Connect(refreshPlayers)
	PlayersList = Scroll({Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 1, -42), Parent = page}); List(PlayersList, 5); padding(PlayersList, 0, 0, 6, 0)
	track(Players.PlayerAdded:Connect(function() if CurrentTab == "Players" and State == "full" then task.wait(0.3) refreshPlayers() end end))
	track(Players.PlayerRemoving:Connect(function(p)
		if Spectating == p then stopSpectate() end
		if Highlights[p] then Highlights[p].hl:Destroy(); Highlights[p].conn:Disconnect(); Highlights[p] = nil end
		if CurrentTab == "Players" and State == "full" then task.wait(0.3) refreshPlayers() end
	end))
	refreshPlayers()
end

