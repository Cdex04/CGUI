	local desc = Label({Text = "[" .. cmd.Category .. "] " .. cmd.Description, TextSize = 12, Position = UDim2.fromOffset(12, 24), Size = UDim2.new(1, -150, 0, 16), Visible = S.showDesc, Parent = row}, "sub")
	local badge = Label({TextSize = 12, Position = UDim2.new(1, -140, 0, 0), Size = UDim2.new(0, 130, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Parent = row}, "accent")
	CmdRows[cmd] = {row = row, name = name, desc = desc, badge = badge}
	hook(row, function(instant) refreshRow(cmd, instant) end)
