local NotifHolder, NotifLayout
local function applyNotifPos()
	if not NotifHolder then return end
	local p = S.notifPos or "TopRight"
	local right, bottom = p:find("Right") ~= nil, p:find("Bottom") ~= nil
	NotifHolder.AnchorPoint = Vector2.new(right and 1 or 0, bottom and 1 or 0)
	NotifHolder.Position = UDim2.new(right and 1 or 0, right and -16 or 16, bottom and 1 or 0, bottom and -16 or 16)
	NotifLayout.HorizontalAlignment = right and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left
	NotifLayout.VerticalAlignment = bottom and Enum.VerticalAlignment.Bottom or Enum.VerticalAlignment.Top
end
function notify(title, text, kind)
	if not S.notif or not NotifHolder then return end
	local right = (S.notifPos or "TopRight"):find("Right") ~= nil
	local wrap = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextLO(), Parent = NotifHolder})
	local card = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(right and 1.3 or -1.3, 0, 0, 0), BackgroundTransparency = 0.08, Parent = wrap})
	themed(card, {BackgroundColor3 = "panel"}); corner(card, 1); stroke(card, 0.35)
	padding(card, 12, 10, 12, 10); List(card, 4)
	Label({Text = ((kind == "error") and "✕ " or "◆ ") .. tostring(title), Font = Enum.Font.GothamBold, TextSize = 13, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1, Parent = card}, "accent")
	if text and text ~= "" then
		Label({Text = tostring(text), TextSize = 12, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2, Parent = card}, "text")
	end
	local barBg = New("Frame", {Size = UDim2.new(1, 0, 0, 2), BackgroundTransparency = 0.8, LayoutOrder = 3, Parent = card})
	themed(barBg, {BackgroundColor3 = "accent"})
	local bar = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0, Parent = barBg})
	themed(bar, {BackgroundColor3 = "accent"})
	local d = S.notifDuration or 4
	tw(card, 0.4, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)
	tw(bar, d, {Size = UDim2.new(0, 0, 1, 0)}, Enum.EasingStyle.Linear)
	task.delay(d, function()
		if not card.Parent then return end
		tw(card, 0.35, {Position = UDim2.new(right and 1.3 or -1.3, 0, 0, 0)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.wait(0.4)
		wrap:Destroy()
	end)
end
