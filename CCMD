function Lib:LoadDefaultCommands()
	local add = function(def) return Lib:AddCommand(def) end
	local cam = function() return workspace.CurrentCamera end
	local function N(name, default, min, max) return {Name = name, Type = "number", Default = default, Min = min, Max = max} end

	-- Movement
	add({Name = "walkspeed", Aliases = {"ws", "speed"}, Category = "Movement", Description = "Setzt die Laufgeschwindigkeit", Args = {N("speed", 16, 0, 500)},
		Callback = function(a) local h = myHum() if h then h.WalkSpeed = a.speed end end})
	add({Name = "jumppower", Aliases = {"jp"}, Category = "Movement", Description = "Setzt die Sprungkraft", Args = {N("power", 50, 0, 500)},
		Callback = function(a) local h = myHum() if h then h.UseJumpPower = true; h.JumpPower = a.power end end})
	add({Name = "hipheight", Aliases = {"hh"}, Category = "Movement", Description = "Setzt die Hüfthöhe", Args = {N("height", 2, 0, 100)},
		Callback = function(a) local h = myHum() if h then h.HipHeight = a.height end end})
	add({Name = "gravity", Aliases = {"grav"}, Category = "Movement", Description = "Setzt die Gravity", Args = {N("value", 196.2, 0, 1000)},
		Callback = function(a) workspace.Gravity = a.value end})
	local flyConn, flyBV, flyBG
	add({Name = "fly", Aliases = {"flight"}, Category = "Movement", Description = "Fliegen (WASD, Space hoch, Shift runter)", Toggle = true, Args = {N("speed", 60, 1, 500)},
		Callback = function(a, on)
			if flyConn then flyConn:Disconnect(); flyConn = nil end
			if flyBV then flyBV:Destroy(); flyBV = nil end
			if flyBG then flyBG:Destroy(); flyBG = nil end
			local h, r = myHum(), myRoot()
			if h then h.PlatformStand = false end
			if not on or not h or not r then return end
			flyBV = Instance.new("BodyVelocity"); flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9); flyBV.Velocity = Vector3.zero; flyBV.Parent = r
			flyBG = Instance.new("BodyGyro"); flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9); flyBG.P = 1e4; flyBG.Parent = r
			h.PlatformStand = true
			flyConn = RunService.RenderStepped:Connect(function()
				if not r.Parent then return end
				local c, d = cam().CFrame, Vector3.zero
				if UIS:IsKeyDown(Enum.KeyCode.W) then d = d + c.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then d = d - c.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then d = d + c.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then d = d - c.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then d = d - Vector3.yAxis end
				flyBV.Velocity = (d.Magnitude > 0 and d.Unit or d) * a.speed
				flyBG.CFrame = c
			end)
		end})
	local ncConn, ncParts = nil, {}
	add({Name = "noclip", Aliases = {"nc"}, Category = "Movement", Description = "Durch Wände laufen", Toggle = true,
		Callback = function(_, on)
			if ncConn then ncConn:Disconnect(); ncConn = nil end
			if on then
				ncConn = RunService.Stepped:Connect(function()
					local c = LP.Character; if not c then return end
					for _, p in ipairs(c:GetDescendants()) do
						if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false; ncParts[p] = true end
					end
				end)
			else
				for p in pairs(ncParts) do if p.Parent then p.CanCollide = true end end
				ncParts = {}
			end
		end})
	local ijConn
	add({Name = "infjump", Aliases = {"ij"}, Category = "Movement", Description = "Unendlich springen", Toggle = true,
		Callback = function(_, on)
			if ijConn then ijConn:Disconnect(); ijConn = nil end
			if on then ijConn = UIS.JumpRequest:Connect(function() local h = myHum() if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end) end
		end})
	local spinConn
	add({Name = "spin", Category = "Movement", Description = "Dreht den Charakter", Toggle = true, Args = {N("speed", 10, 1, 100)},
		Callback = function(a, on)
			if spinConn then spinConn:Disconnect(); spinConn = nil end
			if on then spinConn = RunService.Heartbeat:Connect(function() local r = myRoot() if r then r.CFrame = r.CFrame * CFrame.Angles(0, math.rad(a.speed), 0) end end) end
		end})
	add({Name = "freeze", Category = "Movement", Description = "Hält dich an Ort und Stelle", Toggle = true,
		Callback = function(_, on) local r = myRoot() if r then r.Anchored = on end end})
	add({Name = "sit", Category = "Movement", Description = "Hinsetzen", Callback = function() local h = myHum() if h then h.Sit = true end end})
	add({Name = "jump", Category = "Movement", Description = "Einmal springen", Callback = function() local h = myHum() if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end})
