-- deferred = true: set() wird erst beim Loslassen aufgerufen (fuer Slider, die das eigene Fenster veraendern)
local function UI_Slider(parent, text, min, max, step, get, set, suffix, deferred)
	local r = RowBase(parent, 50)
	Label({Text = text, Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.6, 0, 0, 22), Parent = r})
	local val = Label({Position = UDim2.new(0.6, 0, 0, 4), Size = UDim2.new(0.4, -12, 0, 22), TextXAlignment = Enum.TextXAlignment.Right, Parent = r}, "accent")
	local track_ = New("Frame", {Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 34), BackgroundTransparency = 0, Parent = r})
	themed(track_, {BackgroundColor3 = "bg"}); round_(track_)
	local fill = New("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundTransparency = 0, Parent = track_})
	themed(fill, {BackgroundColor3 = "accent"}); round_(fill)
	local knob = New("Frame", {Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundTransparency = 0, Parent = track_})
	themed(knob, {BackgroundColor3 = "accent"}); round_(knob)
	local function render(v)
		v = clamp(v, min, max)
		local a = (max > min) and (v - min) / (max - min) or 0
		fill.Size = UDim2.new(a, 0, 1, 0); knob.Position = UDim2.new(a, 0, 0.5, 0)
		val.Text = tostring(round(v, step)) .. (suffix or "")
	end
	render(get())
	local hit = New("TextButton", {Size = UDim2.new(1, -24, 0, 24), Position = UDim2.new(0, 12, 0, 26), Text = "", BackgroundTransparency = 1, Parent = r})
	local dragging, pending, scrollParent = false, nil, nil
	local function fromMouse()
		local x = mousePos().X
		local a = clamp((x - track_.AbsolutePosition.X) / math.max(track_.AbsoluteSize.X, 1), 0, 1)
		local v = clamp(round(min + (max - min) * a, step), min, max)
		render(v)
		if deferred then pending = v else set(v) end
	end
	local function finish()
		if not dragging then return end
		dragging = false
		if scrollParent then scrollParent.ScrollingEnabled = true; scrollParent = nil end
		if pending ~= nil then local v = pending; pending = nil; set(v) end
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			local sp = r:FindFirstAncestorOfClass("ScrollingFrame")
			if sp then scrollParent = sp; sp.ScrollingEnabled = false end
			fromMouse()
		end
	end)
	bind(r, UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromMouse() end
	end)
	bind(r, UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then finish() end
	end)
	r.Destroying:Connect(function() if scrollParent then scrollParent.ScrollingEnabled = true end end)
	return {Row = r, Refresh = function() render(get()) end}
end
