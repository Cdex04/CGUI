-- Fenster-Zustaende (loading / hidden / semi / full)
---------------------------------------------------------------------------------------------------
local Semi = {Focused = false, Hover = false}
local LastActive = os.clock()
local Blur
local function touch() LastActive = os.clock() end
Lib.Touch = touch

local function setBlur(on)
	if not Blur then return end
	tw(Blur, 0.4, {Size = (on and S.blur) and 14 or 0})
end
function setState(s)
	State = s
	touch()
	refreshSemi()
end
local function targetPos()
	if S.fullscreen then return UDim2.fromScale(0.5, 0.5) end
	return UDim2.fromScale(S.winX, S.winY)
end
local function hiddenPos()
	local t = targetPos()
	return UDim2.new(t.X.Scale, 0, -0.7, 0)
end
function Lib:OpenWindow()
	if State == "full" or State == "loading" then return end
	setState("full")
	Win.Visible = true
	applyWindowMode(true)
	Win.Position = hiddenPos()
	tw(Win, S.animDur, {Position = targetPos()}, Enum.EasingStyle.Back)
	switchTab(S.rememberTab and S.lastTab or "Commands", true)
	setBlur(true)
	busEmit("window_opened")
end
function Lib:CloseWindow()
	if State ~= "full" then return end
	tw(Win, S.animDur * 0.8, {Position = hiddenPos()}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	task.delay(S.animDur * 0.85, function() if State ~= "full" then Win.Visible = false end end)
	setState("semi")
	setBlur(false)
	busEmit("window_closed")
end
function Lib:ToggleWindow()
	if State == "full" then Lib:CloseWindow() else Lib:OpenWindow() end
end
function Lib:FocusSearch()
	if State == "loading" then return end
	if State == "full" then Lib:CloseWindow() end
	setState("semi")
	task.defer(function() if Semi.Box then Semi.Box:CaptureFocus() end end)
end
local FSButton
function Lib:SetFullscreen(v)
	S.fullscreen = v and true or false
	applyWindowMode(false)
	updateCorners()
	if FSButton then FSButton.Text = S.fullscreen and "❐" or "⛶" end
	if Commands.fullscreen then Commands.fullscreen.On = S.fullscreen; refreshRow(Commands.fullscreen, false) end
	save()
end

