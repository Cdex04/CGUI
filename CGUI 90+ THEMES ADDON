local function hex(h)
	return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16))
end

local Themes = { Names = {}, Dark = {}, Light = {}, Data = {} }

for _, entry in ipairs(DATA) do
	local name, mode, colors = entry[1], entry[2], entry[3]
	local theme, i = {}, 0
	for h in colors:gmatch("%x%x%x%x%x%x") do
		i = i + 1
		theme[KEYS[i]] = hex(h)
	end
	Themes.Data[name] = theme
	table.insert(Themes.Names, name)
	table.insert(mode == "D" and Themes.Dark or Themes.Light, name)
end

function Themes.Install(CGui)
	assert(CGui and CGui.RegisterTheme, "[CGui Themes] Bitte CGui v1.2.0 oder neuer uebergeben: Themes.Install(CGui)")
	for _, name in ipairs(Themes.Names) do
		CGui:RegisterTheme(name, Themes.Data[name])
	end
	return Themes
end

function Themes.Random(CGui)
	local name = Themes.Names[math.random(1, #Themes.Names)]
	CGui:SetTheme(name)
	return name
end

-- Wird CGui direkt uebergeben (loadstring(...)(CGui)), installiert sich das Addon sofort
local CGuiArg = ...
if CGuiArg then Themes.Install(CGuiArg) end

return Themes
